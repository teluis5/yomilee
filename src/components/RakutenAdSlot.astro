---
/**
 * RakutenAdSlot.astro - 楽天市場 セール訴求帯 ＋ モーションウィジェット広告枠コンポーネント
 */
interface Props {
  campaigns: unknown[];
  rakutenAffId: string;
  badge: string;
  text: string;
  url: string;
  iframeUrl: string;
  items?: Array<{
    name: string;
    highlight?: string;
    badge?: string;
    url: string;
    image?: string;
  }>;
}

const {
  campaigns,
  rakutenAffId,
  badge,
  text,
  url,
  iframeUrl,
  items: propItems,
} = Astro.props;

const campaignList = Array.isArray(campaigns) ? (campaigns as any[]) : [];
const rakutenCampaign = campaignList.find(c => c.provider === 'rakuten');
const productItems = propItems || (rakutenCampaign?.items as any[]) || [];

const formatRakutenUrl = (itemUrl: string) => {
  if (!itemUrl) return url;
  if (itemUrl.includes('hb.afl.rakuten.co.jp')) return itemUrl;
  const enc = encodeURIComponent(itemUrl);
  return `https://hb.afl.rakuten.co.jp/hgc/${rakutenAffId}/?pc=${enc}&m=${enc}`;
};
---

<div class="rakuten-ad-slot-wrapper">
  <div
    class="rakuten-event-banner dynamic-campaign-banner"
    data-campaign-provider="rakuten"
    data-campaigns={JSON.stringify(campaigns)}
    data-rakuten-aff-id={rakutenAffId}
  >
    <div class="rakuten-banner-main">
      <a href={url} target="_blank" rel="sponsored noopener noreferrer" class="rakuten-event-link" data-role="event-link">
        <div class="rakuten-event-meta">
          <span class="rakuten-event-badge" data-role="event-badge">{badge}</span>
          <span class="rakuten-pr-label">PR</span>
        </div>
        <div class="rakuten-event-text" data-role="event-text">{text}</div>
        <div class="rakuten-event-cta" data-role="event-cta">エントリー &raquo;</div>
      </a>
    </div>
  </div>

  <div class="rakuten-motion-widget-wrapper">
    <div class="rakuten-widget-container">
      <iframe
        src={iframeUrl}
        width="468"
        height="160"
        frameborder="0"
        scrolling="no"
        loading="lazy"
        title="楽天市場 おすすめ商品"
        style="border:0; display:block; margin:0 auto;"
      ></iframe>
    </div>
    <div class="adsense-label" style="margin-top:0.35rem; margin-bottom:0;">PR 楽天市場</div>
  </div>
</div>

<style is:global>
  .rakuten-ad-slot-wrapper {
    border: 2px solid #bf0000;
    border-radius: 8px;
    background: #ffffff;
    padding: 0.75rem 0.5rem 0.65rem 0.5rem;
    box-sizing: border-box;
    box-shadow: 0 2px 8px rgba(191, 0, 0, 0.08);
    max-width: 728px;
    margin: 0 auto;
  }
  .rakuten-event-banner {
    margin: 0 auto 0.65rem auto;
    max-width: 680px;
    background: transparent;
    border: none;
    border-bottom: 1px dashed #fecdd3;
    border-radius: 0;
    padding: 0.25rem 0.5rem 0.55rem 0.5rem;
    box-sizing: border-box;
    box-shadow: none;
  }
  .rakuten-banner-main {
    width: 100%;
  }
  .rakuten-event-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none !important;
    color: #1e293b !important;
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .rakuten-event-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .rakuten-event-badge {
    background: #bf0000;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .rakuten-pr-label {
    font-size: 0.65rem;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .rakuten-event-text {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    white-space: normal;
    word-break: break-word;
    text-align: left;
    color: #1e293b;
    line-height: 1.45;
  }
  :global(.rakuten-time-highlight) {
    color: #bf0000;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .rakuten-event-cta {
    font-size: 0.75rem;
    color: #ffffff !important;
    background: #bf0000;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .rakuten-event-banner:hover .rakuten-event-cta {
    background: #990000;
    transform: translateY(-1px);
  }

  /* 楽天ブラックフライデー 目玉商品セクション */
  .rakuten-products-section {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #fecdd3;
  }
  .rakuten-products-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }
  .rakuten-products-title {
    font-size: 0.82rem;
    font-weight: 700;
    color: #1e293b;
  }
  .rakuten-products-sub {
    font-size: 0.7rem;
    color: #94a3b8;
    font-weight: 500;
  }
  .rakuten-products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.65rem;
  }
  .rakuten-product-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #fed7aa;
    border-radius: 6px;
    padding: 0.55rem;
    text-decoration: none !important;
    color: inherit !important;
    box-sizing: border-box;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .rakuten-product-card:hover {
    background: #fff7ed;
    border-color: #bf0000;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(191, 0, 0, 0.12);
  }
  .rakuten-product-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #ffffff;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.45rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .rakuten-product-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: 0.25rem;
    box-sizing: border-box;
  }
  .rakuten-product-badge {
    position: absolute;
    top: 3px;
    left: 3px;
    background: #bf0000;
    color: #ffffff;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .rakuten-product-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }
  .rakuten-product-name {
    font-size: 0.74rem;
    font-weight: 600;
    color: #1e293b;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .rakuten-product-card:hover .rakuten-product-name {
    color: #bf0000;
  }
  .rakuten-product-highlight {
    font-size: 0.7rem;
    font-weight: 700;
    color: #bf0000;
    line-height: 1.3;
  }

  .rakuten-motion-widget-wrapper {
    width: 100%;
    margin: 0 auto;
    text-align: center;
    overflow: hidden;
  }
  .rakuten-widget-container {
    width: 468px;
    height: 160px;
    margin: 0 auto;
    transform-origin: top center;
  }

  @media (max-width: 640px) {
    .rakuten-event-banner {
      max-width: 100%;
      padding: 0.65rem 0.8rem;
    }
    .rakuten-event-link {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    .rakuten-event-meta {
      justify-content: space-between;
      width: 100%;
    }
    .rakuten-event-text {
      font-size: 0.82rem;
      line-height: 1.45;
    }
    .rakuten-event-cta {
      width: 100%;
      text-align: center;
      padding: 0.45rem 0.8rem;
      box-sizing: border-box;
      font-size: 0.78rem;
    }
    .rakuten-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
    .rakuten-product-card {
      padding: 0.45rem;
    }
    .rakuten-product-name {
      font-size: 0.72rem;
    }
    .rakuten-product-highlight {
      font-size: 0.68rem;
    }
    .rakuten-widget-container {
      transform: scale(calc((100vw - 32px) / 468));
      margin-bottom: calc(160px * (calc((100vw - 32px) / 468) - 1));
    }
  }

  .ad-pos-sidebar .rakuten-event-banner {
    max-width: 100%;
    padding: 0.5rem 0.65rem;
  }
  .ad-pos-sidebar .rakuten-event-text {
    font-size: 0.74rem;
    line-height: 1.4;
  }
  .ad-pos-sidebar .rakuten-products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .ad-pos-sidebar .rakuten-widget-container {
    transform: scale(calc(290 / 468));
    margin-bottom: calc(160px * (calc(290 / 468) - 1));
  }
</style>
