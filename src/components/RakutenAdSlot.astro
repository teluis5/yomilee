---
/**
 * RakutenAdSlot.astro - 楽天市場 セール訴求帯 ＋ モーションウィジェット広告枠コンポーネント
 */
interface Props {
  campaigns: unknown[];
  rakutenAffId?: string;
  badge?: string;
  text?: string;
  url?: string;
  iframeUrl?: string;
}

const {
  campaigns,
  rakutenAffId = '302ef99f.f5c905be.302ef9a0.b3121be5',
  badge = '楽天 BLACK FRIDAY',
  text = '楽天ブラックフライデー開催中！ポイント最大47.5倍',
  url = 'https://event.rakuten.co.jp/campaign/point-up/blackfriday/',
  iframeUrl,
} = Astro.props;

// ユーザー指定のモーションウィジェットパラメータ（最新アフィリエイトID）
const widgetAffiliateId = rakutenAffId || '302ef99f.f5c905be.302ef9a0.b3121be5';
const widgetTs = '1795477745492';
const defaultIframeUrl = `https://static.affiliate.rakuten.co.jp/widget/html/smartphone_pcview_468x160.html?rakuten_design=slide&rakuten_affiliateId=${widgetAffiliateId}&rakuten_items=ctsmatch&rakuten_genreId=0&rakuten_size=468x160&rakuten_target=_blank&rakuten_theme=gray&rakuten_border=off&rakuten_auto_mode=on&rakuten_genre_title=off&rakuten_recommend=on&rakuten_ts=${widgetTs}`;
const targetIframeUrl = iframeUrl || defaultIframeUrl;

// 指定された公式モーションウィジェットスクリプトをiframe内で実行（document.writeのブロックを回避）
const widgetSrcdoc = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>html,body{margin:0;padding:0;overflow:hidden;background:transparent;text-align:center;}</style></head><body><script type="text/javascript">rakuten_design="slide";rakuten_affiliateId="${widgetAffiliateId}";rakuten_items="ctsmatch";rakuten_genreId="0";rakuten_size="468x160";rakuten_target="_blank";rakuten_theme="gray";rakuten_border="off";rakuten_auto_mode="on";rakuten_genre_title="off";rakuten_recommend="on";rakuten_ts="${widgetTs}";<\/script><script type="text/javascript" src="https://xml.affiliate.rakuten.co.jp/widget/js/rakuten_widget.js?20230106"><\/script></body></html>`;
---

<div
  class="rakuten-event-banner dynamic-campaign-banner"
  data-campaign-provider="rakuten"
  data-campaigns={JSON.stringify(campaigns)}
  data-rakuten-aff-id={widgetAffiliateId}
>
  <a href={url} target="_blank" rel="sponsored noopener noreferrer" class="rakuten-event-link" data-role="event-link">
    <div class="rakuten-event-meta">
      <span class="rakuten-event-badge" data-role="event-badge">{badge}</span>
      <span class="rakuten-pr-label">PR</span>
    </div>
    <div class="rakuten-event-text" data-role="event-text">{text}</div>
    <div class="rakuten-event-cta" data-role="event-cta">エントリー &raquo;</div>
  </a>
</div>

<div class="rakuten-motion-widget-wrapper">
  <div class="rakuten-widget-container">
    <iframe
      src={targetIframeUrl}
      srcdoc={widgetSrcdoc}
      width="468"
      height="160"
      frameborder="0"
      scrolling="no"
      loading="lazy"
      title="楽天市場 おすすめ商品"
      style="border:0; display:block; margin:0 auto;"
    ></iframe>
  </div>
  <div class="adsense-label" style="margin-top:0.35rem; margin-bottom:0;">PR 楽天市場</div>
</div>

<style is:global>
  /* ユーザー要望: rakuten-event-banner自体は個別の赤枠にせず、すっきりしたヘッダー帯に */
  .rakuten-event-banner {
    margin: 0 auto 0.65rem auto;
    max-width: 680px;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0.25rem 0.5rem 0.5rem 0.5rem;
    box-sizing: border-box;
    box-shadow: none;
    border-bottom: 1px dashed #fecdd3;
  }
  .rakuten-event-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none !important;
    color: #1e293b !important;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .rakuten-event-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .rakuten-event-badge {
    background: #bf0000;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.03em;
  }
  .rakuten-pr-label {
    font-size: 0.65rem;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .rakuten-event-text {
    flex: 1;
    min-width: 0;
    font-weight: 700;
    white-space: normal;
    word-break: break-word;
    text-align: left;
    color: #1e293b;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  :global(.rakuten-time-highlight) {
    color: #bf0000;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .rakuten-event-cta {
    font-size: 0.78rem;
    color: #ffffff !important;
    background: #bf0000;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.35rem 0.85rem;
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .rakuten-event-banner:hover .rakuten-event-cta {
    background: #990000;
    transform: translateY(-1px);
  }

  .rakuten-motion-widget-wrapper {
    width: 100%;
    margin: 0 auto;
    text-align: center;
    overflow: hidden;
  }
  .rakuten-widget-container {
    width: 468px;
    height: 160px;
    margin: 0 auto;
    transform-origin: top center;
  }

  @media (max-width: 640px) {
    .rakuten-event-banner {
      max-width: 100%;
      padding: 0.25rem 0.25rem 0.5rem 0.25rem;
    }
    .rakuten-event-link {
      flex-direction: column;
      align-items: stretch;
      gap: 0.45rem;
    }
    .rakuten-event-meta {
      justify-content: space-between;
      width: 100%;
    }
    .rakuten-event-text {
      font-size: 0.86rem;
      line-height: 1.4;
    }
    .rakuten-event-cta {
      width: 100%;
      text-align: center;
      padding: 0.45rem 0.8rem;
      box-sizing: border-box;
      font-size: 0.8rem;
    }
    .rakuten-widget-container {
      transform: scale(calc((100vw - 48px) / 468));
      margin-bottom: calc(160px * (calc((100vw - 48px) / 468) - 1));
    }
  }

  .ad-pos-sidebar .rakuten-event-banner {
    max-width: 100%;
    padding: 0.35rem 0.4rem;
  }
  .ad-pos-sidebar .rakuten-event-text {
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .ad-pos-sidebar .rakuten-widget-container {
    transform: scale(calc(280 / 468));
    margin-bottom: calc(160px * (calc(280 / 468) - 1));
  }
</style>
