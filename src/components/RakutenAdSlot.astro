---
/**
 * RakutenAdSlot.astro - 楽天市場 セール訴求帯 ＋ モーションウィジェット広告枠コンポーネント
 */
interface Props {
  campaigns: unknown[];
  rakutenAffId: string;
  badge: string;
  text: string;
  url: string;
  iframeUrl: string;
}

const {
  campaigns,
  rakutenAffId,
  badge,
  text,
  url,
  iframeUrl,
} = Astro.props;
---

<div
  class="rakuten-event-banner dynamic-campaign-banner"
  data-campaign-provider="rakuten"
  data-campaigns={JSON.stringify(campaigns)}
  data-rakuten-aff-id={rakutenAffId}
>
  <a href={url} target="_blank" rel="sponsored noopener noreferrer" class="rakuten-event-link" data-role="event-link">
    <div class="rakuten-event-meta">
      <span class="rakuten-event-badge" data-role="event-badge">{badge}</span>
      <span class="rakuten-pr-label">PR</span>
    </div>
    <div class="rakuten-event-text" data-role="event-text">{text}</div>
    <div class="rakuten-event-cta" data-role="event-cta">エントリー &raquo;</div>
  </a>
</div>

<div class="rakuten-motion-widget-wrapper">
  <div class="rakuten-widget-container">
    <iframe
      src={iframeUrl}
      width="468"
      height="160"
      frameborder="0"
      scrolling="no"
      loading="lazy"
      title="楽天市場 おすすめ商品"
      style="border:0; display:block; margin:0 auto;"
    ></iframe>
  </div>
  <div class="adsense-label" style="margin-top:0.35rem; margin-bottom:0;">PR 楽天市場</div>
</div>

<style is:global>
  .rakuten-event-banner {
    margin: 0 auto 0.75rem auto;
    max-width: 520px;
    background: linear-gradient(135deg, #fff7f7 0%, #ffffff 100%);
    border: 1px solid #fecdd3;
    border-radius: 8px;
    padding: 0.6rem 0.9rem;
    box-sizing: border-box;
    box-shadow: 0 1px 3px rgba(191, 0, 0, 0.04);
    transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .rakuten-event-banner:hover {
    background: #fff1f2;
    border-color: #fda4af;
    box-shadow: 0 3px 8px rgba(191, 0, 0, 0.08);
  }
  .rakuten-event-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none !important;
    color: #1e293b !important;
    font-size: 0.84rem;
    line-height: 1.45;
  }
  .rakuten-event-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .rakuten-event-badge {
    background: #bf0000;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .rakuten-pr-label {
    font-size: 0.65rem;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .rakuten-event-text {
    flex: 1;
    min-width: 0;
    font-weight: 600;
    white-space: normal;
    word-break: break-word;
    text-align: left;
    color: #1e293b;
    line-height: 1.45;
  }
  :global(.rakuten-time-highlight) {
    color: #bf0000;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .rakuten-event-cta {
    font-size: 0.75rem;
    color: #ffffff !important;
    background: #bf0000;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .rakuten-event-banner:hover .rakuten-event-cta {
    background: #990000;
    transform: translateY(-1px);
  }

  .rakuten-motion-widget-wrapper {
    width: 100%;
    margin: 0 auto;
    text-align: center;
    overflow: hidden;
  }
  .rakuten-widget-container {
    width: 468px;
    height: 160px;
    margin: 0 auto;
    transform-origin: top center;
  }

  @media (max-width: 540px) {
    .rakuten-event-banner {
      max-width: 100%;
      padding: 0.65rem 0.8rem;
    }
    .rakuten-event-link {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    .rakuten-event-meta {
      justify-content: space-between;
      width: 100%;
    }
    .rakuten-event-text {
      font-size: 0.82rem;
      line-height: 1.45;
    }
    .rakuten-event-cta {
      width: 100%;
      text-align: center;
      padding: 0.45rem 0.8rem;
      box-sizing: border-box;
      font-size: 0.78rem;
    }
    .rakuten-widget-container {
      transform: scale(calc((100vw - 32px) / 468));
      margin-bottom: calc(160px * (calc((100vw - 32px) / 468) - 1));
    }
  }

  .ad-pos-sidebar .rakuten-event-banner {
    max-width: 100%;
    padding: 0.5rem 0.65rem;
  }
  .ad-pos-sidebar .rakuten-event-text {
    font-size: 0.74rem;
    line-height: 1.4;
  }
  .ad-pos-sidebar .rakuten-widget-container {
    transform: scale(calc(290 / 468));
    margin-bottom: calc(160px * (calc(290 / 468) - 1));
  }
</style>
