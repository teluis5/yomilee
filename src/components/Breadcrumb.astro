---
import { Icon } from 'astro-icon/components';

export interface BreadcrumbItem {
	label: string;
	href?: string;
}

interface Props {
	items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;
const origin = Astro.site ? Astro.site.origin : Astro.url.origin;

const breadcrumbListSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, index) => {
		const listItem: Record<string, any> = {
			'@type': 'ListItem',
			position: index + 1,
			name: item.label,
		};
		if (item.href) {
			try {
				const h = item.href.endsWith('/') ? item.href : `${item.href}/`;
				listItem.item = new URL(h, origin).href;
			} catch {
				listItem.item = item.href;
			}
		} else if (index === items.length - 1) {
			const currentUrl = Astro.url.href;
			listItem.item = currentUrl.endsWith('/') ? currentUrl : `${currentUrl}/`;
		}
		return listItem;
	}),
};
---

<nav aria-label="パンくずリスト" class="breadcrumb-nav">
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbListSchema)} />
	<ol class="breadcrumb-list">
		{
			items.map((item, index) => {
				const isLast = index === items.length - 1;
				return (
					<li class="breadcrumb-item">
						{index === 0 ? (
							item.href && !isLast ? (
								<a href={item.href} class="breadcrumb-link home-link" title={item.label}>
									<Icon name="heroicons:home" class="breadcrumb-icon" aria-hidden="true" />
									<span>{item.label}</span>
								</a>
							) : (
								<span class="breadcrumb-current home-link" aria-current="page">
									<Icon name="heroicons:home" class="breadcrumb-icon" aria-hidden="true" />
									<span>{item.label}</span>
								</span>
							)
						) : isLast || !item.href ? (
							<span class="breadcrumb-current" aria-current="page" title={item.label}>
								{item.label}
							</span>
						) : (
							<a href={item.href} class="breadcrumb-link" title={item.label}>
								{item.label}
							</a>
						)}
						{!isLast && (
							<Icon name="heroicons:chevron-right" class="breadcrumb-separator" aria-hidden="true" />
						)}
					</li>
				);
			})
		}
	</ol>
</nav>

<style>
	.breadcrumb-nav {
		margin-bottom: 1.25rem;
		font-size: 0.85rem;
		color: var(--text-light, #666);
		line-height: 1.5;
	}

	.breadcrumb-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		list-style: none;
		padding: 0;
		margin: 0;
		gap: 0.25rem 0.4rem;
	}

	.breadcrumb-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		max-width: 100%;
	}

	.breadcrumb-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--text-light, #666);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.breadcrumb-link:hover {
		color: var(--theme-accent, #007cba);
		text-decoration: underline;
	}

	.breadcrumb-current {
		color: var(--text-main, #333);
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 320px;
	}

	@media (max-width: 600px) {
		.breadcrumb-current {
			max-width: 180px;
		}
	}

	.breadcrumb-icon {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		vertical-align: -0.125em;
	}

	.breadcrumb-separator {
		width: 0.8rem;
		height: 0.8rem;
		color: #9ca3af;
		flex-shrink: 0;
	}
</style>
