---
// Google AdSense 広告表示用コンポーネント (共通UIマスター)
// 指定された位置（目次下、記事下など）に整ったレイアウトで広告を配置します。
interface Props {
  slot?: string;
  position?: 'toc' | 'bottom' | 'sidebar' | 'custom';
  client?: string;
}

const {
  slot,
  position = 'custom',
  client = 'ca-pub-8011635154814608'
} = Astro.props;

// slotがダミー('1234567890')の場合はundefined扱い
const validSlot = (slot && slot !== '1234567890') ? slot : undefined;
---

<div class={`adsense-wrapper ad-pos-${position}`}>
  <div class="adsense-label">スポンサーリンク</div>
  <div class="adsense-body">
    <ins class="adsbygoogle"
         style="display:block; text-align:center;"
         data-ad-client={client}
         data-ad-slot={validSlot}
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
</div>

<style>
  .adsense-wrapper {
    margin: 2rem auto;
    text-align: center;
    max-width: 100%;
    overflow: hidden;
  }
  .adsense-wrapper:has(ins[data-ad-status="unfilled"]) {
    display: none !important;
  }
  .ad-pos-toc {
    margin: 1.5rem auto 2.5rem auto;
  }
  .ad-pos-bottom {
    margin: 2.5rem auto 2rem auto;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-color, #e2e8f0);
  }
  .adsense-label {
    font-size: 0.72rem;
    color: #94a3b8;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
    text-align: center;
    font-weight: 500;
  }
  .adsense-body {
    min-height: 0;
    background: transparent;
    border-radius: 8px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
</style>