---
// Google AdSense & 楽天・Amazon ハイブリッド広告表示コンポーネント (共通UIマスター)
// 各広告枠は AdSenseSlot / RakutenAdSlot / AmazonAdSlot にコンポーネント分割されています。
import campaignsData from '../data/campaigns.json';
import AdSenseSlot from './AdSenseSlot.astro';
import RakutenAdSlot from './RakutenAdSlot.astro';
import AmazonAdSlot from './AmazonAdSlot.astro';

interface Props {
  slot?: string;
  position?: 'home-top' | 'bottom' | 'sidebar' | 'blog-card' | 'custom';
  client?: string;
  type?: 'mixed' | 'adsense' | 'googlead' | 'rakuten' | 'amazon';
  provider?: 'mixed' | 'adsense' | 'googlead' | 'rakuten' | 'amazon';
  eventText?: string;
  eventUrl?: string;
  disableAdsense?: boolean;
  format?: 'auto' | 'autorelaxed';
}

const {
  slot,
  position = 'custom',
  client = 'ca-pub-8011635154814608',
  type,
  provider,
  eventText,
  eventUrl,
  disableAdsense = false,
  format = 'auto',
} = Astro.props;

const selectedType = (provider || type || 'mixed').toLowerCase();

const POSITION_SLOTS: Record<string, string> = {
  'home-top': '5945449170',
  'bottom': '4644769398',
  'sidebar': '4644769398',
  'blog-card': '2398575230',
  'custom': '4644769398',
};

const targetSlot = slot || POSITION_SLOTS[position] || '4644769398';

const AMAZON_TAG = 'teluis-22';
const RAKUTEN_AFF_ID = '302ef99f.f5c905be.302ef9a0.b3121be5';

const campaigns = campaignsData.campaigns || [];
const rakutenSale = campaigns.find(c => c.provider === 'rakuten');

function getRakutenCampaign(customText?: string, customLink?: string) {
  if (customText) {
    const rawUrl = customLink || 'https://event.rakuten.co.jp/campaign/point-up/marathon/';
    const enc = encodeURIComponent(rawUrl);
    return {
      badge: '買いまわり',
      text: customText,
      url: `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFF_ID}/?pc=${enc}&m=${enc}`,
    };
  }

  if (rakutenSale) {
    const enc = encodeURIComponent(rakutenSale.url);
    return {
      badge: rakutenSale.badge || '楽天 BF',
      text: `楽天ブラックフライデー開催中！ ポイント最大47.5倍${rakutenSale.endDateOnly ? `（${rakutenSale.endDateOnly}まで）` : ''}`,
      url: `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFF_ID}/?pc=${enc}&m=${enc}`,
    };
  }

  const now = new Date();
  const day = now.getDate();

  if (day === 5 || day === 10 || day === 15 || day === 20 || day === 25 || day === 30) {
    const rawUrl = 'https://event.rakuten.co.jp/campaign/point-up/card/';
    const enc = encodeURIComponent(rawUrl);
    return {
      badge: '本日限定',
      text: '【5と0のつく日】エントリー＆楽天カード利用でポイント4倍！',
      url: `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFF_ID}/?pc=${enc}&m=${enc}`,
    };
  }

  if (day === 1) {
    const rawUrl = 'https://event.rakuten.co.jp/campaign/point-up/wonderfulday/';
    const enc = encodeURIComponent(rawUrl);
    return {
      badge: '毎月1日',
      text: '【ワンダフルデー】全ショップポイント3倍＆リピート購入2倍！',
      url: `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFF_ID}/?pc=${enc}&m=${enc}`,
    };
  }

  if (day === 18) {
    const rawUrl = 'https://event.rakuten.co.jp/campaign/point-up/ichiba-day/';
    const enc = encodeURIComponent(rawUrl);
    return {
      badge: '市場の日',
      text: '【ご愛顧感謝デー】会員ランク別ポイント最大4倍！',
      url: `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFF_ID}/?pc=${enc}&m=${enc}`,
    };
  }

  const rawUrl = 'https://event.rakuten.co.jp/campaign/point-up/marathon/';
  const enc = encodeURIComponent(rawUrl);
  return {
    badge: '買いまわり',
    text: '【楽天市場】お買い物マラソン・買いまわりでポイント最大10倍（最大46倍）！',
    url: `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFF_ID}/?pc=${enc}&m=${enc}`,
  };
}

const rakutenCampaign = getRakutenCampaign(eventText, eventUrl);

const AMAZON_DATA = [
  {
    title: 'Amazon 毎日更新 タイムセール祭り',
    desc: '人気ガジェット・家電・日用品が特別価格！数量限定セール開催中',
    btnText: 'タイムセール会場を見る',
    url: `https://www.amazon.co.jp/gp/goldbox?tag=${AMAZON_TAG}`,
    badge: 'Amazon',
    badgeColor: '#ff9900',
    btnBg: '#f59e0b',
  },
];

let currentHost = '';
try {
  if (Astro.site) {
    currentHost = (typeof Astro.site === 'string' ? new URL(Astro.site).hostname : Astro.site.hostname || '').toLowerCase();
  } else if (Astro.url) {
    currentHost = Astro.url.hostname.toLowerCase();
  }
} catch (e) {
  currentHost = '';
}

const isTeluisMain = currentHost === 'teluis.com' || currentHost === 'www.teluis.com';
const isYomilee = currentHost === 'yomileeblog.com' || currentHost === 'www.yomileeblog.com' || currentHost.includes('yomilee');

const isAdEnabled = (isYomilee || !isTeluisMain) && !disableAdsense;
const showYomileeFirstH2Ad = isYomilee;

let renderType: 'adsense' | 'rakuten' | 'amazon' = 'adsense';
if (selectedType === 'rakuten') {
  renderType = 'rakuten';
} else if (selectedType === 'amazon') {
  renderType = 'amazon';
} else if (selectedType === 'googlead' || selectedType === 'adsense') {
  renderType = isAdEnabled ? 'adsense' : 'rakuten';
} else {
  if (!isAdEnabled) {
    if (position === 'bottom' || position === 'sidebar') renderType = 'amazon';
    else renderType = 'rakuten';
  } else if (isYomilee) {
    renderType = 'adsense';
  } else {
    if (position === 'bottom') renderType = 'amazon';
    else renderType = 'adsense';
  }
}

const selectedAmazon = AMAZON_DATA[0];
const rakutenWidgetIframeUrl = `https://static.affiliate.rakuten.co.jp/widget/html/smartphone_pcview_468x160.html?rakuten_design=slide&rakuten_affiliateId=${RAKUTEN_AFF_ID}&rakuten_items=ctsmatch&rakuten_genreId=0&rakuten_size=468x160&rakuten_target=_blank&rakuten_theme=gray&rakuten_border=off&rakuten_auto_mode=on&rakuten_genre_title=off&rakuten_recommend=on&rakuten_ts=1795477745492`;

// セール期間中に AdSense から楽天・Amazon へ一部切り替える対象枠かどうか
const isSaleSwitchableBottom = renderType === 'adsense' && selectedType === 'mixed' && position === 'bottom';
---

<!-- 動的差し替え用コンポーネントテンプレート＆ヘルパー（記事下 position="bottom" 時に1回のみ出力） -->
{position === 'bottom' && (
  <>
    <template id="teluis-rakuten-ad-template">
      <RakutenAdSlot
        campaigns={campaigns}
        rakutenAffId={RAKUTEN_AFF_ID}
        badge={rakutenCampaign.badge}
        text={rakutenCampaign.text}
        url={rakutenCampaign.url}
        iframeUrl={rakutenWidgetIframeUrl}
      />
    </template>

    <template id="teluis-amazon-ad-template">
      <AmazonAdSlot
        campaigns={campaigns}
        amazonTag={AMAZON_TAG}
        title={selectedAmazon.title}
        desc={selectedAmazon.desc}
        btnText={selectedAmazon.btnText}
        url={selectedAmazon.url}
        badge={selectedAmazon.badge}
        badgeColor={selectedAmazon.badgeColor}
        btnBg={selectedAmazon.btnBg}
      />
    </template>

    <script is:inline define:vars={{ campaigns }}>
      (() => {
        if (window.__teluisAdHelpers) return;

        const getActiveProviders = () => {
          const nowMs = Date.now();
          const list = Array.isArray(campaigns) ? campaigns : [];
          const active = [];
          const hasRakuten = list.some(c =>
            c.provider === 'rakuten' &&
            nowMs >= new Date(c.start).getTime() &&
            nowMs <= new Date(c.end).getTime()
          );
          const hasAmazon = list.some(c =>
            c.provider === 'amazon' &&
            nowMs >= new Date(c.start).getTime() &&
            nowMs <= new Date(c.end).getTime()
          );
          if (hasRakuten) active.push('rakuten');
          if (hasAmazon) active.push('amazon');
          return active;
        };

        const shuffleProviders = (providers) => {
          const copy = providers.slice();
          for (let i = copy.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [copy[i], copy[j]] = [copy[j], copy[i]];
          }
          return copy;
        };

        const pickRandomProvider = (providers) => {
          if (!providers || !providers.length) return null;
          return providers[Math.floor(Math.random() * providers.length)];
        };

        const cloneSaleAdFragment = (provider) => {
          const tplId = provider === 'rakuten'
            ? 'teluis-rakuten-ad-template'
            : 'teluis-amazon-ad-template';
          const tpl = document.getElementById(tplId);
          return tpl && 'content' in tpl ? tpl.content.cloneNode(true) : null;
        };

        window.__teluisAdHelpers = {
          getActiveProviders,
          shuffleProviders,
          pickRandomProvider,
          cloneSaleAdFragment,
        };
      })();
    </script>
  </>
)}

<!-- 1. AdSense 表示 -->
{renderType === 'adsense' && targetSlot && (
  <div class={`adsense-wrapper ad-pos-${position}`} id={isSaleSwitchableBottom ? 'teluis-bottom-ad-wrapper' : undefined}>
    <AdSenseSlot
      client={client}
      slot={targetSlot}
      format={format}
      autoPush={!isSaleSwitchableBottom}
    />
    {isSaleSwitchableBottom && (
      <script is:inline>
        (() => {
          const wrapper = document.getElementById('teluis-bottom-ad-wrapper');
          const helpers = window.__teluisAdHelpers;
          if (wrapper && helpers) {
            const activeProviders = helpers.getActiveProviders();
            if (activeProviders.length > 0) {
              // セール期間中（複数重複時はランダム）に切り替え、AdSenseリクエストは送らない
              const chosen = helpers.pickRandomProvider(activeProviders);
              const frag = chosen ? helpers.cloneSaleAdFragment(chosen) : null;
              if (frag) {
                wrapper.replaceChildren(frag);
                return;
              }
            }
          }
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        })();
      </script>
    )}
  </div>
)}

<!-- 2. 楽天モーションウィジェット ＋ 買いまわりイベント訴求帯 -->
{renderType === 'rakuten' && (
  <div class={`adsense-wrapper ad-pos-${position}`}>
    <RakutenAdSlot
      campaigns={campaigns}
      rakutenAffId={RAKUTEN_AFF_ID}
      badge={rakutenCampaign.badge}
      text={rakutenCampaign.text}
      url={rakutenCampaign.url}
      iframeUrl={rakutenWidgetIframeUrl}
    />
  </div>
)}

<!-- 3. Amazonアソシエイト表示 -->
{renderType === 'amazon' && selectedAmazon && (
  <div class={`adsense-wrapper ad-pos-${position}`}>
    <AmazonAdSlot
      campaigns={campaigns}
      amazonTag={AMAZON_TAG}
      title={selectedAmazon.title}
      desc={selectedAmazon.desc}
      btnText={selectedAmazon.btnText}
      url={selectedAmazon.url}
      badge={selectedAmazon.badge}
      badgeColor={selectedAmazon.badgeColor}
      btnBg={selectedAmazon.btnBg}
    />
  </div>
)}

<!-- クライアント動的セール判定スクリプト（楽天イベント帯・Amazonカードのリアルタイム訴求更新） -->
<script is:inline>
  (() => {
    function updateDynamicAds() {
      const now = new Date();
      const nowMs = now.getTime();
      const day = now.getDate();

      // 楽天イベント帯の更新
      const rakutenBanners = document.querySelectorAll('.dynamic-campaign-banner');
      rakutenBanners.forEach(banner => {
        try {
          const campaignsJson = banner.getAttribute('data-campaigns');
          const affId = banner.getAttribute('data-rakuten-aff-id');
          const campaigns = campaignsJson ? JSON.parse(campaignsJson) : [];
          const badgeEl = banner.querySelector('[data-role="event-badge"]');
          const textEl = banner.querySelector('[data-role="event-text"]');
          const ctaEl = banner.querySelector('[data-role="event-cta"]');
          const linkEl = banner.querySelector('[data-role="event-link"]');

          const rakutenSale = campaigns.find(c => c.provider === 'rakuten');
          if (rakutenSale) {
            const startMs = new Date(rakutenSale.start).getTime();
            const endMs = new Date(rakutenSale.end).getTime();

            if (nowMs >= startMs && nowMs <= endMs) {
              const diffMs = endMs - nowMs;
              const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
              const diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

              if (badgeEl) badgeEl.textContent = rakutenSale.badge || 'SALE';
              if (linkEl) {
                const enc = encodeURIComponent(rakutenSale.url);
                linkEl.href = `https://hb.afl.rakuten.co.jp/hgc/${affId}/?pc=${enc}&m=${enc}`;
              }

              const endDateObj = new Date(rakutenSale.end);
              const isSameDay = now.getFullYear() === endDateObj.getFullYear() &&
                                now.getMonth() === endDateObj.getMonth() &&
                                now.getDate() === endDateObj.getDate();
              const endHour = endDateObj.getHours();
              const endMin = String(endDateObj.getMinutes()).padStart(2, '0');
              const endLabel = `${endHour}:${endMin}`;
              const isLateNight = endHour >= 0 && endHour <= 4;

              if (diffHours < 3) {
                if (badgeEl) badgeEl.textContent = 'まもなく終了';
                if (textEl) textEl.innerHTML = `<strong>楽天ブラックフライデー開催中！</strong> 残り<span class="rakuten-time-highlight">${diffHours}時間${diffMinutes}分</span>（${endLabel}まで）`;
                if (ctaEl) ctaEl.textContent = '特設会場へ »';
              } else if (diffHours < 24) {
                if (badgeEl) badgeEl.textContent = isSameDay ? '本日終了' : '楽天 BF';
                const timePrefix = isSameDay ? `本日${endLabel}まで あと` : (isLateNight ? `今夜深夜${endLabel}まで あと` : `残り`);
                if (textEl) textEl.innerHTML = `<strong>楽天ブラックフライデー開催中！</strong> ${timePrefix}<span class="rakuten-time-highlight">${diffHours}時間${diffMinutes}分</span> ポイント最大47.5倍`;
                if (ctaEl) ctaEl.textContent = 'エントリー »';
              } else {
                if (badgeEl) badgeEl.textContent = '楽天 BF';
                if (textEl) textEl.innerHTML = `<strong>楽天ブラックフライデー開催中！</strong> ポイント最大47.5倍（${rakutenSale.endDateOnly || ''}まで）`;
                if (ctaEl) ctaEl.textContent = 'エントリー »';
              }
              return;
            } else if (nowMs < startMs && (startMs - nowMs) <= 48 * 3600 * 1000) {
              if (badgeEl) badgeEl.textContent = '事前告知';
              if (textEl) textEl.innerHTML = `【予告】${rakutenSale.startLabel}〜 ${rakutenSale.name} 開催！事前エントリー受付中`;
              if (ctaEl) ctaEl.textContent = '事前エントリー »';
              if (linkEl) {
                const enc = encodeURIComponent(rakutenSale.url);
                linkEl.href = `https://hb.afl.rakuten.co.jp/hgc/${affId}/?pc=${enc}&m=${enc}`;
              }
              return;
            }
          }

          if (day === 5 || day === 10 || day === 15 || day === 20 || day === 25 || day === 30) {
            if (badgeEl) badgeEl.textContent = '本日限定';
            if (textEl) textEl.textContent = '【5と0のつく日】エントリー＆楽天カード利用でポイント4倍！';
            if (ctaEl) ctaEl.textContent = '本日エントリー »';
            if (linkEl) {
              const enc = encodeURIComponent('https://event.rakuten.co.jp/campaign/point-up/card/');
              linkEl.href = `https://hb.afl.rakuten.co.jp/hgc/${affId}/?pc=${enc}&m=${enc}`;
            }
          }
        } catch (e) {
          console.debug('[DynamicAds] rakuten update error:', e);
        }
      });

      // Amazonカードの更新
      const amazonBanners = document.querySelectorAll('.dynamic-amazon-banner');
      amazonBanners.forEach(banner => {
        try {
          const campaignsJson = banner.getAttribute('data-campaigns');
          const tag = banner.getAttribute('data-amazon-tag');
          const campaigns = campaignsJson ? JSON.parse(campaignsJson) : [];
          const amazonSale = campaigns.find(c => c.provider === 'amazon');
          if (!amazonSale) return;

          const startMs = new Date(amazonSale.start).getTime();
          const endMs = new Date(amazonSale.end).getTime();

          const badgeEl = banner.querySelector('[data-role="amazon-badge"]');
          const titleEl = banner.querySelector('[data-role="amazon-title"]');
          const descEl = banner.querySelector('[data-role="amazon-desc"]');
          const linkEl = banner.querySelector('[data-role="amazon-link"]');
          const btnTextEl = banner.querySelector('[data-role="amazon-btn-text"]');

          if (nowMs >= startMs && nowMs <= endMs) {
            const diffMs = endMs - nowMs;
            const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
            const diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

            if (badgeEl) badgeEl.textContent = amazonSale.badge || 'SALE';
            if (titleEl) titleEl.textContent = amazonSale.name;
            if (linkEl) linkEl.href = `${amazonSale.url}?tag=${tag}`;

            if (diffHours < 24) {
              if (descEl) descEl.innerHTML = `本日終了まで あと <strong class="amazon-time-highlight">${diffHours}時間${diffMinutes}分</strong>！年間最大級の特大セールラストスパート`;
              if (btnTextEl) btnTextEl.textContent = '特設会場へ急ぐ';
            } else {
              if (descEl) descEl.textContent = `${amazonSale.endDateOnly}まで開催中！${amazonSale.highlight}`;
              if (btnTextEl) btnTextEl.textContent = 'ビッグセール会場へ';
            }
          } else if (nowMs < startMs && (startMs - nowMs) <= 48 * 3600 * 1000) {
            if (badgeEl) badgeEl.textContent = '予告';
            if (titleEl) titleEl.textContent = `${amazonSale.name} まもなく開催`;
            if (descEl) descEl.textContent = `${amazonSale.startLabel}スタート！年間最大級のビッグセール会場を事前チェック`;
            if (btnTextEl) btnTextEl.textContent = '会場をチェック';
            if (linkEl) linkEl.href = `${amazonSale.url}?tag=${tag}`;
          }
        } catch (e) {
          console.debug('[DynamicAds] amazon update error:', e);
        }
      });
    }

    window.__refreshDynamicAds = updateDynamicAds;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateDynamicAds);
    } else {
      updateDynamicAds();
    }
  })();
</script>

<!-- 4. 記事内H2前 動的挿入スクリプト（AdSense + セール期間中の一部楽天/Amazon切り替え） -->
{position === 'bottom' && (
  <script is:inline define:vars={{ isAdEnabled, showYomileeFirstH2Ad, client, slotId: targetSlot }}>
    (() => {
      if (window.__adsense_h2_injected__) return;
      window.__adsense_h2_injected__ = true;

      const initH2Ads = () => {
        const prose = document.querySelector('.prose');
        if (!prose) return;

        const allH2 = Array.from(prose.querySelectorAll('h2')).filter(h2 => {
          return !h2.closest('#toc-wrapper') &&
                 !h2.closest('.related-posts') &&
                 !h2.closest('.share-buttons') &&
                 !h2.closest('.sidebar');
        });

        if (allH2.length < (showYomileeFirstH2Ad ? 1 : 2)) return;

        const targetIndices = [];
        if (showYomileeFirstH2Ad && allH2.length >= 1) targetIndices.push(0);
        if (allH2.length >= 2) targetIndices.push(1);
        if (allH2.length >= 3) targetIndices.push(2);

        const helpers = window.__teluisAdHelpers;
        const activeProviders = helpers ? helpers.getActiveProviders() : [];
        // 大型セールが2つ以上被った場合はランダムな順序で掲出する
        const shuffledSaleProviders = helpers ? helpers.shuffleProviders(activeProviders) : [];

        // 後ろから挿入してDOMインデックスのずれを防止
        targetIndices.reverse().forEach((idx) => {
          const targetH2 = allH2[idx];
          if (!targetH2 || !targetH2.parentNode) return;

          const anchor = targetH2.closest('.sec-head, .sc-head') || targetH2;
          const prevEl = anchor.previousElementSibling;
          if (prevEl && prevEl.classList.contains('adsense-wrapper')) return;

          const adWrapper = document.createElement('div');
          adWrapper.className = 'adsense-wrapper ad-pos-in-article';
          adWrapper.style.margin = '2rem auto';
          adWrapper.style.maxWidth = '728px';
          adWrapper.style.textAlign = 'center';
          adWrapper.style.boxSizing = 'border-box';

          if (isAdEnabled) {
            // セール期間中は 2番目(idx===1) / 3番目(idx===2) のH2前をランダム順のセール広告に切り替え
            let saleProvider = null;
            if (idx === 1 && shuffledSaleProviders.length >= 1) {
              saleProvider = shuffledSaleProviders[0];
            } else if (idx === 2 && shuffledSaleProviders.length >= 2) {
              saleProvider = shuffledSaleProviders[1];
            }

            const frag = saleProvider && helpers ? helpers.cloneSaleAdFragment(saleProvider) : null;
            if (frag) {
              adWrapper.appendChild(frag);
              anchor.before(adWrapper);
            } else {
              adWrapper.innerHTML = `
                <div class="adsense-label" style="display:block; width:100%; text-align:center; font-size:0.7rem; color:#94a3b8; font-weight:500; letter-spacing:0.08em; margin-bottom:0.35rem;">広告</div>
                <div class="adsense-body" style="width:100%; margin:0 auto; text-align:center;">
                  <ins class="adsbygoogle"
                       style="display:block; text-align:center;"
                       data-ad-client="${client}"
                       data-ad-slot="${slotId}"
                       data-ad-format="auto"
                       data-full-width-responsive="true"></ins>
                </div>
              `;
              anchor.before(adWrapper);

              try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              } catch (e) {
                console.debug('[AdSense] in-article push notice:', e);
              }
            }
          } else {
            // AdSense未合格ドメイン: 2番目H2前は楽天、その他はAmazon
            const provider = idx === 1 ? 'rakuten' : 'amazon';
            const frag = helpers ? helpers.cloneSaleAdFragment(provider) : null;
            if (frag) {
              adWrapper.appendChild(frag);
              anchor.before(adWrapper);
            }
          }
        });

        if (typeof window.__refreshDynamicAds === 'function') {
          window.__refreshDynamicAds();
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initH2Ads);
      } else {
        initH2Ads();
      }
    })();
  </script>
)}

<style is:global>
  .adsense-wrapper {
    margin: 2rem auto;
    text-align: center;
    max-width: 100%;
