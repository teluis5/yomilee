---
// Google AdSense 広告表示用コンポーネント
// AdSense審査通過後、発行された有効なスロットID（slot）を指定して呼び出します。
// 例: <Ad slot="xxxxxxxxx" />
// slotが指定されていない、またはダミー値の場合は何もレンダリングしません（審査中のエラー・空枠防止）。
interface Props {
  slot?: string;
}

const { slot } = Astro.props;
const isValidSlot = slot && slot !== '1234567890';
---
{isValidSlot && (
  <div class="adsense-container" style="text-align: center; margin: 2rem 0;">
    <!-- Google AdSense 広告枠 -->
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-8011635154814608"
         data-ad-slot={slot}
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script is:inline>
         (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}