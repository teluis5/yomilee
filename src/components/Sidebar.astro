---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import FormattedDate from './FormattedDate.astro';
import * as consts from '../consts';

interface Props {
	authorName?: string;
	authorTitle?: string;
	authorBio?: string;
	authorAvatar?: string;
	currentCategory?: string;
	currentPostId?: string;
}

const siteConsts = consts as Record<string, any>;

const {
	authorName = siteConsts.AUTHOR_NAME ?? siteConsts.AUTHOR?.name ?? 'teluis',
	authorTitle = siteConsts.AUTHOR_TITLE ?? siteConsts.AUTHOR?.title ?? '',
	authorBio = siteConsts.AUTHOR_BIO ?? siteConsts.AUTHOR?.bio ?? '',
	authorAvatar = siteConsts.AUTHOR_AVATAR ?? siteConsts.AUTHOR?.avatar ?? '/brand/teluis_avatar.webp',
	currentCategory: propCategory,
	currentPostId: propPostId,
} = Astro.props;

// 全記事の取得（ドラフト除外）
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 5);
const totalArticlesCount = allPosts.length;

// カテゴリ別記事件数の集計
const categoryCounts: Record<string, number> = {};
allPosts.forEach((post) => {
	post.data.categories?.forEach((cat: string) => {
		categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
	});
});
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);

// 現在のURLまたはPropsから記事・カテゴリを自動特定
const pathname = Astro.url.pathname.replace(/\/$/, '');

// 1. 表示中記事の特定 (props or URL)
let currentPost = propPostId ? allPosts.find((p) => p.id === propPostId) : undefined;
if (!currentPost && pathname.includes('/blog/')) {
	const slugFromUrl = pathname.replace(/^.*\/blog\//, '').replace(/\/$/, '');
	currentPost = allPosts.find((p) => p.id === slugFromUrl || p.id.endsWith(slugFromUrl) || slugFromUrl.endsWith(p.id));
}

// 2. 現在のカテゴリーの特定
let targetCategory = propCategory;
if (!targetCategory && currentPost?.data.categories && currentPost.data.categories.length > 0) {
	targetCategory = currentPost.data.categories[0];
}
if (!targetCategory && pathname.includes('/category/')) {
	const catMatch = pathname.match(/\/category\/([^/]+)/);
	if (catMatch) {
		targetCategory = decodeURIComponent(catMatch[1]);
	}
}
// 3. カテゴリが定まらない場合（トップページなど）は最も記事数が多いカテゴリを自動選定
if (!targetCategory && categories.length > 0) {
	targetCategory = categories[0][0];
}

// 同じカテゴリの最新記事を取得（現在表示中の記事は除外、最大5件）
const categoryPosts = targetCategory
	? sortedPosts
			.filter((post) => post.data.categories?.includes(targetCategory))
			.filter((post) => !currentPost || post.id !== currentPost.id)
			.slice(0, 5)
	: [];
const categoryTotalCount = targetCategory ? (categoryCounts[targetCategory] || 0) : 0;
---

<aside class="layout-sidebar">
	<!-- プロフィールウィジェット -->
	<div class="sidebar-widget box">
		<div class="widget-header">
			<Icon name="heroicons:user" class="icon-inline" />
			<span>運営者プロフィール</span>
		</div>
		<div class="profile-card">
			<div class="profile-avatar-wrap">
				<a href="/about/" aria-label="運営者プロフィール詳細へ">
					<img class="profile-avatar" src={authorAvatar} alt={authorName} width="76" height="76" loading="lazy" decoding="async" />
				</a>
			</div>
			<div class="profile-body">
				<div class="profile-name"><a href="/about/" style="color: inherit; text-decoration: none;">{authorName}</a></div>
				<div class="profile-role">{authorTitle}</div>
				<p class="profile-text">{authorBio}</p>
			</div>
		</div>

		<div class="profile-action">
			<a href="/about/" class="profile-btn">
				詳しいプロフィール・運営情報を見る &raquo;
			</a>
		</div>
	</div>

	<!-- 新着記事ウィジェット（回遊性重視・サムネイル付き） -->
	{recentPosts.length > 0 && (
		<div class="sidebar-widget box">
			<div class="widget-header">
				<Icon name="heroicons:sparkles" class="icon-inline" />
				<span>新着記事</span>
			</div>
			<div class="recent-posts">
				{recentPosts.map((post) => (
					<a href={`/blog/${post.id}/`} class="recent-post-card">
						<div class="recent-thumb">
							{post.data.heroImage ? (
								<Image
									width={160}
									height={90}
									src={post.data.heroImage}
									alt={post.data.title}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="thumb-placeholder">
									<Icon name="heroicons:photo" class="placeholder-icon" />
								</div>
							)}
						</div>
						<div class="recent-content">
							<h4 class="recent-title">{post.data.title}</h4>
							<span class="recent-date">
								<Icon name="heroicons:calendar" class="date-icon" />
								<FormattedDate date={post.data.pubDate} />
							</span>
						</div>
					</a>
				))}
			</div>
			<div class="widget-footer-action">
				<a href="/blog/" class="widget-more-link">
					すべての記事を見る（全{totalArticlesCount}件） &raquo;
				</a>
			</div>
		</div>
	)}

	<!-- カテゴリ一覧ウィジェット -->
	{categories.length > 0 && (
		<div class="sidebar-widget box">
			<div class="widget-header">
				<Icon name="heroicons:tag" class="icon-inline" />
				<span>カテゴリー</span>
			</div>
			<ul class="category-list">
				{categories.map(([category, count]) => (
					<li>
						<a href={`/category/${category}/`} class="category-item">
							<span class="category-name">
								<Icon name="heroicons:folder" class="cat-icon" />
								{category}
							</span>
							<span class="category-count">{count}</span>
						</a>
					</li>
				))}
			</ul>
			<div class="widget-footer-action">
				<a href="/category/" class="widget-more-link">
					カテゴリー一覧を見る &raquo;
				</a>
			</div>
		</div>
	)}

	<!-- 同一カテゴリーの最新記事ウィジェット（広告削除枠に配置・回遊性向上） -->
	{categoryPosts.length > 0 && targetCategory && (
		<div class="sidebar-widget box">
			<div class="widget-header">
				<Icon name="heroicons:folder-open" class="icon-inline" />
				<span>「{targetCategory}」の最新記事</span>
			</div>
			<div class="recent-posts">
				{categoryPosts.map((post) => (
					<a href={`/blog/${post.id}/`} class="recent-post-card">
						<div class="recent-thumb">
							{post.data.heroImage ? (
								<Image
									width={160}
									height={90}
									src={post.data.heroImage}
									alt={post.data.title}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="thumb-placeholder">
									<Icon name="heroicons:photo" class="placeholder-icon" />
								</div>
							)}
						</div>
						<div class="recent-content">
							<h4 class="recent-title">{post.data.title}</h4>
							<span class="recent-date">
								<Icon name="heroicons:calendar" class="date-icon" />
								<FormattedDate date={post.data.pubDate} />
							</span>
						</div>
					</a>
				))}
			</div>
			<div class="widget-footer-action">
				<a href={`/category/${encodeURIComponent(targetCategory)}/`} class="widget-more-link">
					「{targetCategory}」の記事をもっと見る（全{categoryTotalCount}件） &raquo;
				</a>
			</div>
		</div>
	)}

	<!-- ブログ固有カスタムウィジェット用スロット（各メディアで独自拡張可能） -->
	<slot name="sidebar-custom" />
</aside>

<style>
	.layout-sidebar {
		flex: 1 1 30%;
		min-width: 300px;
		position: sticky;
		top: 80px;
		max-height: calc(100vh - 100px);
		overflow-y: auto;
		overflow-x: hidden;
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.layout-sidebar::-webkit-scrollbar {
		width: 5px;
	}
	.layout-sidebar::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.15);
		border-radius: 4px;
	}
	.layout-sidebar::-webkit-scrollbar-thumb:hover {
		background: rgba(0, 0, 0, 0.3);
	}

	@media (max-width: 800px) {
		.layout-sidebar {
			flex: 1 1 100%;
			position: static;
			max-height: none;
			overflow-y: visible;
		}
	}

	/* ウィジェット共通スタイル */
	.sidebar-widget {
		padding: 1.25rem;
		background: var(--bg-content, #ffffff);
	}

	.widget-header {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-main, #333333);
		background-color: #f8fafc;
		padding: 0.6rem 1rem;
		border-left: 4px solid var(--theme-accent, #0284c7);
		margin: -1.25rem -1.25rem 1.2rem -1.25rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		border-bottom: 1px solid var(--border-color, #e2e8f0);
	}

	/* プロフィール */
	.profile-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.profile-avatar-wrap {
		position: relative;
		margin-bottom: 0.75rem;
	}

	.profile-avatar {
		width: 88px;
		height: 88px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid #f0f9ff;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
		display: block;
	}

	.profile-name {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text-main, #1e293b);
		margin-bottom: 0.2rem;
	}

	.profile-role {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--theme-accent, #0284c7);
		background: #e0f2fe;
		padding: 0.15rem 0.6rem;
		border-radius: 9999px;
		display: inline-block;
		margin-bottom: 0.75rem;
	}

	.profile-text {
		font-size: 0.88rem;
		color: var(--text-main, #475569);
		line-height: 1.6;
		margin: 0;
		text-align: left;
	}

	.profile-action {
		margin-top: 1rem;
	}

	.profile-btn {
		display: block;
		text-align: center;
		padding: 0.55rem 0.8rem;
		background-color: #f0f9ff;
		color: #0369a1 !important;
		border: 1px solid #bae6fd;
		border-radius: 6px;
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none !important;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.profile-btn:hover {
		background-color: #e0f2fe;
		border-color: #7dd3fc;
	}

	/* カテゴリ一覧 */
	.category-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.category-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.6rem;
		border-radius: 6px;
		text-decoration: none !important;
		color: var(--text-main, #334155) !important;
		font-size: 0.9rem;
		transition: background-color 0.2s, color 0.2s;
	}

	.category-item:hover {
		background-color: #f0f9ff;
		color: var(--theme-accent, #0284c7) !important;
	}

	.category-name {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cat-icon {
		font-size: 1rem;
		color: var(--theme-accent, #0284c7);
		flex-shrink: 0;
	}

	.category-count {
		font-size: 0.75rem;
		font-weight: 700;
		background: #f1f5f9;
		color: var(--text-light, #64748b);
		padding: 0.1rem 0.5rem;
		border-radius: 9999px;
		flex-shrink: 0;
		font-variant-numeric: tabular-nums;
	}

	.category-item:hover .category-count {
		background: #bae6fd;
		color: #0369a1;
	}

	/* 新着記事（サムネイル付き） */
	.recent-posts {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.recent-post-card {
		display: flex;
		gap: 0.75rem;
		text-decoration: none !important;
		color: inherit !important;
		padding-bottom: 0.85rem;
		border-bottom: 1px dashed var(--border-color, #e2e8f0);
		transition: transform 0.15s ease;
	}

	.recent-post-card:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.recent-post-card:hover .recent-title {
		color: var(--theme-accent, #0284c7);
	}

	.recent-post-card:hover .recent-thumb img {
		transform: scale(1.05);
	}

	.recent-thumb {
		width: 84px;
		aspect-ratio: 16 / 9;
		border-radius: 4px;
		overflow: hidden;
		flex-shrink: 0;
		background: #e2e8f0;
	}

	.recent-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
		display: block;
	}

	.thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #f1f5f9;
		color: #94a3b8;
	}

	.placeholder-icon {
		font-size: 1.25rem;
	}

	.recent-content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.recent-title {
		font-size: 0.86rem;
		font-weight: 600;
		line-height: 1.4;
		margin: 0 0 0.35rem 0;
		color: var(--text-main, #1e293b);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s;
	}

	.recent-date {
		font-size: 0.76rem;
		color: var(--text-light, #94a3b8);
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.date-icon {
		font-size: 0.85rem;
	}

	/* ウィジェット下部リンク（回遊促進） */
	.widget-footer-action {
		margin-top: 1rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border-color, #f1f5f9);
		text-align: right;
	}

	.widget-more-link {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--theme-accent, #0284c7) !important;
		text-decoration: none !important;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		transition: color 0.15s ease, transform 0.15s ease;
	}

	.widget-more-link:hover {
		color: #0369a1 !important;
		transform: translateX(2px);
	}
</style>
