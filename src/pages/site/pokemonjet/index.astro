---
import Layout from '../../../layouts/BlogPost.astro';
import Ad from '../../../components/Ad.astro';
import predictionData from '../../../data/pokemon_weekly_prediction.json';
import heroImage from '../../../assets/images/chiikawajet_ogp.png';

const title = "ANA ポケモンジェット全機 リアルタイム運航状況＆フライト予想【ピカチュウ・イーブイ・赤・緑】";
const description = "ANA特別塗装機「ポケモンジェット全5機（国内線ポケモン赤・ピカチュウジェットNH・イーブイジェットNH・緑・初代）」のリアルタイム現在地、本日の運航便、明日のフライト予想を毎日自動更新。";

const currentData = predictionData;
const updatedAt = currentData.updatedAt || "更新中";
const jets = currentData.jets || [];
const redJet = jets.find((j) => j.id === 'pokemon-red') || jets[0];
const intlJets = jets.filter((j) => j.type === 'international');
const domesticPred = currentData.domesticPrediction || {};

const todayPlans = domesticPred.todayPlans || [];
const tomorrowPlans = domesticPred.tomorrowPlans || [];
const nightStayProbabilities = domesticPred.nightStayProbabilities || [];

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/pokemonjet/',
	dateModified: currentData.updatedAtIso
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-11-02')}
	updatedDate={new Date(currentData.updatedAtIso || Date.now())}
	heroImage={heroImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="pokemon-dashboard google-anno-skip">
		<!-- ✈️ 特別塗装機 統合ポータル ナビゲーションタブ -->
		<nav class="portal-tab-nav">
			<a href="/site/chiikawajet/" class="portal-tab-btn">
				<span class="tab-icon">✈️</span>
				<span class="tab-label">ちいかわジェット (JA609A)</span>
			</a>
			<a href="/site/pokemonjet/" class="portal-tab-btn active">
				<span class="tab-icon">⚡</span>
				<span class="tab-label">ポケモンジェット全機 (全5機)</span>
				<span class="tab-badge">表示中</span>
			</a>
		</nav>

		<!-- ヒーローヘッダー -->
		<div class="hero-banner">
			<div class="hero-top-row">
				<span class="hero-tag">⚡ ANA × そらとぶピカチュウプロジェクト ＆ ポケモン30周年</span>
				<span class="live-pill">● LIVE TRACKING</span>
			</div>
			<h1 class="hero-title">ANA ポケモンジェット全機 運航状況・現在地トラッカー</h1>
			<p class="hero-subtitle">
				国内線で毎日飛び回る<b>「ポケモン赤（JA819A）」</b>の翌日フライト予想から、世界中を結ぶ<b>ピカチュウジェットNH・イーブイジェットNH</b>まで、全特別塗装機をリアルタイム追跡！
			</p>
			<div class="update-meta">
				<span>最終データ同期: <b>{updatedAt}</b> (JST)</span>
				<span class="sync-dot">•</span>
				<span>稼働中機材: <b>{jets.length} 機</b></span>
			</div>
		</div>

		<!-- ============================================================ -->
		<!-- 国内線特集: ポケモンジェット 赤 (JA819A / B787-8) -->
		<!-- ============================================================ -->
		<section class="dash-section red-feature-section">
			<div class="sec-head">
				<div>
					<span class="sec-tag tag-domestic">🗾 国内線仕様機 (最も会いやすい！)</span>
					<h2 class="sec-title">ポケモンジェット 赤 (JA819A) リアルタイム状況 ＆ 予想</h2>
				</div>
				<span class={`status-pill ${redJet.flightState.includes('飛行中') ? 'pill-live' : 'pill-standby'}`}>
					{redJet.flightState}
				</span>
			</div>

			<!-- ステータスバー（現在地・今夜のステイ先） -->
			<div class="status-main-grid">
				<div class="status-box">
					<span class="status-label">現在の飛行区間 / 位置</span>
					<div class="status-val-main highlight-text">{redJet.currentLocation}</div>
					{redJet.currentFlight && (
						<div class="status-sub">
							便名: <b>{redJet.currentFlight.flightNo}</b> ({redJet.currentFlight.timeRange}) [{redJet.currentFlight.status}]
						</div>
					)}
				</div>

				<div class="status-box">
					<span class="status-label">今夜のステイ先予想（合計100%）</span>
					<div class="ns-pills">
						{nightStayProbabilities.map((p) => (
							<span class="ns-pill">
								{p.airport} <b>{p.probability}%</b>
							</span>
						))}
					</div>
					<div class="status-sub text-muted">※羽田着後の夜間接続ダイヤに基づくベイズ確率</div>
				</div>
			</div>

			<!-- ① 本日のフライト実績 ＆ 後続ダイヤ予想 -->
			<div class="sub-sec-wrap">
				<h3 class="sub-sec-title">📋 本日のフライト実績 ＆ 後続ダイヤ予想</h3>
				<div class="simple-table-wrap">
					<table class="simple-comp-table">
						<thead>
							<tr>
								<th>便</th>
								<th>便名</th>
								<th>区間</th>
								<th>発着予定</th>
								<th>運航状況</th>
							</tr>
						</thead>
						<tbody>
							{redJet.todayFlights.map((fl, idx) => (
								<tr>
									<td class="col-step">第{idx + 1}便</td>
									<td><b>{fl.flightNo}</b></td>
									<td>{fl.route}</td>
									<td>{fl.timeRange}</td>
									<td>
										<span class={`status-badge ${fl.isLive ? 'badge-live' : 'badge-done'}`}>
											{fl.isLive ? '🔥 飛行中' : '着陸済'}
										</span>
									</td>
								</tr>
							))}
							{domesticPred.predictedRemainingToday && domesticPred.predictedRemainingToday.map((fl, rIdx) => (
								<tr class="predicted-row">
									<td class="col-step">第{redJet.todayFlights.length + rIdx + 1}便</td>
									<td><b class="text-pred">{fl.flightNo}</b></td>
									<td>{fl.route}</td>
									<td>{fl.time}</td>
									<td>
										<span class="status-badge badge-pred">
											{fl.status}
										</span>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>

			<!-- ② 明日（翌日）の運航予想（3大シナリオプラン） -->
			{tomorrowPlans.length > 0 && (
				<div class="sub-sec-wrap" style="margin-top: 28px;">
					<div class="plan-header-row">
						<div>
							<h3 class="sub-sec-title">🎯 明日（{domesticPred.tomorrowDate}）の運航ダイヤ予想</h3>
							<p class="sub-sec-desc">ANA公式ダイヤ（78P確定枠）から、今夜の宿泊地ごとに翌朝の全便スジをシミュレーション算出</p>
						</div>
					</div>

					<div class="tomorrow-plans-grid">
						{tomorrowPlans.map((plan) => (
							<div class="tomorrow-plan-card">
								<div class="plan-card-head">
									<div class="plan-meta-left">
										<span class="plan-rank-tag">{plan.rank}</span>
										<h4 class="plan-card-title">{plan.planName}</h4>
									</div>
									<span class="plan-prob-badge">{plan.probability}%</span>
								</div>

								<div class="plan-route-summary">{plan.routeSummary}</div>

								<div class="plan-flights-list">
									{plan.flights.map((f) => (
										<div class="plan-flight-row">
											<span class="fl-step">{f.step}</span>
											<span class="fl-no"><b>{f.flightNo}</b></span>
											<span class="fl-route">{f.route}</span>
											<span class="fl-time">{f.time}</span>
											<span class="fl-tag">{f.tag}</span>
										</div>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			)}
		</section>

		<Ad />

		<!-- ============================================================ -->
		<!-- 国際線フリート: 世界中を飛ぶポケモン特別塗装機群 -->
		<!-- ============================================================ -->
		<section class="dash-section intl-section">
			<div class="sec-head">
				<div>
					<span class="sec-tag tag-intl">🌏 国際線フリート</span>
					<h2 class="sec-title">国際線ポケモンジェット（ピカチュウ・イーブイ・緑・初代）</h2>
					<p class="sec-desc">アメリカ本土、ハワイ、欧州、東南アジアへ羽ばたく世界規模のスペマ機材群！</p>
				</div>
			</div>

			<div class="intl-cards-grid">
				{intlJets.map((jet) => (
					<div class="intl-jet-card">
						<div class="intl-card-top">
							<div class="intl-title-block">
								<span class="intl-color-dot" style={`background-color: ${jet.color};`}></span>
								<div>
									<h3 class="intl-jet-name">{jet.name}</h3>
									<span class="intl-reg-type">{jet.reg} • {jet.aircraftType} ({jet.modelCode})</span>
								</div>
							</div>
							<span class={`status-pill ${jet.flightState.includes('飛行中') ? 'pill-live' : 'pill-standby'}`}>
								{jet.flightState}
							</span>
						</div>

						<p class="intl-theme-desc">{jet.theme}</p>

						<div class="intl-route-box">
							<span class="route-lbl">現在地 / 飛行区間:</span>
							<span class="route-val">{jet.currentLocation}</span>
						</div>

						<div class="intl-recent-fls">
							<span class="recent-title">直近のフライト実績:</span>
							<div class="recent-list">
								{jet.recentFlights && jet.recentFlights.slice(0, 3).map((f) => (
									<div class="recent-row">
										<span class="rf-no"><b>{f.flightNo}</b></span>
										<span class="rf-route">{f.origin} ➔ {f.dest}</span>
										<span class="rf-time">{f.dateJst} ({f.timeRange})</span>
										<span class="rf-status">{f.status}</span>
									</div>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- ============================================================ -->
		<!-- ポケモンジェット搭乗・撮影ガイド＆FAQ -->
		<!-- ============================================================ -->
		<div class="guide-box">
			<h3 class="guide-title">💡 ポケモンジェットに会うための攻略ポイント</h3>
			<div class="guide-content">
				<div class="guide-item">
					<h4>1. 固定ダイヤ（運航スケジュール）はある？</h4>
					<p>ANAのポケモンジェットは特定のダイヤに固定されておらず、ANAの機材繰りによって日々投入路線が決まります。搭乗が保証されるわけではないため、前夜〜当日の機番チェックが必須です。</p>
				</div>
				<div class="guide-item">
					<h4>2. 国内線ポケモン赤（JA819A）に会える確率は？</h4>
					<p>B787-8（78P）国内線仕様機として、羽田を拠点に福岡・石垣・長崎・松山・新千歳・那覇など全国を毎日4〜5便飛んでいます。当サイトの「翌日予想ダイヤ」を参考にすることで、前日の段階で高い確率で狙い撃ちが可能です。</p>
				</div>
				<div class="guide-item">
					<h4>3. ちいかわジェットとの違いは？</h4>
					<p>ちいかわジェット（JA609A）はB767-300ER（主に地方幹線）ですが、ポケモン赤は最新のB787-8（全席モニター完備・ワイドボディ機）。長距離リゾート路線（石垣・那覇）や高需要路線にも積極的に投入されます。</p>
				</div>
			</div>
		</div>

		<!-- 下部相互リンク -->
		<div class="bottom-nav">
			<a href="/site/chiikawajet/" class="bottom-nav-card chiikawa-card">
				<div class="bn-icon">✈️</div>
				<div class="bn-text">
					<span class="bn-sub">ANA特別塗装機シリーズ</span>
					<span class="bn-main">ちいかわジェット（JA609A）運航状況＆週間予想 ➔</span>
				</div>
			</a>
		</div>
	</div>
</Layout>

<style>
	.pokemon-dashboard {
		max-width: 980px;
		margin: 0 auto;
		padding: 10px 16px 40px;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		color: #1e293b;
	}

	/* ✈️ ポータル ナビゲーションタブ */
	.portal-tab-nav {
		display: flex;
		gap: 10px;
		margin-bottom: 20px;
		border-bottom: 2px solid #e2e8f0;
		padding-bottom: 12px;
	}
	.portal-tab-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 18px;
		border-radius: 12px;
		background: #f1f5f9;
		color: #475569;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95rem;
		transition: all 0.2s ease;
	}
	.portal-tab-btn:hover {
		background: #e2e8f0;
		color: #0f172a;
	}
	.portal-tab-btn.active {
		background: #2563eb;
		color: #ffffff;
		box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
	}
	.tab-badge {
		background: rgba(255, 255, 255, 0.25);
		font-size: 0.72rem;
		padding: 2px 6px;
		border-radius: 8px;
		font-weight: 800;
	}

	/* ヒーローバナー */
	.hero-banner {
		background: linear-gradient(135deg, #0284c7 0%, #2563eb 50%, #4f46e5 100%);
		color: #ffffff;
		border-radius: 20px;
		padding: 28px 24px;
		margin-bottom: 30px;
		box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
	}
	.hero-top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
	}
	.hero-tag {
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(8px);
		padding: 4px 12px;
		border-radius: 20px;
		font-size: 0.82rem;
		font-weight: 700;
	}
	.live-pill {
		background: #ef4444;
		color: #ffffff;
		font-weight: 800;
		padding: 3px 10px;
		border-radius: 12px;
		font-size: 0.75rem;
		animation: pulse 2s infinite;
	}
	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.7; }
	}
	.hero-title {
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1.3;
		margin: 0 0 10px 0;
	}
	.hero-subtitle {
		font-size: 0.95rem;
		opacity: 0.95;
		margin: 0 0 16px 0;
		line-height: 1.5;
	}
	.hero-subtitle b {
		color: #fde047;
	}
	.update-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.85rem;
		opacity: 0.9;
	}
	.sync-dot {
		opacity: 0.6;
	}

	/* セクション共通 */
	.dash-section {
		background: #ffffff;
		border-radius: 18px;
		border: 1px solid #e2e8f0;
		padding: 24px;
		margin-bottom: 30px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
	}
	.red-feature-section {
		border: 2px solid #f87171;
	}
	.sec-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 20px;
		gap: 12px;
	}
	.sec-tag {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 800;
		padding: 3px 10px;
		border-radius: 6px;
		margin-bottom: 6px;
	}
	.tag-domestic { background: #fee2e2; color: #b91c1c; }
	.tag-intl { background: #e0e7ff; color: #4338ca; }
	.sec-title {
		font-size: 1.4rem;
		font-weight: 800;
		margin: 0;
		color: #0f172a;
	}
	.sec-desc {
		font-size: 0.88rem;
		color: #64748b;
		margin: 4px 0 0 0;
	}
	.status-pill {
		font-size: 0.82rem;
		font-weight: 800;
		padding: 4px 12px;
		border-radius: 20px;
		white-space: nowrap;
	}
	.pill-live { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }
	.pill-standby { background: #fef9c3; color: #854d0e; }

	/* ステータスグリッド */
	.status-main-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin-bottom: 24px;
	}
	@media (max-width: 640px) {
		.status-main-grid { grid-template-columns: 1fr; }
	}
	.status-box {
		background: #f8fafc;
		border-radius: 12px;
		padding: 16px;
		border: 1px solid #e2e8f0;
	}
	.status-label {
		display: block;
		font-size: 0.75rem;
		font-weight: 700;
		color: #64748b;
		margin-bottom: 6px;
		text-transform: uppercase;
	}
	.status-val-main {
		font-size: 1.25rem;
		font-weight: 800;
		color: #0f172a;
		margin-bottom: 6px;
	}
	.highlight-text {
		color: #b91c1c;
	}
	.status-sub {
		font-size: 0.82rem;
		color: #475569;
	}
	.ns-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 6px;
	}
	.ns-pill {
		background: #ffffff;
		border: 1px solid #cbd5e1;
		padding: 3px 8px;
		border-radius: 8px;
		font-size: 0.82rem;
		color: #1e293b;
	}
	.ns-pill b {
		color: #2563eb;
	}

	/* テーブルスタイル */
	.sub-sec-wrap {
		margin-top: 20px;
	}
	.sub-sec-title {
		font-size: 1.15rem;
		font-weight: 800;
		margin: 0 0 6px 0;
		color: #0f172a;
	}
	.sub-sec-desc {
		font-size: 0.85rem;
		color: #64748b;
		margin: 0 0 12px 0;
	}
	.simple-table-wrap {
		overflow-x: auto;
		border-radius: 12px;
		border: 1px solid #e2e8f0;
	}
	.simple-comp-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.88rem;
		text-align: left;
	}
	.simple-comp-table th {
		background: #f1f5f9;
		padding: 10px 12px;
		font-weight: 700;
		color: #475569;
		border-bottom: 1px solid #e2e8f0;
	}
	.simple-comp-table td {
		padding: 10px 12px;
		border-bottom: 1px solid #f1f5f9;
	}
	.predicted-row {
		background: #fefce8;
	}
	.text-pred {
		color: #b45309;
	}
	.status-badge {
		font-size: 0.75rem;
		font-weight: 700;
		padding: 3px 8px;
		border-radius: 6px;
		white-space: nowrap;
	}
	.badge-live { background: #dcfce7; color: #166534; }
	.badge-done { background: #e2e8f0; color: #475569; }
	.badge-pred { background: #fef3c7; color: #92400e; }

	/* 明日のプランカードグリッド */
	.tomorrow-plans-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
	}
	.tomorrow-plan-card {
		background: #ffffff;
		border: 1px solid #cbd5e1;
		border-radius: 14px;
		padding: 16px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
	}
	.plan-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}
	.plan-meta-left {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.plan-rank-tag {
		background: #fee2e2;
		color: #b91c1c;
		font-weight: 800;
		font-size: 0.75rem;
		padding: 2px 8px;
		border-radius: 6px;
	}
	.plan-card-title {
		font-size: 1.05rem;
		font-weight: 800;
		margin: 0;
		color: #0f172a;
	}
	.plan-prob-badge {
		background: #2563eb;
		color: #ffffff;
		font-weight: 800;
