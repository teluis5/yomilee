<script>
	document.addEventListener('DOMContentLoaded', () => {
		const filterBar = document.querySelector('.airport-filter-bar');
		if (!filterBar) return;

		const buttons = filterBar.querySelectorAll('.af-btn');
		const planCards = document.querySelectorAll('.plan-card');

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				buttons.forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');

				const target = btn.getAttribute('data-airport') || 'ALL';
				planCards.forEach((card) => {
					const airports = card.getAttribute('data-airports') || '';
					const rows = card.querySelectorAll('.plan-flight-row');

					if (target === 'ALL') {
						card.classList.remove('is-dimmed');
						rows.forEach((r) => r.classList.remove('is-match'));
					} else {
						if (airports.includes(target)) {
							card.classList.remove('is-dimmed');
							card.setAttribute('open', '');
						} else {
							card.classList.add('is-dimmed');
						}

						rows.forEach((r) => {
							const route = r.getAttribute('data-route') || '';
							if (route.includes(target)) {
								r.classList.add('is-match');
							} else {
								r.classList.remove('is-match');
							}
						});
					}
				});
			});
		});
	});
</script>
