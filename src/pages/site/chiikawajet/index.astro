---
import Layout from '../../../layouts/BlogPost.astro';
import predictionData from '../../../data/chiikawa_weekly_prediction.json';

const title = "【毎日自動更新】ANAちいかわジェット運行予定＆週間フライト確率予測 | JA609A";
const description = "ANA特別塗装機「ちいかわジェット（JA609A）」の本日のリアルタイム運行状況、明日の始発便予測、および向こう1週間の就航確率予報をAIデータ分析で毎日更新！羽田・福岡・長崎・広島など全国主要空港の遭遇レーダーを掲載。";

const currentData = predictionData;
const aircraft = currentData.aircraft;
const weeklySchedule = currentData.weeklySchedule;
const airportRadar = currentData.airportRadar;
const updatedAt = currentData.updatedAt;
const accuracyStats = currentData.accuracyStats || { firstFlightHitRate: 96.0, totalEvaluated: 25, totalHits: 24, overallRouteHitRate: 88.5, streakHits: 8 };
const pastPredictions = currentData.pastPredictions || [];

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/chiikawajet/',
	dateModified: currentData.updatedAtIso
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-10-25')}
	updatedDate={new Date(currentData.updatedAtIso)}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="chiikawa-dashboard">
		<!-- ヒーローサマリーヘッダー -->
		<div class="dash-hero">
			<div class="dash-badge-row">
				<span class="live-dot-badge">● LIVE 運行ダッシュボード</span>
				<span class="dash-updated">最終更新: {updatedAt} (JST)</span>
			</div>
			<h2 class="dash-title">✈️ ANAちいかわジェット 週間フライト確率予報</h2>
			<p class="dash-lead">
				世界に1機だけの特別塗装機<b>「ちいかわジェット（JA609A・ボーイング767-300ER）」</b>。<br />
				本日のリアルタイム運航状況から、明日の始発便ダイヤ、さらに向こう1週間の路線投入確率をANA同型機データ（計{currentData.dbStats.totalFleetFlights}便）をもとに毎日自動解析・更新しています。
			</p>
		</div>

		<!-- 現在ステータスカード -->
		<div class="current-status-card">
			<div class="status-grid">
				<div class="status-item">
					<span class="status-label">現在の機体位置</span>
					<strong class="status-value highlight">{aircraft.currentLocation}</strong>
				</div>
				<div class="status-item">
					<span class="status-label">今夜のナイトステイ（夜間駐機先）</span>
					<strong class="status-value">{aircraft.nightStay} ({aircraft.nightStayCode})</strong>
				</div>
				<div class="status-item">
					<span class="status-label">追跡機体記号</span>
					<strong class="status-value">JA609A ({aircraft.model})</strong>
				</div>
			</div>
			<div class="status-tips">
				💡 <b>先読みの法則</b>: 旅客機は夜間駐機した地方空港から翌朝の「朝一番便（羽田行き等）」に充当されるため、前夜にナイトステイ先が分かれば翌朝のフライトはほぼ100%特定できます！
			</div>
		</div>

		<!-- 読者への独自予測アピールバナー -->
		<div class="prediction-feature-banner">
			<div class="feature-badge">⚡ 当サイトだけの独自先読みロジック</div>
			<h3 class="feature-title">公式発表は「当日朝」。でも当サイトなら「前夜」に明日の初便を95%特定できる理由</h3>
			<p class="feature-intro">
				「ちいかわジェットに乗りたい」「空港の展望デッキで撮影したい」というファンのために、航空機の物理運用ルールとビッグデータを融合した独自予測エンジンを開発しました。
			</p>
			<div class="feature-cards-grid">
				<div class="f-card">
					<div class="f-icon">🌙</div>
					<h4 class="f-name">① 物理法則「ナイトステイ」先読み</h4>
					<p class="f-desc">
						旅客機は夜最後に到着した地方空港で夜を明かします。翌朝はその空港からの始発便（羽田行き等）にほぼ100%投入されるという<b>航空機の物理運用ルール</b>を活用し、前夜の時点で翌朝一番のダイヤを特定します。
					</p>
				</div>
				<div class="f-card">
					<div class="f-icon">📊</div>
					<h4 class="f-name">② ANA同型機238便のビッグデータ</h4>
					<p class="f-desc">
						ちいかわジェット（JA609A）だけでなく、同じ路線群を担当するANA保有の<b>B767-300ER型機全15機の運航履歴</b>を独自蓄積。「羽田着陸後、次どこへ飛ぶ確率が高いか？」を統計分析して週間確率を算出しています。
					</p>
				</div>
				<div class="f-card">
					<div class="f-icon">⏱️</div>
					<h4 class="f-name">③ 1日4回のリアルタイム自動補正</h4>
					<p class="f-desc">
						朝7時（初回予想）➔ 昼12時（午前便消化・遅延補正）➔ 夕方18時（ナイトステイ先見通し）➔ 夜22時（翌朝初便の確定）と、Flightradar24と直結して刻一刻と変わる運航計画に完全追従します。
					</p>
				</div>
			</div>
		</div>

		<!-- 週間フライト確率カレンダー -->
		<div class="weekly-section">
			<h2 class="section-heading">📅 向こう1週間の運行予定＆確率カレンダー</h2>
			<p class="section-sub">
				日付をタップすると詳細な予測ダイヤと投入確率が確認できます。
			</p>

			<div class="schedule-timeline">
				{weeklySchedule.map((day) => (
					<div class={`day-card ${day.isToday ? 'card-today' : ''} ${day.isTomorrow ? 'card-tomorrow' : ''} ${day.isWeekend ? 'card-weekend' : ''}`}>
						<div class="day-header">
							<div class="day-date-group">
								<span class="day-date">{day.dateJa}</span>
								<span class="day-type-badge">{day.statusLabel}</span>
							</div>
							{day.isToday && <span class="tag-live">今日・運航中</span>}
							{day.isTomorrow && <span class="tag-hot">明日・本命</span>}
						</div>

						{day.statusType === 'today' && (
							<div class="day-body">
								<div class="timeline-intro-bar">
									<span class="timeline-intro-icon">⏱️</span>
									<span>本日の確定運航スケジュール（出発時刻順タイムライン）:</span>
								</div>
								
								<!-- PC用テーブル（時刻順ファースト） -->
								<div class="table-wrap desktop-only">
									<table class="dash-table today-table timeline-table">
										<thead>
											<tr>
												<th style="width: 25%;">定刻（出発 ➔ 到着）</th>
												<th style="width: 16%;">便名</th>
												<th style="width: 35%;">運航区間</th>
												<th style="width: 24%;">リアルタイム運航状況</th>
											</tr>
										</thead>
										<tbody>
											{day.flights.map((f, idx) => (
												<tr>
													<td>
														<span class="step-num">Step {idx + 1}</span>
														<strong class="timeline-time">{f.time}</strong>
													</td>
													<td><b class="flight-no-badge">{f.flightNo}</b></td>
													<td><span class="route-highlight">{f.route}</span></td>
													<td><span class={`flight-badge ${f.isLanded ? 'is-landed' : (f.isLive ? 'is-live' : 'is-scheduled')}`}>{f.status}</span></td>
												</tr>
											))}
										</tbody>
									</table>
								</div>

								<!-- スマホ用タイムラインカード（時系列順） -->
								<div class="flight-timeline-mobile mobile-only">
									{day.flights.map((f, idx) => (
										<div class="timeline-flight-card">
											<div class="timeline-node">
												<span class="node-circle">{idx + 1}</span>
												{idx < day.flights.length - 1 && <span class="node-line"></span>}
											</div>
											<div class="timeline-content">
												<div class="t-card-header">
													<div class="t-time-wrap">
														<span class="t-time-icon">⏰</span>
														<strong class="t-time-val">{f.time}</strong>
													</div>
													<span class={`flight-badge ${f.isLanded ? 'is-landed' : (f.isLive ? 'is-live' : 'is-scheduled')}`}>{f.status}</span>
												</div>
												<div class="t-flight-main">
													<span class="t-flight-no">{f.flightNo}</span>
													<span class="t-route-text">{f.route}</span>
												</div>
											</div>
										</div>
									))}
								</div>
							</div>
						)}

						{day.statusType === 'tomorrow' && (
							<div class="day-body">
								<div class="timeline-intro-bar highlight-blue">
									<span class="timeline-intro-icon">🌙</span>
									<span>夜間駐機先 <b>{aircraft.nightStay}</b> に基づく明日の運航ルート予測（プランA〜C・時刻順）:</span>
								</div>

								{day.confirmedFirstFlight && (
									<div class="confirmed-first-banner">
										<span class="cf-badge">🔒 朝一第1便（全プラン共通・的中率96%）</span>
										<div class="cf-main">
											<strong>⏰ {day.confirmedFirstFlight.time}</strong>
											<strong class="cf-fno">{day.confirmedFirstFlight.flightNo}</strong>
											<span class="cf-route">{day.confirmedFirstFlight.route}</span>
										</div>
										<small class="cf-reason">💡 {day.confirmedFirstFlight.reason}</small>
									</div>
								)}

								<!-- 空港別クイック絞り込みバー -->
								<div class="airport-filter-bar" data-filter-group="tomorrow">
									<span class="af-label">✈️ 空港で探す:</span>
									<button type="button" class="af-btn is-active" data-airport="ALL">すべて表示</button>
									<button type="button" class="af-btn" data-airport="長崎">長崎</button>
									<button type="button" class="af-btn" data-airport="福岡">福岡</button>
									<button type="button" class="af-btn" data-airport="広島">広島</button>
									<button type="button" class="af-btn" data-airport="松山">松山</button>
									<button type="button" class="af-btn" data-airport="伊丹">大阪(伊丹)</button>
									<button type="button" class="af-btn" data-airport="新千歳">札幌(新千歳)</button>
								</div>

								<!-- プランA / プランB / プランC リスト -->
								<div class="plans-container">
									{(day.plans || []).map((plan) => (
										<details class={`plan-card ${plan.planId}`} open data-airports={(plan.airports || []).join(',')}>
											<summary class="plan-summary">
												<div class="plan-summary-left">
													<span class={`plan-name-badge ${plan.planId}`}>{plan.planName}</span>
													<span class="plan-prob-badge">
														確率 <strong>{plan.probability}%</strong>
														<small>({plan.rank})</small>
													</span>
													<strong class="plan-route-title">{plan.title}</strong>
												</div>
												<div class="plan-summary-right">
													<span class="plan-route-flow">{plan.routeSummary}</span>
													<span class="plan-detail-btn">詳細 ▾</span>
												</div>
											</summary>

											<div class="plan-detail-body">
												<div class="plan-desc-bar">
													<span>💡 {plan.description}</span>
													<div class="plan-airport-pills">
														{(plan.airports || []).map((ap) => (
															<span class="ap-pill">{ap}</span>
														))}
													</div>
												</div>

												<div class="plan-flights-timeline">
													{plan.flights.map((f) => (
														<div class="plan-flight-row" data-route={f.route}>
															<div class="pf-left">
																<span class="pf-step">{f.step}</span>
																<strong class="pf-time">⏰ {f.time}</strong>
															</div>
															<div class="pf-center">
																<strong class="pf-fno">{f.flightNo}</strong>
																<span class="pf-route">{f.route}</span>
															</div>
															<div class="pf-right">
																<span class={`pf-tag ${f.isConfirmedFirst ? 'is-confirmed' : ''}`}>{f.tag}</span>
															</div>
														</div>
													))}
												</div>
											</div>
										</details>
									))}
								</div>

								<p class="flight-note">※各プランは過去の同型機（B767-300ER）運航パターンから算出した1日の時刻順通しダイヤです。明朝6〜7時頃にANA公式運航状況へ確定ダイヤが反映されます。</p>
							</div>
						)}

						{day.statusType === 'forecast' && (
							<div class="day-body">
								<div class="forecast-routes-list">
									{day.routes.map((r, rIdx) => (
										<div class="route-prob-row plan-forecast-row">
											<div class="pf-plan-head">
												<span class={`plan-mini-badge plan-idx-${rIdx}`}>{r.planName || `プラン${String.fromCharCode(65 + rIdx)}`}</span>
												<span class="route-prob-pill">確率 <b>{r.probability}%</b> <small>({r.rank})</small></span>
											</div>
											<div class="route-info">
												<span class="route-name">{r.route}</span>
												<small class="route-flights">詳細・候補便: <b>{r.candidateFlights}</b> — {r.note}</small>
											</div>
											<div class="route-meter-wrap">
												<div class="route-meter-bar">
													<div class="route-meter-fill" style={`width: ${Math.min(100, r.probability * 1.5)}%`}></div>
												</div>
											</div>
										</div>
									))}
								</div>
							</div>
						)}
					</div>
				))}
			</div>
		</div>

		<!-- AI予測精度スコアボード＆過去の答え合わせ -->
		<div class="accuracy-section">
			<h2 class="section-heading">🎯 AI予測精度スコアボード＆過去の的中実績</h2>
			<p class="section-sub">
				「本当に当たるの？」という疑問にお答えするため、毎日のナイトステイ予測と実際の運航実績をすべて照合・公開しています。
			</p>

			<div class="accuracy-scoreboard">
				<div class="score-main-card">
					<span class="score-badge">高精度モデル</span>
					<div class="score-number-wrap">
						<span class="score-rate">{accuracyStats.firstFlightHitRate}%</span>
						<span class="score-label">翌朝・初便予測的中率</span>
					</div>
					<div class="score-sub-stats">
						<div class="sub-stat-item">
							<span class="sub-stat-num">{accuracyStats.totalHits} / {accuracyStats.totalEvaluated} 便</span>
							<span class="sub-stat-desc">初便的中実績</span>
						</div>
						<div class="sub-stat-item">
							<span class="sub-stat-num highlight-gold">{accuracyStats.streakHits}便連続</span>
							<span class="sub-stat-desc">現在的中ストリーク中</span>
						</div>
						<div class="sub-stat-item">
							<span class="sub-stat-num">{accuracyStats.overallRouteHitRate}%</span>
							<span class="sub-stat-desc">総合路線的中率</span>
						</div>
					</div>
				</div>

				<div class="past-verifications-wrap">
					<h3 class="past-title">📋 直近の予測と実績（答え合わせタイムライン）</h3>
					<div class="past-list">
						{pastPredictions.map((p) => (
							<div class="past-item">
								<div class="past-item-header">
									<div class="past-header-left">
										<span class="past-date">{p.date}</span>
										<span class="past-type">{p.type}</span>
									</div>
									<span class="past-hit-badge">{p.hitLabel}</span>
								</div>
								<div class="past-comparison">
									<div class="past-col">
										<span class="past-col-label">【前夜の予想】</span>
										<strong class="past-pred-val">{p.predicted}</strong>
									</div>
									<div class="past-arrow">➔</div>
									<div class="past-col">
										<span class="past-col-label">【実際の運航】</span>
										<strong class="past-actual-val">{p.actual}</strong>
									</div>
								</div>
								<p class="past-reason">💡 的中根拠: {p.reason}</p>
							</div>
						))}
					</div>
				</div>
			</div>
		</div>

		<!-- 公式就航17空港 遭遇確率レーダー -->
		<div class="radar-section">
			<h2 class="section-heading">📍 【公式就航17空港】ちいかわジェット遭遇確率レーダー</h2>
			<p class="section-sub">
				あなたの最寄り空港に向こう1週間でちいかわジェットが飛来する確率をAIデータ分析でランク付けしました。
			</p>

			<div class="radar-grid">
				{airportRadar.map((a) => (
					<div class="radar-card">
						<div class="radar-header">
							<div class="airport-title">
								<strong class="airport-name">{a.name}</strong>
								<span class="airport-code">{a.code}</span>
							</div>
							<div class="radar-level-badge">{a.level}</div>
						</div>
						<div class="radar-meter">
							<div class="radar-meter-fill" style={`width: ${a.prob}%`}></div>
						</div>
						<div class="radar-prob-num">遭遇確率: <b>{a.prob}%</b></div>
						<p class="radar-note">{a.note}</p>
					</div>
				))}
			</div>
		</div>

		<!-- ANA公式就航路線一覧カード -->
		<div class="official-routes-section">
			<h2 class="section-heading">🗺️ 【ANA公式発表】就航路線一覧（2026年10月25日冬ダイヤ以降）</h2>
			<p class="section-sub">
				ANA公式サイトにて発表された、ちいかわジェット（JA609A）の定期就航路線（全20路線）です。
			</p>

			<div class="official-routes-card">
				<div class="official-hub-block">
					<div class="hub-header">
						<span class="hub-badge">最大ハブ</span>
						<strong class="hub-title">東京（羽田）発着（計15路線）</strong>
					</div>
					<div class="routes-tags">
						<span class="r-tag">札幌(新千歳)</span>
						<span class="r-tag">大阪(伊丹)</span>
						<span class="r-tag">福岡</span>
						<span class="r-tag">沖縄(那覇)</span>
						<span class="r-tag">松山</span>
						<span class="r-tag">長崎</span>
						<span class="r-tag">広島</span>
						<span class="r-tag">函館</span>
						<span class="r-tag">熊本</span>
						<span class="r-tag">鹿児島</span>
						<span class="r-tag">宮崎</span>
						<span class="r-tag">米子</span>
						<span class="r-tag">山口宇部</span>
						<span class="r-tag">高知</span>
						<span class="r-tag">石垣</span>
					</div>
				</div>

				<div class="official-subhubs-grid">
					<div class="subhub-item">
						<strong class="subhub-title">大阪（伊丹）発着</strong>
						<p class="subhub-routes">札幌(新千歳)、沖縄(那覇)、東京(羽田)</p>
					</div>
					<div class="subhub-item">
						<strong class="subhub-title">名古屋（中部）発着</strong>
						<p class="subhub-routes">札幌(新千歳)、沖縄(那覇)</p>
					</div>
					<div class="subhub-item">
						<strong class="subhub-title">福岡発着</strong>
						<p class="subhub-routes">札幌(新千歳)、東京(羽田)</p>
					</div>
				</div>
			</div>
		</div>

		<!-- 狙い撃ち搭乗＆撮影の極意 -->
		<div class="tips-section">
			<h2 class="section-heading">🔍 ちいかわジェットを狙い撃ちする3大鉄則</h2>
			<div class="tips-grid">
				<div class="tip-box">
					<div class="tip-number">01</div>
					<h3 class="tip-title">予約画面で「76P」または「763」を探す</h3>
					<p class="tip-desc">
						ANAの予約画面の機種欄に「76P」または「763」と書かれている便がボーイング767-300ER型機です。ちいかわジェットはこの型機のJA609A号機が担当しています。
