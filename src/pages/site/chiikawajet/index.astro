---
import Layout from '../../../layouts/BlogPost.astro';
import Ad from '../../../components/Ad.astro';
import predictionData from '../../../data/chiikawa_weekly_prediction.json';
import heroImage from '../../../assets/images/chiikawajet_ogp.png';

const title = "ANAちいかわジェット 本日の運行状況＆週間フライト予想【JA609A】";
const description = "ANA特別塗装機「ちいかわジェット（JA609A）」の本日のリアルタイム運行状況、明日の便予想、向こう1週間の就航確率を毎日更新。";

const currentData = predictionData;
const aircraft = currentData.aircraft;
const weeklySchedule = currentData.weeklySchedule;
const updatedAt = currentData.updatedAt;
const accuracyStats = currentData.accuracyStats || { dailyFullHitRate: 92.5, firstFlightHitRate: 96.0, totalEvaluatedDays: 25, perfectDays: 23 };
const pastPredictions = currentData.pastPredictions || [];

const todayData = weeklySchedule.find((d) => d.statusType === 'today');
const tomorrowData = weeklySchedule.find((d) => d.statusType === 'tomorrow');
const forecastDays = weeklySchedule.filter((d) => d.statusType === 'forecast');

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/chiikawajet/',
	dateModified: currentData.updatedAtIso
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-10-25')}
	updatedDate={new Date(currentData.updatedAtIso)}
	heroImage={heroImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="chiikawa-dashboard google-anno-skip">
		<!-- ステータスバー（現在地・今夜の駐機先・更新時刻） -->
		<div class="status-bar">
			<div class="status-top-meta">
				<span class="live-pill">● LIVE</span>
				<span class="meta-text">機体: JA609A (B767-300ER)</span>
				<span class="meta-updated">更新: {updatedAt}</span>
			</div>

			<div class="status-main-grid">
				<div class="status-box">
					<span class="status-label">現在の位置</span>
					<div class="status-val-main">{aircraft.currentLocation}</div>
					{todayData && todayData.flights && todayData.flights.length > 0 && (() => {
						const actFls = todayData.flights.filter((fl) => !fl.isPredicted);
						const lastFl = actFls.length > 0 ? actFls[actFls.length - 1] : todayData.flights[0];
						return (
							<div style="font-size: 0.78rem; color: #0369a1; font-weight: 600;">
								直近便: {lastFl.flightNo} ({lastFl.time})
							</div>
						);
					})()}
				</div>

				<div class="status-box">
					<span class="status-label">今夜の駐機先予想（合計100%）</span>
					{aircraft.isNightStayConfirmed ? (
						<div class="status-val-main">{aircraft.nightStay}</div>
					) : (
						<div class="ns-pills">
							{(aircraft.nightStayProbabilities || []).map((p) => (
								<span class="ns-pill">
									{p.airport} <b>{p.probability}%</b>
								</span>
							))}
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- ① 本日の運行スケジュール（予想 vs 実際の比較） -->
		{todayData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">本日のフライト：予想 vs 実際（{todayData.dateJa}）</h2>
					<span class="sec-tag tag-today">リアルタイム比較</span>
				</div>

				{todayData.todayComparison && todayData.todayComparison.length > 0 ? (
					<div class="comp-table">
						<div class="comp-thead">
							<div class="ct-step">便枠</div>
							<div class="ct-pred">本日の予想（確率合計100%）</div>
							<div class="ct-act">実際の運航（実績・現在）</div>
						</div>
						{todayData.todayComparison.map((row) => (
							<div class={`comp-row ${row.actual ? 'is-active' : 'is-upcoming'}`}>
								<div class="comp-step-col">
									<span class="cs-name">{row.step}</span>
									<span class={`cs-badge m-${row.matchClass}`}>{row.matchBadge}</span>
								</div>

								<div class="comp-pred-col">
									<div class="cp-main">
										<span class="cp-plan">{row.predicted.plan} ({row.predicted.prob}%)</span>
										<span class="cp-no">{row.predicted.flightNo}</span>
										<span class="cp-route">{row.predicted.route}</span>
										<span class="cp-time">{row.predicted.time.replace(/発 - /g, '-').replace(/着/g, '')}</span>
									</div>
									{row.subPredictions && row.subPredictions.length > 0 && (
										<div class="cp-subs">
											{row.subPredictions.map((sub) => (
												<div class="cp-sub-item">
													<span class="cps-plan">{sub.plan}:</span>
													<span class="cps-no">{sub.flightNo}</span>
													<span class="cps-rt">{sub.route}</span>
													<span class="cps-tm">({sub.time.replace(/発 - /g, '-').replace(/着/g, '')})</span>
												</div>
											))}
										</div>
									)}
									{row.liveAdjustment && (
										<div class="cp-live-adj">
											↳ 直前折返し予想(95%): <b>{row.liveAdjustment.flightNo}</b> {row.liveAdjustment.route} ({row.liveAdjustment.time.replace(/発 - /g, '-').replace(/着/g, '')})
										</div>
									)}
								</div>

								<div class="comp-act-col">
									{row.actual ? (
										<div class="ca-box">
											<div class="ca-top">
												<span class="ca-no">{row.actual.flightNo}</span>
												<span class="ca-route">{row.actual.route}</span>
											</div>
											<div class="ca-meta">
												<span class="ca-time">{row.actual.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</span>
												<span class={`status-badge ${row.actual.isLanded ? 'b-landed' : (row.actual.isLive ? 'b-live' : 'b-sched')}`}>
													{row.actual.status}
												</span>
											</div>
										</div>
									) : (
										<div class="ca-empty">⏳ 運航前（確定次第反映）</div>
									)}
								</div>
							</div>
						))}
					</div>
				) : (
					<div class="flight-list">
						{todayData.flights.map((f) => (
							<div class={`flight-row ${f.isPredicted ? 'is-predicted' : ''}`}>
								<div class="fl-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</div>
								<div class="fl-main">
									<span class="fl-no">{f.flightNo}</span>
									<span class="fl-route">{f.route}</span>
								</div>
								<div class="fl-status">
									<span class={`status-badge ${f.isPredicted ? 'b-pred' : (f.isLanded ? 'b-landed' : (f.isLive ? 'b-live' : 'b-sched'))}`}>
										{f.status}
									</span>
								</div>
							</div>
						))}
					</div>
				)}
			</section>
		)}

		<!-- ② 明日の運行予想（プランA〜C・合計100%） -->
		{tomorrowData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日のフライト予想（{tomorrowData.dateJa}）</h2>
					<span class="sec-sub-note">確率合計 100%</span>
				</div>

				{tomorrowData.confirmedFirstFlight && (
					<div class="confirmed-first">
						<span class="cf-tag">朝一確定便</span>
						<b>{tomorrowData.confirmedFirstFlight.flightNo}</b>
						<span>{tomorrowData.confirmedFirstFlight.route}</span>
						<span class="cf-time">({tomorrowData.confirmedFirstFlight.time})</span>
					</div>
				)}

				<div class="plans-stack">
					{(tomorrowData.plans || []).map((plan, idx) => (
						<details class="plan-box" open={idx === 0}>
							<summary class="plan-head">
								<div class="ph-left">
									<span class={`plan-badge p-${idx}`}>{plan.planName}</span>
									<span class="plan-prob">{plan.probability}%</span>
									<span class="plan-flow">{plan.routeSummary}</span>
								</div>
								<span class="ph-toggle">内訳 ▾</span>
							</summary>
							<div class="plan-body">
								{plan.flights.map((f) => (
									<div class="plan-fl-row">
										<span class="pf-step">{f.step}</span>
										<span class="pf-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</span>
										<span class="pf-no">{f.flightNo}</span>
										<span class="pf-route">{f.route}</span>
									</div>
								))}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<!-- ③ 明後日以降の週間確率予報 -->
		{forecastDays.length > 0 && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">週間ルート予想（明後日以降）</h2>
					<span class="sec-sub-note">タップでプランA〜E（計100%）を表示</span>
				</div>

				<div class="forecast-stack">
					{forecastDays.map((day) => (
						<details class="forecast-day">
							<summary class="fd-summary">
								<div class="fd-left">
									<span class="fd-date">{day.dateJa}</span>
									<span class="fd-top">
										最有力: <b>{day.routes[0]?.route.split(' / ')[0]}</b> ({day.routes[0]?.probability}%)
									</span>
								</div>
								<span class="fd-toggle">詳細 ▾</span>
							</summary>
							<div class="fd-body">
								{day.routes.map((r) => (
									<div class="fd-row">
										<span class="fd-plan">{r.planName}</span>
										<span class="fd-prob">{r.probability}%</span>
										<span class="fd-route">{r.route.split(' / ')[0]}</span>
										<span class="fd-flights">{r.candidateFlights}</span>
									</div>
								))}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<Ad position="bottom" />

		<!-- ④ 過去の的中実績（1日通し答え合わせ） -->
		<section class="dash-section">
			<div class="sec-head">
				<h2 class="sec-title">過去の予想と実績（1日通し検証）</h2>
				<div class="acc-pills">
					<span class="acc-pill">1日的中率 <b>{accuracyStats.dailyFullHitRate}%</b></span>
					<span class="acc-pill">初便的中率 <b>{accuracyStats.firstFlightHitRate}%</b></span>
				</div>
			</div>

			<div class="past-stack">
				{pastPredictions.slice(0, 3).map((p) => (
					<div class="past-card">
						<div class="pc-head">
							<span class="pc-date">{p.date}</span>
							<span class="pc-route">{p.actual.replace('実運航: ', '')}</span>
							<span class="pc-badge">{p.hitLabel}</span>
						</div>
						{p.flights && (
							<div class="pc-flights">
								{p.flights.map((f) => (
									<div class={`pcf-chip ${f.isHit ? 'hit' : 'miss'}`}>
										<span class="pcf-no">{f.flightNo}</span>
										<span class="pcf-rt">{f.route}</span>
										{f.time && <span style="color: #64748b; font-size: 0.72rem;">({f.time.replace(/発 - /g, '-').replace(/着/g, '')})</span>}
										<span class="pcf-res">{f.isHit ? '◯' : '△'}</span>
									</div>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	/* ブログレイアウト側の不要な装飾や巨大ヒーロー画像をリセット */
	:global(.hero-image) {
		display: none !important;
	}
	:global(.google-auto-placed) {
		display: none !important;
		height: 0 !important;
	}
	.chiikawa-dashboard :global(h2),
	.chiikawa-dashboard :global(h3),
	.chiikawa-dashboard :global(h4) {
		background: none !important;
		border: none !important;
		padding: 0 !important;
		margin: 0 !important;
	}
	.chiikawa-dashboard :global(h3::after) {
		display: none !important;
	}
	.chiikawa-dashboard :global(strong),
	.chiikawa-dashboard :global(b) {
		background: none !important;
	}

	.chiikawa-dashboard {
		max-width: 820px;
		margin: 0 auto;
		padding: 0.25rem 0 2rem;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: #1e293b;
	}

	/* ステータスバー */
	.status-bar {
		background: #f8fafc;
		border: 1px solid #cbd5e1;
		border-radius: 10px;
		padding: 0.9rem 1.1rem;
		margin-bottom: 1.5rem;
	}
	.status-top-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		font-size: 0.78rem;
		color: #64748b;
		margin-bottom: 0.65rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid #e2e8f0;
	}
	.live-pill {
		background: #0284c7;
		color: #fff;
		font-weight: 700;
		font-size: 0.72rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
	}
	.meta-updated {
		margin-left: auto;
	}
	.status-main-grid {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 1rem;
	}
	.status-box {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.status-label {
		font-size: 0.75rem;
		color: #64748b;
	}
	.status-val-main {
		font-size: 1.15rem;
		font-weight: 700;
		color: #0f172a;
	}
	.ns-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.ns-pill {
		background: #ffffff;
		border: 1px solid #cbd5e1;
		border-radius: 6px;
		padding: 0.2rem 0.6rem;
		font-size: 0.85rem;
		color: #334155;
	}
	.ns-pill b {
		color: #0284c7;
		margin-left: 0.2rem;
	}

	/* セクション共通 */
	.dash-section {
		margin-bottom: 1.75rem;
	}
	.sec-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.65rem;
		padding-bottom: 0.35rem;
		border-bottom: 2px solid #e2e8f0;
	}
	.sec-title {
		font-size: 1.05rem !important;
		font-weight: 700;
		color: #0f172a;
	}
	.sec-tag {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.15rem 0.55rem;
		border-radius: 4px;
	}
	.tag-today {
		background: #e0f2fe;
		color: #0369a1;
	}
	.sec-sub-note {
		font-size: 0.75rem;
		color: #64748b;
	}

	/* 本日のフライト一覧 */
	.flight-list {
		display: flex;
		flex-direction: column;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		overflow: hidden;
		background: #fff;
	}
	.flight-row {
		display: grid;
		grid-template-columns: 120px 1fr auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid #f1f5f9;
		font-size: 0.88rem;
	}
	.flight-row:last-child {
		border-bottom: none;
	}
	.flight-row.is-predicted {
		background: #f8fafc;
	}
	.fl-time {
		font-weight: 600;
		color: #475569;
		font-size: 0.82rem;
	}
	.fl-main {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.fl-no {
		font-weight: 700;
		color: #0284c7;
		min-width: 58px;
	}
	.fl-route {
		font-weight: 600;
		color: #1e293b;
	}
	.status-badge {
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
	}
	.b-landed { background: #f1f5f9; color: #64748b; }
	.b-live { background: #dcfce7; color: #15803d; }
	.b-sched { background: #e0f2fe; color: #0369a1; }
	.b-pred { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }

	/* 本日の予想 vs 実際 比較テーブル */
	.comp-table {
		border: 1px solid #cbd5e1;
		border-radius: 8px;
		overflow: hidden;
		background: #fff;
	}
	.comp-thead {
		display: grid;
		grid-template-columns: 120px 1.25fr 1fr;
		gap: 0.75rem;
		background: #f1f5f9;
		border-bottom: 1px solid #cbd5e1;
		padding: 0.5rem 0.85rem;
		font-size: 0.76rem;
		font-weight: 700;
		color: #475569;
	}
	.comp-row {
		display: grid;
		grid-template-columns: 120px 1.25fr 1fr;
		gap: 0.75rem;
		align-items: center;
		padding: 0.65rem 0.85rem;
		border-bottom: 1px solid #e2e8f0;
		font-size: 0.84rem;
	}
	.comp-row:last-child {
		border-bottom: none;
	}
	.comp-row.is-upcoming {
		background: #fcfcfd;
	}
	.comp-step-col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
	}
	.cs-name {
		font-weight: 700;
		color: #0f172a;
		font-size: 0.82rem;
	}
	.cs-badge {
		font-size: 0.68rem;
		font-weight: 700;
		padding: 0.1rem 0.45rem;
		border-radius: 4px;
		line-height: 1.3;
	}
	.m-hit-a, .m-hit-b {
		background: #dcfce7;
		color: #15803d;
	}
	.m-hit-c {
		background: #e0f2fe;
		color: #0369a1;
	}
	.m-diff {
		background: #fef3c7;
		color: #92400e;
	}
	.m-pending {
		background: #f1f5f9;
		color: #64748b;
	}
	.comp-pred-col {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		border-left: 2px solid #e2e8f0;
		padding-left: 0.65rem;
	}
	.cp-main {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.cp-plan {
		font-size: 0.7rem;
		font-weight: 700;
		background: #fffbeb;
		color: #b45309;
		border: 1px solid #fde68a;
		padding: 0.05rem 0.35rem;
		border-radius: 3px;
	}
	.cp-no {
		font-weight: 700;
		color: #0284c7;
	}
	.cp-route {
		font-weight: 600;
		color: #1e293b;
	}
	.cp-time {
		font-size: 0.76rem;
		color: #64748b;
	}
	.cp-subs {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		font-size: 0.74rem;
		color: #64748b;
	}
	.cp-sub-item {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		flex-wrap: wrap;
	}
	.cps-plan {
		font-weight: 600;
		color: #475569;
	}
	.cps-no {
		font-weight: 600;
		color: #0369a1;
	}
	.cp-live-adj {
		font-size: 0.74rem;
		background: #f0fdf4;
		color: #166534;
		border: 1px solid #bbf7d0;
		border-radius: 4px;
		padding: 0.15rem 0.45rem;
		margin-top: 0.1rem;
	}
	.comp-act-col {
		border-left: 2px solid #cbd5e1;
		padding-left: 0.65rem;
	}
	.ca-box {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.ca-top {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
	}
	.ca-no {
		font-weight: 700;
		color: #0f172a;
		background: #e0f2fe;
		padding: 0.05rem 0.4rem;
		border-radius: 4px;
		font-size: 0.82rem;
	}
	.ca-route {
		font-weight: 700;
		color: #0f172a;
	}
	.ca-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.ca-time {
		font-size: 0.78rem;
		font-weight: 600;
		color: #475569;
	}
	.ca-empty {
		font-size: 0.78rem;
		color: #94a3b8;
		font-weight: 600;
	}

	/* 明日のプラン */
	.confirmed-first {
		background: #fffbeb;
