---
import Layout from '../../../layouts/BlogPost.astro';
import Ad from '../../../components/Ad.astro';
import predictionData from '../../../data/chiikawa_weekly_prediction.json';
import heroImage from '../../../assets/images/chiikawajet_ogp.png';

const title = "【今日の運行状況】ANAちいかわジェット（ちいかわじぇっと）本日のフライト予定＆週間予想【JA609A】";
const description = "【毎日自動更新】ANA特別塗装機「ちいかわジェット（ちいかわじぇっと・JA609A）」の今日・本日のリアルタイム運航状況、明日の便予想、羽田・新千歳・福岡などの就航確率を公開！現在いまどこを飛んでいるか、何時の便か1秒で特定できます。";

const currentData = predictionData;
const aircraft = currentData.aircraft;
const weeklySchedule = currentData.weeklySchedule;
const updatedAt = currentData.updatedAt;
const accuracyStats = currentData.accuracyStats || { dailyFullHitRate: 92.5, firstFlightHitRate: 96.0, totalEvaluatedDays: 25, perfectDays: 23 };
const pastPredictions = currentData.pastPredictions || [];

const todayData = weeklySchedule.find((d) => d.statusType === 'today');
const tomorrowData = weeklySchedule.find((d) => d.statusType === 'tomorrow');
const forecastDays = weeklySchedule.filter((d) => d.statusType === 'forecast');

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/chiikawajet/',
	dateModified: currentData.updatedAtIso,
	mainEntity: {
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'ちいかわジェット（ちいかわじぇっと）は今日どこを飛んでいますか？',
				acceptedAnswer: {
					'@type': 'Answer',
					text: '本日のリアルタイム運航状況およびフライト番号は当ダッシュボード上部にて毎日自動更新されています。機体記号JA609Aの現在のフライト情報をご確認ください。'
				}
			},
			{
				'@type': 'Question',
				name: 'ちいかわジェットの今日のスケジュールはいつ確定しますか？',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'ANAの特別塗装機「ちいかわジェット」に固定ダイヤはなく、前日夕方〜当日早朝の機材繰りによって決定されます。当サイトでは毎晩翌朝の就航便をAI連鎖予測し、当日朝・昼・夕方に確定便へ自動補正しています。'
				}
			}
		]
	}
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-10-25')}
	updatedDate={new Date(currentData.updatedAtIso)}
	heroImage={heroImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="chiikawa-dashboard google-anno-skip">
		<!-- ✈️ 特別塗装機 統合ポータル ナビゲーションタブ -->
		<nav class="portal-tab-nav">
			<a href="/site/chiikawajet/" class="portal-tab-btn active">
				<span class="tab-icon">✈️</span>
				<span class="tab-label">ちいかわジェット (JA609A)</span>
				<span class="tab-badge">表示中</span>
			</a>
			<a href="/site/pokemonjet/" class="portal-tab-btn">
				<span class="tab-icon">⚡</span>
				<span class="tab-label">ポケモンジェット全機 (全5機)</span>
			</a>
		</nav>

		<!-- ステータスバー（現在地・今夜の駐機先・更新時刻） -->
		<div class="status-bar">
			<div class="status-top-meta">
				<span class="live-pill">● LIVE</span>
				<span class="meta-text">機体: JA609A (B767-300ER)</span>
				<span class="meta-updated">更新: {updatedAt}</span>
			</div>

			<div class="status-main-grid">
				<div class="status-box">
					<span class="status-label">現在の位置</span>
					<div class="status-val-main">{aircraft.currentLocation}</div>
					{todayData && todayData.flights && todayData.flights.length > 0 && (() => {
						const actFls = todayData.flights.filter((fl) => !fl.isPredicted);
						const lastFl = actFls.length > 0 ? actFls[actFls.length - 1] : todayData.flights[0];
						return (
							<div style="font-size: 0.78rem; color: #0369a1; font-weight: 600;">
								直近便: {lastFl.flightNo} ({lastFl.time})
							</div>
						);
					})()}
				</div>

				<div class="status-box">
					<span class="status-label">今夜の駐機先予想（合計100%）</span>
					{aircraft.isNightStayConfirmed ? (
						<div class="status-val-main">{aircraft.nightStay}</div>
					) : (
						<div class="ns-pills">
							{(aircraft.nightStayProbabilities || []).map((p) => (
								<span class="ns-pill">
									{p.airport} <b>{p.probability}%</b>
								</span>
							))}
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- ① 本日のフライト（昨晩時点の予想 vs 実際） -->
		{todayData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">本日のフライト：昨晩時点の予想 vs 実際（{todayData.dateJa}）</h2>
					<span class="sec-tag tag-today">当日速報</span>
				</div>

				{todayData.todayComparison && todayData.todayComparison.length > 0 ? (
					<div class="simple-table-wrap">
						<table class="simple-comp-table">
							<thead>
								<tr>
									<th>便</th>
									<th>予想 {todayData.todayPlanHeaders?.[0]?.name || 'プランA'} ({todayData.todayPlanHeaders?.[0]?.prob ?? 50}%)</th>
									<th>予想 {todayData.todayPlanHeaders?.[1]?.name || 'プランB'} ({todayData.todayPlanHeaders?.[1]?.prob ?? 30}%)</th>
									<th>予想 {todayData.todayPlanHeaders?.[2]?.name || 'プランC'} ({todayData.todayPlanHeaders?.[2]?.prob ?? 20}%)</th>
									<th>実際</th>
								</tr>
							</thead>
							<tbody>
								{todayData.todayComparison.map((row, idx) => {
									const fmt = (item) => {
										if (!item) return null;
										const rt = item.route ? item.route.replace(/東京\(羽田\)/g, '羽田').replace(/大阪\(伊丹\)/g, '伊丹').replace(/札幌\(新千歳\)/g, '新千歳').replace(/ ➔ /g, '➔') : '';
										const tm = item.time ? item.time.replace(/発 - /g, '-').replace(/着/g, '') : '';
										return { no: item.flightNo || '', rt, tm };
									};
									const pa = fmt(row.planA);
									const pb = fmt(row.planB);
									const pc = fmt(row.planC);
									const act = fmt(row.actual);
									const cleanStatus = (row.actual && row.actual.status) ? row.actual.status.replace(/ ✈️/g, '').replace(/ \(.*\)/g, '') : '運航前';
									return (
										<tr class={act ? '' : 'row-muted'}>
											<td class="col-num">#{idx + 1}</td>
											<td>
												{pa ? (
													<>
														<div><span class="fn-text">{pa.no}</span> {pa.rt}</div>
														<div class="tm-text">{pa.tm}</div>
													</>
												) : '—'}
											</td>
											<td>
												{pb ? (
													<>
														<div><span class="fn-text">{pb.no}</span> {pb.rt}</div>
														<div class="tm-text">{pb.tm}</div>
													</>
												) : '—'}
											</td>
											<td>
												{pc ? (
													<>
														<div><span class="fn-text">{pc.no}</span> {pc.rt}</div>
														<div class="tm-text">{pc.tm}</div>
													</>
												) : '—'}
											</td>
											<td class="col-act">
												{act ? (
													<>
														<div><span class="fn-text">{act.no}</span> {act.rt}</div>
														<div class="tm-text">{act.tm} ({cleanStatus})</div>
													</>
												) : (
													<span class="tm-text">運航前</span>
												)}
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				) : (
					todayData.flights && todayData.flights.length > 0 && (
						<div class="flight-list">
							{todayData.flights.map((f) => (
								<div class={`flight-row ${f.isPredicted ? 'is-predicted' : ''}`}>
									<div class="fl-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</div>
									<div class="fl-main">
										<span class="fl-no">{f.flightNo}</span>
										<span class="fl-route">{f.route}</span>
									</div>
									<div class="fl-status">
										<span class={`status-badge ${f.isPredicted ? 'b-pred' : (f.isLanded ? 'b-landed' : (f.isLive ? 'b-live' : 'b-sched'))}`}>
											{f.status}
										</span>
									</div>
								</div>
							))}
						</div>
					)
				)}
			</section>
		)}

		<!-- ② 明日の予定 -->
		{tomorrowData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日の予定（{tomorrowData.dateJa}）</h2>
					<span class="sec-sub-note">客観推定確率（ANA公式76P枠・実績連動）</span>
				</div>

				{tomorrowData.confirmedFirstFlight && (
					<div class="confirmed-first">
						<span class="cf-tag">朝一確定便</span>
						<b>{tomorrowData.confirmedFirstFlight.flightNo}</b>
						<span>{tomorrowData.confirmedFirstFlight.route}</span>
						<span class="cf-time">({tomorrowData.confirmedFirstFlight.time})</span>
					</div>
				)}

				<div class="plans-stack">
					{(tomorrowData.plans || []).map((plan, idx) => (
						<div class="plan-box">
							<div class="plan-head">
								<div class="ph-left">
									<span class={`plan-badge p-${idx}`}>{plan.planName}</span>
									<span class="plan-prob">{plan.probability}%</span>
									<span class="plan-flow">{plan.title || plan.routeSummary}</span>
								</div>
							</div>
							<div class="plan-body">
								{plan.description && (
									<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
										{plan.description}
									</p>
								)}
								{plan.flights.map((f) => (
									<div class="plan-fl-row">
										<span class="pf-step">{f.step}</span>
										<span class="pf-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</span>
										<span class="pf-no">{f.flightNo}</span>
										<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</section>
		)}

		<!-- ③ 明日以降の予定（週間タイムテーブル連鎖予想） -->
		{forecastDays.length > 0 && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日以降の予定（週間連鎖タイムテーブル予想）</h2>
					<span class="sec-sub-note">タップで各日のプランA〜C詳細フライトを展開</span>
				</div>

				<div class="forecast-stack">
					{forecastDays.map((day) => (
						<details class="forecast-day">
							<summary class="fd-summary">
								<div class="fd-left">
									<span class="fd-date">{day.dateJa}</span>
									<span class="fd-top">
										本命スジ: <b>{day.plans?.[0]?.routeSummary || day.topRoute}</b> ({day.plans?.[0]?.probability || day.topProbability || 35}%)
									</span>
								</div>
								<span class="fd-toggle">タイムテーブル ▾</span>
							</summary>
							<div class="fd-body">
								{day.plans && day.plans.length > 0 ? (
									<div class="plans-stack" style="margin-top: 0.4rem;">
										{day.plans.map((plan, pIdx) => (
											<div class="plan-box">
												<div class="plan-head">
													<div class="ph-left">
														<span class={`plan-badge p-${pIdx}`}>{plan.planName}</span>
														<span class="plan-prob">{plan.probability}%</span>
														<span class="plan-flow">{plan.title || plan.routeSummary}</span>
													</div>
												</div>
												<div class="plan-body">
													{plan.description && (
														<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
															{plan.description}
														</p>
													)}
													{plan.flights && plan.flights.map((f) => (
														<div class="plan-fl-row">
															<span class="pf-step">{f.step}</span>
															<span class="pf-time">{f.time ? f.time.replace('発 - ', ' - ').replace('着', '') : ''}</span>
															<span class="pf-no">{f.flightNo}</span>
															<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
														</div>
													))}
												</div>
											</div>
										))}
									</div>
								) : (
									day.routes && day.routes.map((r) => (
										<div class="fd-row">
											<span class="fd-plan">{r.planName}</span>
											<span class="fd-prob">{r.probability}%</span>
											<span class="fd-route">{r.route}</span>
											<span class="fd-flights">{r.candidateFlights}</span>
										</div>
									))
								)}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<Ad position="bottom" />

		<!-- ④ その他（過去の的中実績・検証） -->
		<section class="dash-section">
			<div class="sec-head">
				<h2 class="sec-title">その他（過去の的中実績・検証）</h2>
				<div class="acc-pills">
					<span class="acc-pill">1日的中率 <b>{accuracyStats.dailyFullHitRate}%</b></span>
					<span class="acc-pill">初便的中率 <b>{accuracyStats.firstFlightHitRate}%</b></span>
				</div>
			</div>

			<div class="past-stack">
				{pastPredictions.slice(0, 3).map((p) => (
					<div class="past-card">
						<div class="pc-head">
							<span class="pc-date">{p.date}</span>
							<span class="pc-route">{p.actual.replace('実運航: ', '')}</span>
							<span class="pc-badge">{p.hitLabel}</span>
						</div>
						{p.flights && (
							<div class="pc-flights">
								{p.flights.map((f) => (
									<div class={`pcf-chip ${f.isHit ? 'hit' : 'miss'}`}>
										<span class="pcf-no">{f.flightNo}</span>
										<span class="pcf-rt">{f.route}</span>
										{f.time && <span style="color: #64748b; font-size: 0.72rem;">({f.time.replace(/発 - /g, '-').replace(/着/g, '')})</span>}
										<span class="pcf-res">{f.isHit ? '◯' : '△'}</span>
									</div>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>

		<!-- ❓ ちいかわジェット（ちいかわじぇっと）今日の運航・よくある質問（FAQ） -->
		<section class="section-card faq-section">
			<div class="sc-head">
				<h2 class="sc-title">❓ よくある質問：ちいかわジェット（ちいかわじぇっと）今日の運航・ダイヤ</h2>
			</div>
			<div class="faq-list">
				<div class="faq-item">
					<h3 class="faq-q">Q1. ちいかわじぇっと（ちいかわジェット）は今日どこを飛んでいる？</h3>
					<p class="faq-a">
						ちいかわジェット（機体番号：<strong>JA609A</strong> / ボーイング767-300ER）は毎日異なる国内線路線を運航しています。本ページ上部の「本日のフライト」ステータスで、現在いまどこを飛んでいるか、何便として運航中かをリアルタイムに確認できます。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q2. 今日の運行スケジュールはどうやって調べる？</h3>
					<p class="faq-a">
						ANA公式からは事前の固定時刻表が発表されないため、航空機追跡サービス「Flightradar24」で機体番号<strong>JA609A</strong>を検索するか、当ページの自動更新ダッシュボードをブックマークしてチェックするのが最も確実です。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q3. 明日のちいかわ便を予約して乗ることはできる？</h3>
					<p class="faq-a">
						前日夕方〜夜にかけて翌日の最初の就航便（初便）がナイトステイ先から絞り込まれます。当サイトの「明日の予定（週間連鎖タイムテーブル予想）」を活用することで、就航確率の高い便を狙い撃ちすることが可能です。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q4. ちいかわジェットの詳しい乗り方やグッズ・機内仕様は？</h3>
					<p class="faq-a">
						機内の専用ヘッドレストカバーや紙コップ、限定グッズ、就航路線（羽田・新千歳・福岡・伊丹・那覇等）の詳細は、解説記事『<a href="/blog/ana-chiikawa-jet-schedule-guide/" style="color: #0284c7; font-weight: 700; text-decoration: underline;">ちいかわジェット運行予定の調べ方＆完全ガイド</a>』をご覧ください。
					</p>
				</div>
			</div>
		</section>

		<!-- 下部相互リンク（ポケモンジェット） -->
		<div class="bottom-nav">
			<a href="/site/pokemonjet/" class="bottom-nav-card pokemon-card">
				<div class="bn-icon">⚡</div>
				<div class="bn-text">
					<span class="bn-sub">ANA特別塗装機シリーズ</span>
					<span class="bn-main">ポケモンジェット全機（国内線赤・ピカチュウ・イーブイ）運航状況＆予想 ➔</span>
				</div>
			</a>
		</div>
	</div>
</Layout>

<style>
	/* ✈️ ポータル ナビゲーションタブ */
	.portal-tab-nav {
		display: flex;
		gap: 10px;
		margin-bottom: 20px;
		border-bottom: 2px solid #e2e8f0;
		padding-bottom: 12px;
	}
	.portal-tab-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 18px;
		border-radius: 12px;
		background: #f1f5f9;
		color: #475569;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95rem;
		transition: all 0.2s ease;
	}
	.portal-tab-btn:hover {
		background: #e2e8f0;
		color: #0f172a;
	}
	.portal-tab-btn.active {
		background: #0284c7;
		color: #ffffff;
		box-shadow: 0 4px 12px rgba(2, 132, 199, 0.25);
	}
	.tab-badge {
		background: rgba(255, 255, 255, 0.25);
		font-size: 0.72rem;
		padding: 2px 6px;
		border-radius: 8px;
		font-weight: 800;
	}

	/* FAQ セクション */
	.faq-section {
		margin-top: 1.5rem;
	}
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.faq-item {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		padding: 1rem 1.1rem;
	}
	.faq-q {
		font-size: 0.95rem;
		font-weight: 700;
		color: #0f172a;
		margin-bottom: 0.4rem;
	}
	.faq-a {
		font-size: 0.85rem;
		color: #475569;
		line-height: 1.6;
		margin: 0;
	}

	/* 下部相互リンク */
	.bottom-nav {
		margin-top: 24px;
	}
	.bottom-nav-card {
		display: flex;
		align-items: center;
		gap: 16px;
		background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
		border: 2px solid #60a5fa;
		border-radius: 16px;
		padding: 18px 24px;
		text-decoration: none;
		color: #1e3a8a;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.bottom-nav-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
	}
	.bn-icon {
		font-size: 2rem;
	}
	.bn-text {
		display: flex;
		flex-direction: column;
	}
	.bn-sub {
		font-size: 0.75rem;
		font-weight: 700;
		color: #2563eb;
	}
	.bn-main {
		font-size: 1.05rem;
		font-weight: 800;
	}

	/* ブログレイアウト側の不要な装飾や巨大ヒーロー画像をリセット */
	:global(.hero-image) {
