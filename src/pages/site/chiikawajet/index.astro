---
import Layout from '../../../layouts/BlogPost.astro';
import Ad from '../../../components/Ad.astro';
import predictionData from '../../../data/chiikawa_weekly_prediction.json';
import heroImage from '../../../assets/images/chiikawajet_ogp.png';

const title = "【今日の運行状況】ANAちいかわジェット（ちいかわじぇっと）本日のフライト予定＆週間予想【JA609A】";
const description = "【毎日自動更新】ANA特別塗装機「ちいかわジェット（ちいかわじぇっと・JA609A）」の今日・本日のリアルタイム運航状況、明日の便予想、羽田・新千歳・福岡などの就航確率を公開！現在いまどこを飛んでいるか、何時の便か1秒で特定できます。";

const currentData = predictionData;
const aircraft = currentData.aircraft;
const weeklySchedule = currentData.weeklySchedule;
const updatedAt = currentData.updatedAt;
const firstFlightStats = currentData.firstFlightStats || {};

const todayData = weeklySchedule.find((d) => d.statusType === 'today');
const observedFlights = (todayData?.flights || []).filter(f => !f.isPredicted && (f.isLive || f.isLanded));
const lastObserved = observedFlights.at(-1);
const upcomingFlights = (todayData?.flights || []).filter(f => f.isPredicted || (!f.isLive && !f.isLanded));
const liveFlights = observedFlights.filter(f => f.isLive);
const observedFlightNumbers = new Set(observedFlights.map(f => f.flightNo));
const alternativePlans = (todayData?.plans || []).slice(1).map(plan => ({
	...plan,
	remainingFlights: (plan.flights || []).filter(f => !observedFlightNumbers.has(f.flightNo))
})).filter(plan => plan.remainingFlights.length > 0);
const changedFlights = (todayData?.todayComparison || [])
	.map(row => row.planA)
	.filter(flight => flight?.flightNo && flight.update);
const changedActualFlights = (todayData?.todayComparison || [])
	.filter(row => row.planA?.flightNo && (row.actual?.isLive || row.actual?.isLanded) &&
		row.planA.flightNo !== row.actual.flightNo);
const previousPlan = (todayData?.todayComparison || []).map(row => row.planA?.flightNo).filter(Boolean);
const currentPlan = (todayData?.flights || []).map(flight => flight.flightNo).filter(Boolean);
const hasChangedPlan = previousPlan.length > 0 && currentPlan.length > 0 &&
	previousPlan.join('|') !== currentPlan.join('|');
const tomorrowData = weeklySchedule.find((d) => d.statusType === 'tomorrow');
const forecastDays = weeklySchedule.filter((d) => d.statusType === 'forecast');

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/chiikawajet/',
	dateModified: currentData.updatedAtIso,
	mainEntity: {
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'ちいかわジェット（ちいかわじぇっと）は今日どこを飛んでいますか？',
				acceptedAnswer: {
					'@type': 'Answer',
					text: '本日のリアルタイム運航状況およびフライト番号は当ダッシュボード上部にて毎日自動更新されています。機体記号JA609Aの現在のフライト情報をご確認ください。'
				}
			},
			{
				'@type': 'Question',
				name: 'ちいかわジェットの今日のスケジュールはいつ確定しますか？',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'ANAの特別塗装機「ちいかわジェット」に固定ダイヤはなく、前日夕方〜当日早朝の機材繰りによって決定されます。当サイトでは毎晩翌朝の就航便をAI連鎖予測し、当日朝・昼・夕方に確定便へ自動補正しています。'
				}
			}
		]
	}
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-10-25')}
	updatedDate={new Date(currentData.updatedAtIso)}
	heroImage={heroImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="chiikawa-dashboard google-anno-skip">


		<!-- ステータスバー（現在地・今夜の駐機先・更新時刻） -->
		<div class="status-bar">
			<div class="status-top-meta">
				<span class="live-pill">● LIVE</span>
				<span class="meta-text">機体: JA609A (B767-300ER)</span>
				<span class="meta-updated">更新: {updatedAt}</span>
			</div>

			<div class="status-main-grid">
				<div class="status-box">
					<span class="status-label">現在の位置</span>
					<div class="status-val-main">{aircraft.currentLocation}</div>
					{lastObserved && (
						<div style="font-size: 0.78rem; color: #0369a1; font-weight: 600;">
							直近の確認便: {lastObserved.flightNo}
						</div>
					)}
				</div>

				<div class="status-box">
					<span class="status-label">今夜の駐機先予想（合計100%）</span>
					{aircraft.isNightStayConfirmed ? (
						<div class="status-val-main">{aircraft.nightStay}</div>
					) : (
						<div class="ns-pills">
							{(aircraft.nightStayProbabilities || []).map((p) => (
								<span class="ns-pill">
									{p.airport} <b>{p.probability}%</b>
								</span>
							))}
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- 本日の運航予定 -->
		{todayData && (
			<section class="dash-section today-upcoming">
				<div class="sec-head">
					<h2 class="sec-title">今日のこれからの運航予想（{todayData.dateJa}）</h2>
					<span class="sec-tag tag-today">最終更新 {updatedAt}</span>
				</div>
				<p class="today-note">最新の運航情報をもとにした予想です。便や機材は変更される場合があります。</p>
				{liveFlights.length > 0 || upcomingFlights.length > 0 ? (
					<div class="upcoming-list">
						{[...liveFlights, ...upcomingFlights].map((flight, index) => (
							<div class="upcoming-row">
								<div class="upcoming-time">
									<span>{flight.isLive ? '飛行中' : index === liveFlights.length ? '次の便' : '出発'}</span>
									<b>{flight.depTime || flight.time?.match(/\d{1,2}:\d{2}/)?.[0] || '時刻未定'}</b>
								</div>
								<div class="upcoming-detail">
									<div class="upcoming-route">{flight.route}</div>
									<div class="upcoming-meta">
										<b>{flight.flightNo}</b>
										<span>{flight.arrTime ? `${flight.arrTime}着` : flight.time?.match(/-\s*(\d{1,2}:\d{2})/)?.[1] ? `${flight.time.match(/-\s*(\d{1,2}:\d{2})/)[1]}着` : ''}</span>
										<span class="upcoming-label">{flight.isLive ? '飛行中' : flight.isPredicted ? '予想' : '運航予定'}</span>
									</div>
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="today-empty">{aircraft.isNightStayConfirmed ? '本日の今後の運航予想はありません。' : '今後の運航予想を確認中です。'}</p>
				)}
				{alternativePlans.length > 0 && (
					<details class="today-alternatives">
						<summary>今日の別の候補を見る</summary>
						{alternativePlans.map(plan => (
							<div class="alternative-plan">
								<b>{plan.planName}</b>
								<span>{plan.remainingFlights.map(f => `${f.flightNo} ${f.route}（${f.time}）`).join(' → ')}</span>
							</div>
						))}
					</details>
				)}
				{todayData.firstFlightHistory?.morning?.candidates?.length > 0 && (
					<div class="first-flight-candidates">
						<h3>本日の朝に更新した初便候補</h3>
						<p>更新 {new Date(todayData.firstFlightHistory.morning.updatedAtIso).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' })}</p>
						<ol>{todayData.firstFlightHistory.morning.candidates.map(f => <li><b>{f.flightNo}</b> {f.route} {f.depTime}発</li>)}</ol>
					</div>
				)}
				{todayData.firstFlightArrival && (
					<p class="today-note">前夜の最終到着 {todayData.firstFlightArrival.flightNo} {todayData.firstFlightArrival.time}着
						{todayData.firstFlightArrival.gate && ` · 到着ゲート ${todayData.firstFlightArrival.gate}`}
					</p>
				)}
				{hasChangedPlan && (
					<div class="change-reasons">
						<b>前夜からの変更</b>
						{changedFlights.map(flight => (
							<p>{flight.flightNo}は前夜の本命候補でした。当日の情報では{flight.update}です。</p>
						))}
						{changedActualFlights.map(row => (
							<p>前夜は{row.planA.flightNo}を予想していましたが、{row.actual.flightNo}の運航を確認しました。</p>
						))}
						{changedFlights.length === 0 && changedActualFlights.length === 0 && (
							<p>最新の運航情報に合わせて本命予想を更新しました。</p>
						)}
					</div>
				)}
			</section>
		)}

		<!-- ② 明日の予定 -->
		{tomorrowData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日の運航予想（{tomorrowData.dateJa}）</h2>
					<span class="sec-sub-note">最新の運航情報をもとにした予想</span>
				</div>

				{tomorrowData.confirmedFirstFlight && (
					<div class="confirmed-first">
						<span class="cf-tag">朝一便の予想</span>
						<b>{tomorrowData.confirmedFirstFlight.flightNo}</b>
						<span>{tomorrowData.confirmedFirstFlight.route}</span>
						<span class="cf-time">({tomorrowData.confirmedFirstFlight.time})</span>
					</div>
				)}

				{tomorrowData.firstFlightCandidates?.length > 0 && (
					<div class="first-flight-candidates">
						<h3>明日の初便候補</h3>
						<p>初便をまとめた候補順です。経路全体のプランとは順位が異なる場合があります。</p>
						<ol>
							{tomorrowData.firstFlightCandidates.map(f => (
								<li><b>{f.flightNo}</b> {f.route} {f.depTime}発{f.depGate ? ` · 搭乗口 ${f.depGate}` : ''}</li>
							))}
						</ol>
					</div>
				)}

				<div class="plans-stack">
					{(tomorrowData.plans || []).map((plan, idx) => (
						<details class="plan-box" open={idx === 0}>
							<summary class="plan-head">
								<div class="ph-left">
									<span class={`plan-badge p-${idx}`}>{plan.planName}</span>
									<span class="plan-prob">{plan.probability}%</span>
									<span class="plan-flow">{plan.title || plan.routeSummary}</span>
								</div>
							</summary>
							<div class="plan-body">
								{plan.description && (
									<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
										{plan.description}
									</p>
								)}
								{plan.flights.map((f) => (
									<div class="plan-fl-row">
										<span class="pf-step">{f.step}</span>
										<span class="pf-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</span>
										<span class="pf-no">{f.flightNo}</span>
										<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
									</div>
								))}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<!-- 前夜予想と実績の比較 -->
		{todayData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">前夜予想と確認済みの運航（{todayData.dateJa}）</h2>

				</div>

				{todayData.todayComparison && todayData.todayComparison.length > 0 ? (
					<div class="simple-table-wrap">
						<table class="simple-comp-table">
							<thead>
								<tr>
									<th>便</th>
									{todayData.todayPlanHeaders.map(h => <th>前夜 {h.name} ({h.prob}%)</th>)}
									<th>運航実績</th>
								</tr>
							</thead>
							<tbody>
								{todayData.todayComparison.map((row, idx) => {
									const fmt = (item) => {
										if (!item) return null;
										const rt = item.route ? item.route.replace(/東京\(羽田\)/g, '羽田').replace(/大阪\(伊丹\)/g, '伊丹').replace(/札幌\(新千歳\)/g, '新千歳').replace(/ ➔ /g, '➔') : '';
										const tm = item.time ? item.time.replace(/発 - /g, '-').replace(/着/g, '') : '';
										return { no: item.flightNo || '', rt, tm };
									};
									const plans = [row.planA, row.planB, row.planC].slice(0, todayData.todayPlanHeaders.length);
									const actual = row.actual?.isLanded || row.actual?.isLive ? row.actual : null;
									return (
										<tr>
											<td class="col-num">#{idx + 1}</td>
											{plans.map(item => {
												const plan = fmt(item);
												return <td>{plan ? (
													<>
														<div><span class="fn-text">{plan.no}</span> {plan.rt}</div>
														<div class="tm-text">{plan.tm}</div>
														{item.update && <small>{item.update}</small>}
													</>
												) : '—'}</td>;
											})}
											<td class="col-act">
												{actual ? (
													<>
														<div><span class="fn-text">{actual.flightNo}</span> {fmt(actual).rt}</div>
														<div class="tm-text">{actual.isLanded ? '着陸済' : '飛行中'} {actual.time}</div>
													</>
												) : '未確認'}
											</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</div>
				) : <p>確認済みの運航はまだありません。</p>}
				{!todayData.todayPlanHeaders?.length && <p>前夜予想の記録はありません。</p>}

			</section>
		)}


		<!-- ③ 明日以降の予定（週間タイムテーブル連鎖予想） -->
		{forecastDays.length > 0 && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日以降の予定（週間連鎖タイムテーブル予想）</h2>
					<span class="sec-sub-note">タップで各日のプランA〜C詳細フライトを展開</span>
				</div>

				<div class="forecast-stack">
					{forecastDays.map((day) => (
						<details class="forecast-day">
							<summary class="fd-summary">
								<div class="fd-left">
									<span class="fd-date">{day.dateJa}</span>
									<span class="fd-top">
										本命スジ: <b>{day.plans?.[0]?.routeSummary || day.topRoute}</b> ({day.plans?.[0]?.probability || day.topProbability || 35}%)
									</span>
								</div>
								<span class="fd-toggle">タイムテーブル ▾</span>
							</summary>
							<div class="fd-body">
								{day.plans && day.plans.length > 0 ? (
									<div class="plans-stack" style="margin-top: 0.4rem;">
										{day.plans.map((plan, pIdx) => (
											<div class="plan-box">
												<div class="plan-head">
													<div class="ph-left">
														<span class={`plan-badge p-${pIdx}`}>{plan.planName}</span>
														<span class="plan-prob">{plan.probability}%</span>
														<span class="plan-flow">{plan.title || plan.routeSummary}</span>
													</div>
												</div>
												<div class="plan-body">
													{plan.description && (
														<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
															{plan.description}
														</p>
													)}
													{plan.flights && plan.flights.map((f) => (
														<div class="plan-fl-row">
															<span class="pf-step">{f.step}</span>
															<span class="pf-time">{f.time ? f.time.replace('発 - ', ' - ').replace('着', '') : ''}</span>
															<span class="pf-no">{f.flightNo}</span>
															<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
														</div>
													))}
												</div>
											</div>
										))}
									</div>
								) : (
									day.routes && day.routes.map((r) => (
										<div class="fd-row">
											<span class="fd-plan">{r.planName}</span>
											<span class="fd-prob">{r.probability}%</span>
											<span class="fd-route">{r.route}</span>
											<span class="fd-flights">{r.candidateFlights}</span>
										</div>
									))
								)}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<Ad position="bottom" />

		<section class="dash-section">
			<div class="sec-head"><h2 class="sec-title">保存した初便予想の検証</h2></div>
			{['previousNight', 'morning'].map(phase => {
				const stat = firstFlightStats[phase];
				return <p class="today-note">
					{phase === 'previousNight' ? '前夜の予想' : '当日朝の更新'}
					{stat?.total ? ` 本命 ${stat.firstHits}/${stat.total}日 · 上位候補内 ${stat.candidateHits}/${stat.total}日` : ' 記録を蓄積中'}
				</p>;
			})}
		</section>

		<!-- ❓ ちいかわジェット（ちいかわじぇっと）今日の運航・よくある質問（FAQ） -->
		<section class="section-card faq-section">
			<div class="sc-head">
				<h2 class="sc-title">❓ よくある質問：ちいかわジェット（ちいかわじぇっと）今日の運航・ダイヤ</h2>
			</div>
			<div class="faq-list">
				<div class="faq-item">
					<h3 class="faq-q">Q1. ちいかわじぇっと（ちいかわジェット）は今日どこを飛んでいる？</h3>
					<p class="faq-a">
						ちいかわジェット（機体番号：<strong>JA609A</strong> / ボーイング767-300ER）は毎日異なる国内線路線を運航しています。本ページ上部の「本日のフライト」ステータスで、現在いまどこを飛んでいるか、何便として運航中かをリアルタイムに確認できます。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q2. 今日の運行スケジュールはどうやって調べる？</h3>
					<p class="faq-a">
						ANA公式からは事前の固定時刻表が発表されないため、航空機追跡サービス「Flightradar24」で機体番号<strong>JA609A</strong>を検索するか、当ページの自動更新ダッシュボードをブックマークしてチェックするのが最も確実です。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q3. 明日のちいかわ便を予約して乗ることはできる？</h3>
					<p class="faq-a">
						前日夕方〜夜にかけて翌日の最初の就航便（初便）がナイトステイ先から絞り込まれます。当サイトの「明日の予定（週間連鎖タイムテーブル予想）」を活用することで、就航確率の高い便を狙い撃ちすることが可能です。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q4. ちいかわジェットの詳しい乗り方やグッズ・機内仕様は？</h3>
					<p class="faq-a">
						機内の専用ヘッドレストカバーや紙コップ、限定グッズ、就航路線（羽田・新千歳・福岡・伊丹・那覇等）の詳細は、解説記事『<a href="/blog/ana-chiikawa-jet-schedule-guide/" style="color: #0284c7; font-weight: 700; text-decoration: underline;">ちいかわジェット運行予定の調べ方＆完全ガイド</a>』をご覧ください。
					</p>
				</div>
			</div>
		</section>

		<!-- 下部相互リンク（ポケモンジェット） -->
		<div class="bottom-nav">
			<a href="/site/pokemonjet/" class="bottom-nav-card pokemon-card">
				<div class="bn-icon">⚡</div>
				<div class="bn-text">
					<span class="bn-sub">ANA特別塗装機シリーズ</span>
					<span class="bn-main">ポケモンジェット全機（国内線赤・ピカチュウ・イーブイ）運航状況＆予想 ➔</span>
				</div>
			</a>
		</div>
	</div>
</Layout>

<style>
	/* FAQ セクション */
	.faq-section {
		margin-top: 1.5rem;
	}
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.faq-item {
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		padding: 1rem 1.1rem;
	}
	.faq-q {
		font-size: 0.95rem;
		font-weight: 700;
		color: #0f172a;
		margin-bottom: 0.4rem;
	}
	.faq-a {
		font-size: 0.85rem;
		color: #475569;
		line-height: 1.6;
		margin: 0;
	}

	/* 下部相互リンク */
	.bottom-nav {
		margin-top: 24px;
	}
	.bottom-nav-card {
		display: flex;
		align-items: center;
		gap: 16px;
		background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
		border: 2px solid #60a5fa;
		border-radius: 16px;
		padding: 18px 24px;
		text-decoration: none;
