	<!-- リアルタイムフライト現在位置＆予定時刻連動スクリプト -->
	<script is:inline>
		(function() {
			function parseTimeToMin(timeStr) {
				if (!timeStr) return null;
				var m = timeStr.match(/(\d{1,2}):(\d{2})/);
				if (!m) return null;
				return parseInt(m[1], 10) * 60 + parseInt(m[2], 10);
			}

			function updateFlightStatusByCurrentTime() {
				var now = new Date();
				var jstStr = now.toLocaleTimeString('ja-JP', { timeZone: 'Asia/Tokyo', hour12: false });
				var parts = jstStr.split(':');
				var nowMin = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);

				var rows = Array.from(document.querySelectorAll('.flight-tracking-row'));
				if (!rows.length) return;

				var locEl = document.getElementById('current-location-val');
				var hasActiveFlight = false;

				for (var i = 0; i < rows.length; i++) {
					var row = rows[i];
					var depMin = parseTimeToMin(row.getAttribute('data-dep-time'));
					var arrMin = parseTimeToMin(row.getAttribute('data-arr-time'));
					var route = row.getAttribute('data-route') || '';
					var isServerLive = row.getAttribute('data-is-live') === 'true';

					var badgeEl = row.querySelector('.flight-step-badge');
					var labelEl = row.querySelector('.flight-state-label');

					if (depMin !== null && arrMin !== null) {
						if (nowMin >= depMin && nowMin < arrMin) {
							hasActiveFlight = true;
							if (badgeEl) {
								badgeEl.textContent = '飛行中';
								badgeEl.style.background = '#16a34a';
								badgeEl.style.color = '#fff';
								badgeEl.style.padding = '0.15rem 0.45rem';
								badgeEl.style.borderRadius = '4px';
							}
							if (labelEl) {
								labelEl.textContent = '飛行中';
								labelEl.style.background = '#dcfce7';
								labelEl.style.color = '#15803d';
							}
							if (locEl && !isServerLive) {
								locEl.textContent = '飛行中 (' + route + ')';
							}
						} else if (nowMin >= arrMin) {
							if (badgeEl && badgeEl.textContent === '飛行中') {
								badgeEl.textContent = '着陸済';
								badgeEl.style.background = '#64748b';
								badgeEl.style.color = '#fff';
							}
							if (labelEl && labelEl.textContent === '飛行中') {
								labelEl.textContent = '着陸済';
								labelEl.style.background = '#f1f5f9';
								labelEl.style.color = '#475569';
							}
						}
					}
				}

				if (!hasActiveFlight && locEl && !locEl.textContent.includes('飛行中')) {
					for (var j = 0; j < rows.length; j++) {
						var r = rows[j];
						var aMin = parseTimeToMin(r.getAttribute('data-arr-time'));
						var nextRow = rows[j + 1];
						var nextDepMin = nextRow ? parseTimeToMin(nextRow.getAttribute('data-dep-time')) : 1440;

						if (aMin !== null && nowMin >= aMin && (nextDepMin === null || nowMin < nextDepMin)) {
							var rt = r.getAttribute('data-route') || '';
							var rtParts = rt.split(/[➔→\-]/);
							var dest = rtParts.length > 1 ? rtParts[1].trim() : '';
							if (dest) {
								locEl.textContent = dest;
							}
							break;
						}
					}
				}
			}

			updateFlightStatusByCurrentTime();
			setInterval(updateFlightStatusByCurrentTime, 15000);

			async function syncJson() {
				try {
					var res = await fetch('/data/chiikawa_weekly_prediction.json?t=' + Date.now());
					if (!res.ok) return;
					var data = await res.json();
					if (data && data.aircraft) {
						var loc = document.getElementById('current-location-val');
						if (loc && data.aircraft.currentLocation) {
							loc.textContent = data.aircraft.currentLocation;
						}
						var updated = document.querySelector('.meta-updated');
						if (updated && data.updatedAt) {
							updated.textContent = '更新: ' + data.updatedAt;
						}
					}
				} catch (e) {}
			}
			setTimeout(syncJson, 3000);
			setInterval(syncJson, 60000);
		})();
	</script>
</Layout>

