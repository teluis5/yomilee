---
import Layout from '../../../layouts/BlogPost.astro';
import predictionData from '../../../data/chiikawa_weekly_prediction.json';
import dailyPredictionsSnapshot from '../../../../data/daily_predictions_snapshot.json';
import heroImage from '../../../assets/images/chiikawajet_ogp.png';

const title = "毎日更新【今日の運行状況】ちいかわジェット本日のフライト予定＆週間予想【JA609A】";
const description = "【毎日自動更新】ANA特別塗装機「ちいかわジェット（ちいかわじぇっと・JA609A）」の今日・本日のリアルタイム運航状況、明日の便予想、週間フライト予定を公開！現在いまどこを飛んでいるか、何時の便か1秒で特定できます。";

const currentData = predictionData;
const aircraft = currentData.aircraft;
const weeklySchedule = currentData.weeklySchedule;
const updatedAt = currentData.updatedAt;
const firstFlightStats = currentData.firstFlightStats || {};
const pairedFirstFlightStats = currentData.pairedFirstFlightStats || {};
const overnightTrialStats = currentData.overnightTrialStats || {};

const todayData = weeklySchedule.find((d) => d.statusType === 'today');
const observedFlights = (todayData?.flights || []).filter(f => !f.isPredicted && (f.isLive || f.isLanded));
const lastObserved = observedFlights.at(-1);
const upcomingFlights = (todayData?.flights || []).filter(f => f.isPredicted || (!f.isLive && !f.isLanded));
const liveFlights = observedFlights.filter(f => f.isLive);
const observedFlightNumbers = new Set(observedFlights.map(f => f.flightNo));
const alternativePlans = (todayData?.plans || []).slice(1).map(plan => ({
	...plan,
	remainingFlights: (plan.flights || []).filter(f => !observedFlightNumbers.has(f.flightNo))
})).filter(plan => plan.remainingFlights.length > 0);
const changedFlights = (todayData?.todayComparison || [])
	.map(row => row.planA)
	.filter(flight => flight?.flightNo && flight.update);
const changedActualFlights = (todayData?.todayComparison || [])
	.filter(row => row.planA?.flightNo && (row.actual?.isLive || row.actual?.isLanded) &&
		row.planA.flightNo !== row.actual.flightNo);
const previousPlan = (todayData?.todayComparison || []).map(row => row.planA?.flightNo).filter(Boolean);
const currentPlan = (todayData?.flights || []).map(flight => flight.flightNo).filter(Boolean);
const hasChangedPlan = previousPlan.length > 0 && currentPlan.length > 0 &&
	previousPlan.join('|') !== currentPlan.join('|');

// 前夜の代替予想（プランB/C等）と実運航を照合
const prevNightAllPlans = (todayData?.dateStr && (dailyPredictionsSnapshot as Record<string, any>)[todayData.dateStr]) || [];
const observedFnoList = observedFlights.map(f => f.flightNo).filter(Boolean);
const offPlanA = observedFnoList.some(fno => !previousPlan.includes(fno));
let matchedAltPlanName = '';
if (offPlanA && prevNightAllPlans.length > 1 && observedFnoList.length > 0) {
	for (let i = 1; i < prevNightAllPlans.length; i++) {
		const p = prevNightAllPlans[i];
		const pFnos = (p.flights || []).map((f: any) => f.flightNo).filter(Boolean);
		if (pFnos.length > 0 && observedFnoList.every(fno => pFnos.includes(fno))) {
			matchedAltPlanName = (p.planName || '').replace(/\s*\([^)]*\)/g, '').trim() || `プラン${String.fromCharCode(65 + i)}`;
			break;
		}
	}
}
const tomorrowData = weeklySchedule.find((d) => d.statusType === 'tomorrow');
const tomorrowFirstCandidates = tomorrowData?.firstFlightCandidates || [];
const forecastDays = weeklySchedule.filter((d) => d.statusType === 'forecast');

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/chiikawajet/',
	dateModified: currentData.updatedAtIso,
	mainEntity: {
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'ちいかわジェット（ちいかわじぇっと）は今日どこを飛んでいますか？',
				acceptedAnswer: {
					'@type': 'Answer',
					text: '本日のリアルタイム運航状況およびフライト番号は当ダッシュボード上部にて毎日自動更新されています。機体記号JA609Aの現在のフライト情報をご確認ください。'
				}
			},
			{
				'@type': 'Question',
				name: 'ちいかわジェットの今日のスケジュールはいつ確定しますか？',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'ANAの特別塗装機「ちいかわジェット」に固定ダイヤはなく、前日夕方〜当日早朝の機材繰りによって決定されます。当サイトでは毎晩翌朝の就航便をAI連鎖予測し、当日朝・昼・夕方に確定便へ自動補正しています。'
				}
			}
		]
	}
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-10-25')}
	updatedDate={new Date(currentData.updatedAtIso)}
	heroImage={heroImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="chiikawa-dashboard google-anno-skip">
		<p class="page-lead">
			ANA「ちいかわジェット」の本日のリアルタイム運航状況と予測、明日以降のフライト予測を毎日更新でお届けするページです。
		</p>

		<!-- ステータスバー（現在地・今夜の駐機先・更新時刻） -->
		<div class="status-bar">
			<div class="status-top-meta">
				<span class="live-pill">● LIVE</span>
				<span class="meta-text">機体: JA609A (B767-300ER)</span>
				<span class="meta-updated">更新: {updatedAt}</span>
			</div>

			<div class="status-main-grid">
				<div class="status-box">
					<span class="status-label">現在の位置</span>
					<div class="status-val-main" id="current-location-val">{aircraft.currentLocation}</div>
				</div>

				<div class="status-box">
					<span class="status-label">今夜の駐機先予想（合計100%）</span>
					{aircraft.isNightStayConfirmed ? (
						<div class="status-val-main">{aircraft.nightStay}</div>
					) : (
						<div class="ns-pills">
							{(aircraft.nightStayProbabilities || []).map((p) => (
								<span class="ns-pill">
									{p.airport} <b>{p.probability}%</b>
								</span>
							))}
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- クイック目次ナビゲーション（横並びピルボタン） -->
		<nav class="quick-nav" aria-label="ページ内目次">
			<a href="#sec-today" class="quick-nav-link">
				<span class="qn-icon">✈️</span>
				<span>今日の運航</span>
			</a>
			{tomorrowData && (
				<a href="#sec-tomorrow" class="quick-nav-link">
					<span class="qn-icon">📅</span>
					<span>明日の予想</span>
				</a>
			)}
			{forecastDays.length > 0 && (
				<a href="#sec-weekly" class="quick-nav-link">
					<span class="qn-icon">📊</span>
					<span>週間予想</span>
				</a>
			)}
			<a href="#sec-faq" class="quick-nav-link">
				<span class="qn-icon">❓</span>
				<span>よくある質問</span>
			</a>
		</nav>

		<!-- 本日の運航予定 -->
		{todayData && (
			<section class="dash-section today-upcoming" id="sec-today">
				<div class="sec-head">
					<h2 class="sec-title">今日のこれからの運航予想（{todayData.dateJa}）</h2>
					<span class="sec-tag tag-today">最終更新 {updatedAt}</span>
				</div>
				<p class="today-note">最新の運航情報をもとにした予想です。便や機材は変更される場合があります。</p>
				{liveFlights.length > 0 || upcomingFlights.length > 0 ? (
					<div class="upcoming-list">
						{[...liveFlights, ...upcomingFlights].map((flight, index) => {
							const depT = flight.depTime || flight.time?.match(/\d{1,2}:\d{2}/)?.[0] || '';
							const arrT = flight.arrTime || flight.time?.match(/-\s*(\d{1,2}:\d{2})/)?.[1] || '';
							return (
								<div class="upcoming-row flight-tracking-row" data-flight-no={flight.flightNo} data-route={flight.route} data-dep-time={depT} data-arr-time={arrT} data-is-live={flight.isLive ? 'true' : 'false'}>
									<div class="upcoming-time">
										<span class="flight-step-badge">{flight.isLive ? '飛行中' : index === liveFlights.length ? '次の便' : '出発'}</span>
										<b>{depT || '時刻未定'}</b>
									</div>
									<div class="upcoming-detail">
										<div class="upcoming-route">{flight.route}</div>
										<div class="upcoming-meta">
											<b>{flight.flightNo}</b>
											<span>{arrT ? `${arrT}着` : ''}</span>
											<span class="upcoming-label flight-state-label">{flight.isLive ? '飛行中' : flight.isPredicted ? '予想' : '運航予定'}</span>
											{flight.depGate && <span class="upcoming-gate dep-gate">出発搭乗口: {flight.depGate}番</span>}
										</div>
									</div>
								</div>
							);
						})}

						{/* 最終便の後にナイトステイ先の列を追加（他行と同一デザイン・到着ゲート表示） */}
						{(() => {
							const allTodayList = [...liveFlights, ...upcomingFlights];
							const lastFlight = allTodayList.at(-1);
							const stayAirport = aircraft.nightStayProbabilities?.[0]?.airport || (lastFlight?.destCode ? lastFlight.destCode : '未定');
							const isConfirmed = aircraft.isNightStayConfirmed;
							const arrGate = lastFlight?.arrGate;
							const arrTimeStr = lastFlight?.arrTime || (lastFlight?.time?.match(/-\s*(\d{1,2}:\d{2})/)?.[1]) || '夜';

							return (
								<div class="upcoming-row">
									<div class="upcoming-time">
										<span>宿泊</span>
										<b>{arrTimeStr}</b>
									</div>
									<div class="upcoming-detail">
										<div class="upcoming-route">ナイトステイ先: {stayAirport}</div>
										<div class="upcoming-meta">
											<b>{lastFlight ? `${lastFlight.flightNo} 運航後` : '本日最終'}</b>
											<span class="upcoming-label">{isConfirmed ? 'ステイ確定' : 'ステイ予想'}</span>
											{arrGate && <span class="upcoming-gate arr-gate">到着ゲート: {arrGate}</span>}
										</div>
									</div>
								</div>
							);
						})()}
					</div>
				) : (
					<p class="today-empty">{aircraft.isNightStayConfirmed ? '本日の今後の運航予想はありません。' : '今後の運航予想を確認中です。'}</p>
				)}
				{alternativePlans.length > 0 && (
					<details class="today-alternatives">
						<summary><span>今日の別の候補を見る</span><span class="alternatives-count">{alternativePlans.length}件</span></summary>
						<p class="alternatives-note">本命以外の運航予想です。実際の運航とは異なる場合があります。</p>
						{alternativePlans.map(plan => (
							<section class="alternative-plan">
								<h3>{plan.planName}</h3>
								<ol class="alternative-flights">
									{plan.remainingFlights.map(flight => (
										<li class="alternative-flight">
											<span class="alternative-time">{flight.depTime ? `${flight.depTime}発` : (flight.time || '時刻未定')}{flight.depTime && flight.arrTime && <small>{flight.arrTime}着</small>}</span>
											<span class="alternative-flight-info"><b>{flight.flightNo}</b><span>{flight.route}</span></span>
										</li>
									))}
								</ol>
							</section>
						))}
					</details>
				)}
				{hasChangedPlan && (
					<div class="change-reasons">
						<b>前夜からの変更</b>
						{matchedAltPlanName ? (
							<p>前夜の本命（プランA）から変更となり、本日は<strong>【{matchedAltPlanName}】</strong>のルートで運航中のようです。</p>
						) : (
							<>
								{changedFlights.map(flight => (
									<p>{flight.flightNo}は前夜の本命候補でした。当日の情報では{flight.update}です。</p>
								))}
								{changedActualFlights.map(row => (
									<p>前夜は{row.planA.flightNo}を予想していましたが、{row.actual.flightNo}の運航を確認しました。</p>
								))}
								{changedFlights.length === 0 && changedActualFlights.length === 0 && (
									<p>最新の運航情報に合わせて本命予想を更新しました。</p>
								)}
							</>
						)}
					</div>
				)}
			</section>
		)}

		<!-- ② 明日の予定 -->
		{tomorrowData && (
			<section class="dash-section" id="sec-tomorrow">
				<div class="sec-head">
					<h2 class="sec-title">明日の運航予想（{tomorrowData.dateJa}）</h2>
					<span class="sec-sub-note">{updatedAt}時点</span>
				</div>
				<p class="tomorrow-disclaimer">掲載便は予想です。機材変更などで実際の運航と異なる場合があります。</p>
				{tomorrowData.pendingNightStayNote && <p class="tomorrow-note">{tomorrowData.pendingNightStayNote}</p>}
				{tomorrowFirstCandidates.length > 0 ? (
					<div class="tomorrow-first">
						<h3>初便の候補</h3>
						<ol class="first-candidates">
							{tomorrowFirstCandidates.map((flight, idx) => (
								<li class="first-candidate">
									<span class="candidate-rank">{idx === 0 ? '第1候補' : `第${idx + 1}候補`}</span>
									<div class="candidate-info"><b>{flight.flightNo}</b><span>{flight.route}</span></div>
									<span class="candidate-time">{flight.depTime ? `${flight.depTime}発` : ''}{flight.arrTime ? ` · ${flight.arrTime}着` : ''}</span>
								</li>
							))}
						</ol>
						<p class="candidate-note">初便の候補順と、1日全体のプランの順位は異なる場合があります。</p>
					</div>
				) : tomorrowData.confirmedFirstFlight ? (
					<div class="tomorrow-first"><h3>初便の予想</h3><p class="fallback-first"><b>{tomorrowData.confirmedFirstFlight.flightNo}</b> {tomorrowData.confirmedFirstFlight.route}　{tomorrowData.confirmedFirstFlight.time}</p></div>
				) : <p class="tomorrow-note">初便の候補を確認中です。</p>}

				<h3 class="tomorrow-plans-heading">1日の運航プラン</h3>
				{(tomorrowData.plans || []).length ? (
					<div class="tomorrow-plans">
						{tomorrowData.plans.map((plan, idx) => (
							<details class="tomorrow-plan" open={idx === 0}>
								<summary class="tomorrow-plan-head">
									<span class="tomorrow-plan-label">{idx === 0 ? '本命プラン' : `別案 ${idx}`}</span>
									<span class="tomorrow-plan-route">{plan.routeSummary || plan.title || '運航ルート'}</span>
								</summary>
								<ol class="tomorrow-flights">
									{(plan.flights || []).map((flight) => (
										<li class="tomorrow-flight">
											<span class="tomorrow-flight-time">{flight.depTime ? `${flight.depTime}発` : (flight.time || '')}{flight.arrTime && <small>{flight.arrTime}着</small>}</span>
											<span class="tomorrow-flight-info"><b>{flight.flightNo}</b><span>{flight.route}</span></span>
										</li>
									))}
								</ol>
							</details>
						))}
					</div>
				) : <p class="tomorrow-note">1日の運航プランを確認中です。</p>}
			</section>
		)}

		<!-- ③ 明日以降の予定（週間タイムテーブル連鎖予想） -->
		{forecastDays.length > 0 && (
			<section class="dash-section" id="sec-weekly">
				<div class="sec-head">
					<h2 class="sec-title">明日以降の予定（週間連鎖タイムテーブル予想）</h2>
					<span class="sec-sub-note">タップで各日のプランA〜C詳細フライトを展開</span>
				</div>

				<div class="forecast-stack">
					{forecastDays.map((day) => (
						<details class="forecast-day">
							<summary class="fd-summary">
								<div class="fd-left">
									<span class="fd-date">{day.dateJa}</span>
									<span class="fd-top">
										本命スジ: <b>{day.plans?.[0]?.routeSummary || day.topRoute}</b>
									</span>
								</div>
								<span class="fd-toggle">タイムテーブル ▾</span>
							</summary>
							<div class="fd-body">
								{day.plans && day.plans.length > 0 ? (
									<div class="plans-stack" style="margin-top: 0.4rem;">
										{day.plans.map((plan, pIdx) => (
											<div class="plan-box">
												<div class="plan-head">
													<div class="ph-left">
														<span class={`plan-badge p-${pIdx}`}>{plan.planName}</span>
														<span class="plan-flow">{plan.title || plan.routeSummary}</span>
													</div>
												</div>
												<div class="plan-body">
													{plan.description && (
														<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
															{plan.description}
														</p>
													)}
													{plan.flights && plan.flights.map((f) => (
														<div class="plan-fl-row">
															<span class="pf-step">{f.step}</span>
															<span class="pf-time">{f.time ? f.time.replace('発 - ', ' - ').replace('着', '') : ''}</span>
															<span class="pf-no">{f.flightNo}</span>
															<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
														</div>
													))}
												</div>
											</div>
										))}
									</div>
								) : (
									day.routes && day.routes.map((r) => (
										<div class="fd-row">
											<span class="fd-plan">{r.planName}</span>
											<span class="fd-route">{r.route}</span>
											<span class="fd-flights">{r.candidateFlights}</span>
										</div>
									))
								)}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<section class="dash-section">
			<div class="sec-head"><h2 class="sec-title">保存した初便予想の検証</h2></div>
			{['previousNight', 'morning'].map(phase => {
				const stat = firstFlightStats[phase];
				return <p class="today-note">
					{phase === 'previousNight' ? '前夜の予想' : '当日朝の更新'}
					{stat?.total ? ` 本命 ${stat.firstHits}/${stat.total}日 · 上位候補内 ${stat.candidateHits}/${stat.total}日` : ' 記録を蓄積中'}
				</p>;
			})}
			<p class="today-note">同じ日に両方の予想を保存できた場合の比較：{pairedFirstFlightStats.total ? `前夜 ${pairedFirstFlightStats.previousNightHits}/${pairedFirstFlightStats.total}日 · 当日朝 ${pairedFirstFlightStats.morningHits}/${pairedFirstFlightStats.total}日` : '記録を蓄積中'}</p>
			<p class="today-note">予想は初便の出発前に保存し、確認できた実際の初便と照合しています。朝の更新が間に合わない日は比較に含みません。</p>
			<p class="today-note">同型機の前夜到着と翌朝の初便、ちいかわじぇっと自身の傾向を使った新しい補正も検証中です（過去の対応 {overnightTrialStats.samplePairs || 0}組）。精度の改善が確認できるまでは公開中の順位に反映しません。</p>
		</section>

		<!-- ❓ ちいかわジェット（ちいかわじぇっと）今日の運航・よくある質問（FAQ） -->
		<section class="section-card faq-section" id="sec-faq">
			<div class="sc-head">
				<h2 class="sc-title">❓ よくある質問：ちいかわジェット（ちいかわじぇっと）今日の運航・ダイヤ</h2>
			</div>
			<div class="faq-list">
				<div class="faq-item">
					<h3 class="faq-q">Q1. ちいかわじぇっと（ちいかわジェット）は今日どこを飛んでいる？</h3>
					<p class="faq-a">
						ちいかわジェット（機体番号：<strong>JA609A</strong> / ボーイング767-300ER）は毎日異なる国内線路線を運航しています。本ページ上部の「本日のフライト」ステータスで、現在いまどこを飛んでいるか、何便として運航中かをリアルタイムに確認できます。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q2. 今日の運行スケジュールはどうやって調べる？</h3>
					<p class="faq-a">
						ANA公式からは事前の固定時刻表が発表されないため、航空機追跡サービス「Flightradar24」で機体番号<strong>JA609A</strong>を検索するか、当ページの自動更新ダッシュボードをブックマークしてチェックするのが最も確実です。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q3. 明日のちいかわ便を予約して乗ることはできる？</h3>
					<p class="faq-a">
						前日夕方〜夜にかけて翌日の最初の就航便（初便）がナイトステイ先から絞り込まれます。当サイトの「明日の運航予想」や週間タイムテーブル予想を活用することで、就航予定の便を把握することが可能です。
					</p>
				</div>
				<div class="faq-item">
					<h3 class="faq-q">Q4. ちいかわジェットの詳しい乗り方やグッズ・機内仕様は？</h3>
					<p class="faq-a">
