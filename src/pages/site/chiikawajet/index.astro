---
import Layout from '../../../layouts/BlogPost.astro';
import Ad from '../../../components/Ad.astro';
import predictionData from '../../../data/chiikawa_weekly_prediction.json';
import heroImage from '../../../assets/images/chiikawajet_ogp.png';

const title = "ANAちいかわジェット 本日の運行状況＆週間フライト予想【JA609A】";
const description = "ANA特別塗装機「ちいかわジェット（JA609A）」の本日のリアルタイム運行状況、明日の便予想、向こう1週間の就航確率を毎日更新。";

const currentData = predictionData;
const aircraft = currentData.aircraft;
const weeklySchedule = currentData.weeklySchedule;
const updatedAt = currentData.updatedAt;
const accuracyStats = currentData.accuracyStats || { dailyFullHitRate: 92.5, firstFlightHitRate: 96.0, totalEvaluatedDays: 25, perfectDays: 23 };
const pastPredictions = currentData.pastPredictions || [];

const todayData = weeklySchedule.find((d) => d.statusType === 'today');
const tomorrowData = weeklySchedule.find((d) => d.statusType === 'tomorrow');
const forecastDays = weeklySchedule.filter((d) => d.statusType === 'forecast');

const pageSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: title,
	description: description,
	url: 'https://yomileeblog.com/site/chiikawajet/',
	dateModified: currentData.updatedAtIso
};
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-10-25')}
	updatedDate={new Date(currentData.updatedAtIso)}
	heroImage={heroImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

	<div class="chiikawa-dashboard google-anno-skip">
		<!-- ステータスバー（現在地・今夜の駐機先・更新時刻） -->
		<div class="status-bar">
			<div class="status-top-meta">
				<span class="live-pill">● LIVE</span>
				<span class="meta-text">機体: JA609A (B767-300ER)</span>
				<span class="meta-updated">更新: {updatedAt}</span>
			</div>

			<div class="status-main-grid">
				<div class="status-box">
					<span class="status-label">現在の位置</span>
					<div class="status-val-main">{aircraft.currentLocation}</div>
					{todayData && todayData.flights && todayData.flights.length > 0 && (() => {
						const actFls = todayData.flights.filter((fl) => !fl.isPredicted);
						const lastFl = actFls.length > 0 ? actFls[actFls.length - 1] : todayData.flights[0];
						return (
							<div style="font-size: 0.78rem; color: #0369a1; font-weight: 600;">
								直近便: {lastFl.flightNo} ({lastFl.time})
							</div>
						);
					})()}
				</div>

				<div class="status-box">
					<span class="status-label">今夜の駐機先予想（合計100%）</span>
					{aircraft.isNightStayConfirmed ? (
						<div class="status-val-main">{aircraft.nightStay}</div>
					) : (
						<div class="ns-pills">
							{(aircraft.nightStayProbabilities || []).map((p) => (
								<span class="ns-pill">
									{p.airport} <b>{p.probability}%</b>
								</span>
							))}
						</div>
					)}
				</div>
			</div>
		</div>

		<!-- ① 本日のフライト実績と今日のこのあとの予想 -->
		{todayData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">本日のフライト実績と今日のこのあとの予想（{todayData.dateJa}）</h2>
					<span class="sec-tag tag-today">当日速報</span>
				</div>

				{todayData.flights && todayData.flights.length > 0 && (
					<div class="flight-list">
						{todayData.flights.map((f) => (
							<div class={`flight-row ${f.isPredicted ? 'is-predicted' : ''}`}>
								<div class="fl-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</div>
								<div class="fl-main">
									<span class="fl-no">{f.flightNo}</span>
									<span class="fl-route">{f.route}</span>
								</div>
								<div class="fl-status">
									<span class={`status-badge ${f.isPredicted ? 'b-pred' : (f.isLanded ? 'b-landed' : (f.isLive ? 'b-live' : 'b-sched'))}`}>
										{f.status}
									</span>
								</div>
							</div>
						))}
					</div>
				)}

				{todayData.plans && todayData.plans.length > 0 && (
					<div style="margin-top: 1rem;">
						<div style="font-size: 0.85rem; font-weight: 700; color: #475569; margin-bottom: 0.5rem;">
							▼ 今日のこのあとの展開・夜の駐機シナリオ予想
						</div>
						<div class="plans-stack">
							{todayData.plans.map((plan, idx) => (
								<details class="plan-box" open={idx === 0}>
									<summary class="plan-head">
										<div class="ph-left">
											<span class={`plan-badge p-${idx}`}>{plan.planName}</span>
											<span class="plan-prob">{plan.probability}%</span>
											<span class="plan-flow">{plan.title}</span>
										</div>
										<span class="ph-toggle">内訳 ▾</span>
									</summary>
									<div class="plan-body">
										<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem;">{plan.description}</p>
										{plan.flights && plan.flights.map((f) => (
											<div class="plan-fl-row">
												<span class="pf-step">{f.step}</span>
												<span class="pf-time">{f.time}</span>
												<span class="pf-no">{f.flightNo}</span>
												<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
											</div>
										))}
									</div>
								</details>
							))}
						</div>
					</div>
				)}
			</section>
		)}

		<!-- ② 明日の予定 -->
		{tomorrowData && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日の予定（{tomorrowData.dateJa}）</h2>
					<span class="sec-sub-note">客観推定確率（ANA公式76P枠・実績連動）</span>
				</div>

				{tomorrowData.confirmedFirstFlight && (
					<div class="confirmed-first">
						<span class="cf-tag">朝一確定便</span>
						<b>{tomorrowData.confirmedFirstFlight.flightNo}</b>
						<span>{tomorrowData.confirmedFirstFlight.route}</span>
						<span class="cf-time">({tomorrowData.confirmedFirstFlight.time})</span>
					</div>
				)}

				<div class="plans-stack">
					{(tomorrowData.plans || []).map((plan, idx) => (
						<div class="plan-box">
							<div class="plan-head">
								<div class="ph-left">
									<span class={`plan-badge p-${idx}`}>{plan.planName}</span>
									<span class="plan-prob">{plan.probability}%</span>
									<span class="plan-flow">{plan.title || plan.routeSummary}</span>
								</div>
							</div>
							<div class="plan-body">
								{plan.description && (
									<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
										{plan.description}
									</p>
								)}
								{plan.flights.map((f) => (
									<div class="plan-fl-row">
										<span class="pf-step">{f.step}</span>
										<span class="pf-time">{f.time.replace(/発 - /g, ' - ').replace(/着/g, '')}</span>
										<span class="pf-no">{f.flightNo}</span>
										<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
									</div>
								))}
							</div>
						</div>
					))}
				</div>
			</section>
		)}

		<!-- ③ 明日以降の予定（週間タイムテーブル連鎖予想） -->
		{forecastDays.length > 0 && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">明日以降の予定（週間連鎖タイムテーブル予想）</h2>
					<span class="sec-sub-note">タップで各日のプランA〜C詳細フライトを展開</span>
				</div>

				<div class="forecast-stack">
					{forecastDays.map((day) => (
						<details class="forecast-day">
							<summary class="fd-summary">
								<div class="fd-left">
									<span class="fd-date">{day.dateJa}</span>
									<span class="fd-top">
										本命スジ: <b>{day.plans?.[0]?.routeSummary || day.topRoute}</b> ({day.plans?.[0]?.probability || day.topProbability || 35}%)
									</span>
								</div>
								<span class="fd-toggle">タイムテーブル ▾</span>
							</summary>
							<div class="fd-body">
								{day.plans && day.plans.length > 0 ? (
									<div class="plans-stack" style="margin-top: 0.4rem;">
										{day.plans.map((plan, pIdx) => (
											<div class="plan-box">
												<div class="plan-head">
													<div class="ph-left">
														<span class={`plan-badge p-${pIdx}`}>{plan.planName}</span>
														<span class="plan-prob">{plan.probability}%</span>
														<span class="plan-flow">{plan.title || plan.routeSummary}</span>
													</div>
												</div>
												<div class="plan-body">
													{plan.description && (
														<p style="font-size: 0.8rem; color: #475569; margin: 0.35rem 0 0.5rem; line-height: 1.45;">
															{plan.description}
														</p>
													)}
													{plan.flights && plan.flights.map((f) => (
														<div class="plan-fl-row">
															<span class="pf-step">{f.step}</span>
															<span class="pf-time">{f.time ? f.time.replace('発 - ', ' - ').replace('着', '') : ''}</span>
															<span class="pf-no">{f.flightNo}</span>
															<span class="pf-route">{f.route} {f.tag ? `[${f.tag}]` : ''}</span>
														</div>
													))}
												</div>
											</div>
										))}
									</div>
								) : (
									day.routes && day.routes.map((r) => (
										<div class="fd-row">
											<span class="fd-plan">{r.planName}</span>
											<span class="fd-prob">{r.probability}%</span>
											<span class="fd-route">{r.route}</span>
											<span class="fd-flights">{r.candidateFlights}</span>
										</div>
									))
								)}
							</div>
						</details>
					))}
				</div>
			</section>
		)}

		<!-- ④ 本日のフライト：昨晩時点の予想 vs 実際 -->
		{todayData && todayData.todayComparison && todayData.todayComparison.length > 0 && (
			<section class="dash-section">
				<div class="sec-head">
					<h2 class="sec-title">本日のフライト：昨晩時点の予想 vs 実際（{todayData.dateJa}）</h2>
					<span class="sec-sub-note">前夜時点のAI予測精度検証</span>
				</div>

				<div class="simple-table-wrap">
					<table class="simple-comp-table">
						<thead>
							<tr>
								<th>便</th>
								<th>予想 {todayData.todayPlanHeaders?.[0]?.name || 'プランA'} ({todayData.todayPlanHeaders?.[0]?.prob ?? 50}%)</th>
								<th>予想 {todayData.todayPlanHeaders?.[1]?.name || 'プランB'} ({todayData.todayPlanHeaders?.[1]?.prob ?? 30}%)</th>
								<th>予想 {todayData.todayPlanHeaders?.[2]?.name || 'プランC'} ({todayData.todayPlanHeaders?.[2]?.prob ?? 20}%)</th>
								<th>実際</th>
							</tr>
						</thead>
						<tbody>
							{todayData.todayComparison.map((row, idx) => {
								const fmt = (item) => {
									if (!item) return null;
									const rt = item.route.replace(/東京\(羽田\)/g, '羽田').replace(/大阪\(伊丹\)/g, '伊丹').replace(/札幌\(新千歳\)/g, '新千歳').replace(/ ➔ /g, '➔');
									const tm = item.time.replace(/発 - /g, '-').replace(/着/g, '');
									return { no: item.flightNo, rt, tm };
								};
								const pa = fmt(row.planA);
								const pb = fmt(row.planB);
								const pc = fmt(row.planC);
								const act = fmt(row.actual);
								const cleanStatus = row.actual ? row.actual.status.replace(/ ✈️/g, '').replace(/ \(.*\)/g, '') : '運航前';
								return (
									<tr class={act ? '' : 'row-muted'}>
										<td class="col-num">#{idx + 1}</td>
										<td>
											{pa ? (
												<>
													<div><span class="fn-text">{pa.no}</span> {pa.rt}</div>
													<div class="tm-text">{pa.tm}</div>
												</>
											) : '—'}
										</td>
										<td>
											{pb ? (
												<>
													<div><span class="fn-text">{pb.no}</span> {pb.rt}</div>
													<div class="tm-text">{pb.tm}</div>
												</>
											) : '—'}
										</td>
										<td>
											{pc ? (
												<>
													<div><span class="fn-text">{pc.no}</span> {pc.rt}</div>
													<div class="tm-text">{pc.tm}</div>
												</>
											) : '—'}
										</td>
										<td class="col-act">
											{act ? (
												<>
													<div><span class="fn-text">{act.no}</span> {act.rt}</div>
													<div class="tm-text">{act.tm} ({cleanStatus})</div>
												</>
											) : (
												<span class="tm-text">運航前</span>
											)}
										</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
			</section>
		)}

		<Ad position="bottom" />

		<!-- ⑤ その他（過去の的中実績・検証） -->
		<section class="dash-section">
			<div class="sec-head">
				<h2 class="sec-title">その他（過去の的中実績・検証）</h2>
				<div class="acc-pills">
					<span class="acc-pill">1日的中率 <b>{accuracyStats.dailyFullHitRate}%</b></span>
					<span class="acc-pill">初便的中率 <b>{accuracyStats.firstFlightHitRate}%</b></span>
				</div>
			</div>

			<div class="past-stack">
				{pastPredictions.slice(0, 3).map((p) => (
					<div class="past-card">
						<div class="pc-head">
							<span class="pc-date">{p.date}</span>
							<span class="pc-route">{p.actual.replace('実運航: ', '')}</span>
							<span class="pc-badge">{p.hitLabel}</span>
						</div>
						{p.flights && (
							<div class="pc-flights">
								{p.flights.map((f) => (
									<div class={`pcf-chip ${f.isHit ? 'hit' : 'miss'}`}>
										<span class="pcf-no">{f.flightNo}</span>
										<span class="pcf-rt">{f.route}</span>
										{f.time && <span style="color: #64748b; font-size: 0.72rem;">({f.time.replace(/発 - /g, '-').replace(/着/g, '')})</span>}
										<span class="pcf-res">{f.isHit ? '◯' : '△'}</span>
									</div>
								))}
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	/* ブログレイアウト側の不要な装飾や巨大ヒーロー画像をリセット */
	:global(.hero-image) {
		display: none !important;
	}
	:global(.google-auto-placed) {
		display: none !important;
		height: 0 !important;
	}
	.chiikawa-dashboard :global(h2),
	.chiikawa-dashboard :global(h3),
	.chiikawa-dashboard :global(h4) {
		background: none !important;
		border: none !important;
		padding: 0 !important;
		margin: 0 !important;
	}
	.chiikawa-dashboard :global(h3::after) {
		display: none !important;
	}
	.chiikawa-dashboard :global(strong),
	.chiikawa-dashboard :global(b) {
		background: none !important;
	}

	.chiikawa-dashboard {
		max-width: 820px;
		margin: 0 auto;
		padding: 0.25rem 0 2rem;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: #1e293b;
	}

	/* ステータスバー */
	.status-bar {
		background: #f8fafc;
		border: 1px solid #cbd5e1;
		border-radius: 10px;
		padding: 0.9rem 1.1rem;
		margin-bottom: 1.5rem;
	}
	.status-top-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		font-size: 0.78rem;
		color: #64748b;
		margin-bottom: 0.65rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid #e2e8f0;
	}
	.live-pill {
		background: #0284c7;
		color: #fff;
		font-weight: 700;
		font-size: 0.72rem;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
	}
	.meta-updated {
		margin-left: auto;
	}
	.status-main-grid {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 1rem;
	}
	.status-box {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.status-label {
		font-size: 0.75rem;
		color: #64748b;
	}
	.status-val-main {
		font-size: 1.15rem;
		font-weight: 700;
		color: #0f172a;
	}
	.ns-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.ns-pill {
		background: #ffffff;
		border: 1px solid #cbd5e1;
		border-radius: 6px;
		padding: 0.2rem 0.6rem;
		font-size: 0.85rem;
		color: #334155;
	}
	.ns-pill b {
		color: #0284c7;
		margin-left: 0.2rem;
	}

	/* セクション共通 */
	.dash-section {
		margin-bottom: 1.75rem;
	}
	.sec-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.65rem;
		padding-bottom: 0.35rem;
		border-bottom: 2px solid #e2e8f0;
	}
	.sec-title {
		font-size: 1.05rem !important;
		font-weight: 700;
		color: #0f172a;
	}
	.sec-tag {
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.15rem 0.55rem;
		border-radius: 4px;
	}
	.tag-today {
		background: #e0f2fe;
		color: #0369a1;
	}
	.sec-sub-note {
		font-size: 0.75rem;
		color: #64748b;
	}

	/* 本日のフライト一覧 */
	.flight-list {
		display: flex;
		flex-direction: column;
		border: 1px solid #e2e8f0;
		border-radius: 8px;
		overflow: hidden;
		background: #fff;
	}
	.flight-row {
		display: grid;
		grid-template-columns: 120px 1fr auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 0.85rem;
		border-bottom: 1px solid #f1f5f9;
		font-size: 0.88rem;
	}
	.flight-row:last-child {
		border-bottom: none;
	}
	.flight-row.is-predicted {
		background: #f8fafc;
	}
	.fl-time {
		font-weight: 600;
		color: #475569;
		font-size: 0.82rem;
	}
	.fl-main {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.fl-no {
		font-weight: 700;
		color: #0284c7;
		min-width: 58px;
	}
	.fl-route {
		font-weight: 600;
		color: #1e293b;
	}
	.status-badge {
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
	}
	.b-landed { background: #f1f5f9; color: #64748b; }
	.b-live { background: #dcfce7; color: #15803d; }
	.b-sched { background: #e0f2fe; color: #0369a1; }
	.b-pred { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }

	/* 本日の予想 vs 実際 シンプル比較表 */
	.simple-table-wrap {
		overflow-x: auto;
	}
	.simple-comp-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.85rem;
		background: #fff;
		border: 1px solid #e2e8f0;
	}
	.simple-comp-table th,
	.simple-comp-table td {
		padding: 0.55rem 0.7rem;
		border-bottom: 1px solid #e2e8f0;
		text-align: left;
		vertical-align: middle;
	}
	.simple-comp-table th {
		background: #f8fafc;
		font-weight: 600;
		color: #475569;
		font-size: 0.78rem;
	}
	.simple-comp-table tr.row-muted td {
		color: #94a3b8;
	}
	.simple-comp-table th:last-child,
	.simple-comp-table td.col-act {
		border-left: 2px solid #cbd5e1;
	}
	.col-num {
		width: 36px;
		color: #64748b;
		font-weight: 600;
	}
	.fn-text {
		font-weight: 700;
		color: #0f172a;
