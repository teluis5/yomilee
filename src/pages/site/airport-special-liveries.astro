---
import Layout from '../../layouts/BlogPost.astro';

const title = '空港別 特別塗装機の在駐状況・飛来予測（羽田・成田・伊丹・新千歳・福岡・那覇等）';
const description =
	'羽田・成田・伊丹・関西・新千歳・福岡・那覇など国内主要空港ごとに、今いる特別塗装機（ちいかわジェット・ポケモンジェット・ディズニー・大谷翔平ジェット等）とこの後の飛来予測を一覧でスクロール確認できるページです。';
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-11-24')}
	updatedDate={new Date('2026-11-24')}
>
	<div class="airport-tracker">
		<div class="nav-banner">
			<span>🗺️ 全国の飛行状況を地図で見る：</span>
			<a href="/site/special-liveries-map/" class="nav-link-btn">特別塗装機 リアルタイムMAPへ →</a>
		</div>

		<p class="tracker-intro">
			国内主要空港ごとに、<strong>今その空港にいる特別塗装機</strong>と、<strong>この後その空港へ飛来予定の特別塗装機</strong>を縦に並べています。スクロールして各空港の状況を一覧で確認できます。
		</p>

		<div class="airport-jump-bar" id="airport-jump-bar"></div>
		<div id="airports-container" class="airports-container">読込中...</div>
	</div>

	<script is:inline>
		(function () {
			const DATA_URL = '/data/special_liveries.json';
			const TARGET_AIRPORTS = [
				{ code: 'HND', name: '羽田空港' },
				{ code: 'NRT', name: '成田空港' },
				{ code: 'ITM', name: '伊丹空港' },
				{ code: 'KIX', name: '関西空港' },
				{ code: 'CTS', name: '新千歳空港' },
				{ code: 'FUK', name: '福岡空港' },
				{ code: 'OKA', name: '那覇空港' },
				{ code: 'NGO', name: '中部国際空港' },
				{ code: 'UKB', name: '神戸空港' },
				{ code: 'SDJ', name: '仙台空港' },
				{ code: 'HIJ', name: '広島空港' },
				{ code: 'KOJ', name: '鹿児島空港' },
				{ code: 'NGS', name: '長崎空港' },
				{ code: 'KMJ', name: '熊本空港' }
			];

			const AIRPORT_JA = {
				HND: '羽田', NRT: '成田', ITM: '伊丹', KIX: '関西', UKB: '神戸',
				NGO: '中部', CTS: '新千歳', FUK: '福岡', OKA: '那覇', SDJ: '仙台',
				HIJ: '広島', KOJ: '鹿児島', KMJ: '熊本', NGS: '長崎', OIT: '大分',
				KMI: '宮崎', MYJ: '松山', TAK: '高松', KCZ: '高知', OKJ: '岡山',
				KMQ: '小松', HKD: '函館', AKJ: '旭川', AOJ: '青森', ISG: '石垣',
				MMY: '宮古', HNL: 'ホノルル', LAX: 'ロサンゼルス', JFK: 'ニューヨーク'
			};

			let allAircraft = [];

			function toJa(code) {
				if (!code) return '-';
				const c = String(code).replace(/\s*\([A-Z0-9]{3}\)$/, '').trim().toUpperCase();
				return AIRPORT_JA[c] || code;
			}

			function isAtAirport(ac, code) {
				if (ac.status === 'airborne') return false;
				if (!ac.nearestAirport) return false;
				return ac.nearestAirport.includes(`(${code})`) || ac.nearestAirport.includes(AIRPORT_JA[code] || '');
			}

			function formatCard(ac, type) {
				const routeText = ac.origin && ac.destination ? `${toJa(ac.origin)} → ${toJa(ac.destination)}` : '-';
				const timeText = ac.depTime ? `${ac.depTime}発${ac.arrTime ? ` → ${ac.arrTime}着` : ''}` : '-';
				const statusBadge =
					ac.status === 'airborne'
						? '<span class="badge badge-airborne">✈️ 飛行中</span>'
						: ac.status === 'ground'
							? '<span class="badge badge-ground">🛬 地上待機</span>'
							: '<span class="badge badge-offline">🅿️ 駐機中</span>';

				return `
					<div class="ap-card">
						<div class="card-top">
							<span class="airline-pill" style="background:${ac.color}">${ac.airline}</span>
							<span class="reg-code">${ac.reg}</span>
							${statusBadge}
						</div>
						<h4 class="card-title">${ac.name}</h4>
						<div class="card-sub">${ac.model} ・ ${ac.category}</div>
						<div class="card-info">
							<span>便名: <strong>${ac.flight || '-'}</strong></span>
							${type !== 'present' ? `<span>区間: <strong>${routeText}</strong></span>` : ''}
							${ac.depTime ? `<span>時刻: <strong>${timeText}</strong></span>` : ''}
						</div>
					</div>
				`;
			}

			function render() {
				const jumpBar = document.getElementById('airport-jump-bar');
				const container = document.getElementById('airports-container');
				if (!container) return;

				if (jumpBar) {
					jumpBar.innerHTML = TARGET_AIRPORTS.map(
						(ap) => `<a class="jump-pill" href="#ap-${ap.code}">${toJa(ap.code)}</a>`
					).join('');
				}

				container.innerHTML = TARGET_AIRPORTS.map((ap) => {
					const present = allAircraft.filter((ac) => isAtAirport(ac, ap.code));
					const arriving = allAircraft.filter((ac) => ac.destination === ap.code);
					const departing = allAircraft.filter((ac) => ac.origin === ap.code);

					return `
						<section class="ap-block" id="ap-${ap.code}">
							<div class="ap-block-header">
								<h2>${ap.name}</h2>
								<div class="ap-counts">
									<span class="cnt cnt-present">🅿️ 在駐 ${present.length}</span>
									<span class="cnt cnt-arriving">🛬 飛来予定 ${arriving.length}</span>
									<span class="cnt cnt-departing">🛫 出発 ${departing.length}</span>
								</div>
							</div>

							${present.length > 0 ? `<h3 class="sub-h">🅿️ 現在いる機体</h3><div class="ap-list">${present.map((a) => formatCard(a, 'present')).join('')}</div>` : ''}
							${arriving.length > 0 ? `<h3 class="sub-h">🛬 この後の飛来予定</h3><div class="ap-list">${arriving.map((a) => formatCard(a, 'arriving')).join('')}</div>` : ''}
							${departing.length > 0 ? `<h3 class="sub-h">🛫 出発便</h3><div class="ap-list">${departing.map((a) => formatCard(a, 'departing')).join('')}</div>` : ''}
							${present.length === 0 && arriving.length === 0 && departing.length === 0 ? '<p class="empty-msg">現在この空港で捕捉されている特別塗装機はありません。</p>' : ''}
						</section>
					`;
				}).join('');
			}

			async function load() {
				try {
					const res = await fetch(`${DATA_URL}?t=${Date.now()}`);
					if (!res.ok) return;
					const data = await res.json();
					allAircraft = Array.isArray(data.aircraft) ? data.aircraft : [];
					render();
				} catch (e) {
					console.error(e);
				}
			}

			load();
			setInterval(load, 60000);
		})();
	</script>

	<style>
		.airport-tracker {
			margin-top: 1rem;
		}
		.nav-banner {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			background: #eff6ff;
			border: 1px solid #bfdbfe;
			border-radius: 10px;
			padding: 0.75rem 1rem;
			margin-bottom: 1rem;
			font-size: 0.9rem;
			font-weight: 600;
		}
		.nav-link-btn {
			background: #1d4ed8;
			color: #ffffff !important;
			text-decoration: none;
			padding: 0.4rem 0.9rem;
			border-radius: 6px;
			font-size: 0.85rem;
			font-weight: 700;
		}
		.tracker-intro {
			font-size: 0.95rem;
			line-height: 1.7;
			margin-bottom: 1rem;
		}
		.airport-jump-bar {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
			margin-bottom: 1.5rem;
		}
		:global(.jump-pill) {
			padding: 0.35rem 0.75rem;
			border-radius: 9999px;
			border: 1px solid #cbd5e1;
			background: #f8fafc;
			color: #334155 !important;
			font-size: 0.8rem;
			font-weight: 600;
			text-decoration: none;
		}
		:global(.jump-pill:hover) {
			background: #e2e8f0;
		}
		.airports-container {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}
		:global(.ap-block) {
			background: #ffffff;
			border: 1px solid #e2e8f0;
			border-radius: 14px;
			padding: 1.25rem;
			box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
		}
		:global(.ap-block-header) {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
			border-bottom: 2px solid #e2e8f0;
			padding-bottom: 0.6rem;
			margin-bottom: 1rem;
		}
		:global(.ap-block-header h2) {
			margin: 0;
			font-size: 1.25rem;
			color: #0f172a;
		}
		:global(.ap-counts) {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}
		:global(.cnt) {
			font-size: 0.75rem;
			font-weight: 700;
			padding: 0.2rem 0.55rem;
			border-radius: 9999px;
		}
		:global(.cnt-present) {
			background: #dcfce7;
			color: #15803d;
		}
		:global(.cnt-arriving) {
			background: #dbeafe;
			color: #1d4ed8;
		}
		:global(.cnt-departing) {
			background: #f1f5f9;
			color: #475569;
		}
		:global(.sub-h) {
			font-size: 0.95rem;
			margin: 1rem 0 0.5rem 0;
			color: #334155;
		}
		:global(.ap-list) {
			display: grid;
			grid-template-columns: 1fr;
			gap: 0.65rem;
		}
		:global(.ap-card) {
			background: #f8fafc;
			border: 1px solid #e2e8f0;
			border-radius: 10px;
			padding: 0.85rem 1rem;
		}
		:global(.card-top) {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin-bottom: 0.35rem;
		}
		:global(.airline-pill) {
			color: #ffffff;
			font-size: 0.72rem;
			font-weight: 700;
			padding: 0.15rem 0.5rem;
			border-radius: 4px;
		}
		:global(.reg-code) {
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			font-size: 0.85rem;
			font-weight: 700;
			color: #334155;
		}
		:global(.badge) {
			margin-left: auto;
			font-size: 0.72rem;
			font-weight: 700;
			padding: 0.15rem 0.5rem;
			border-radius: 9999px;
		}
		:global(.badge-airborne) {
			background: #dbeafe;
			color: #1d4ed8;
		}
		:global(.badge-ground) {
			background: #dcfce7;
			color: #15803d;
		}
		:global(.badge-offline) {
			background: #e2e8f0;
			color: #475569;
		}
		:global(.card-title) {
			font-size: 0.98rem;
			font-weight: 700;
			margin: 0 0 0.2rem 0;
			color: #0f172a;
		}
		:global(.card-sub) {
			font-size: 0.76rem;
			color: #64748b;
			margin-bottom: 0.45rem;
		}
		:global(.card-info) {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			font-size: 0.82rem;
			color: #334155;
		}
		:global(.empty-msg) {
			font-size: 0.85rem;
			color: #64748b;
			margin: 0;
		}
	</style>
</Layout>
