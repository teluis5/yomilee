---
import Layout from '../../layouts/BlogPost.astro';
import { SITE_TITLE } from '../../consts';

const title = '日本の特別塗装機 リアルタイム現在地MAP（ANA・JAL・ポケモン・ちいかわ等）';
const description =
	'ANAのちいかわジェットやフライングホヌ、JALのディズニー・大谷翔平ジェット、スカイマーク・AIRDO・ソラシドエアのポケモンジェットなど、日本の主要特別塗装機が今どこを飛んでいるか一目でわかるインタラクティブMAPです。';
---

<Layout
	title={title}
	description={description}
	pubDate={new Date('2026-11-24')}
	updatedDate={new Date('2026-11-24')}
>
	<link
		rel="stylesheet"
		href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
		integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
		crossorigin=""
	/>

	<div class="livery-tracker">
		<div class="nav-banner">
			<span>✈️ 空港ごとの在駐・飛来予測を見る：</span>
			<a href="#airport-section" class="nav-link-btn">空港別 在駐・飛来予測へ ↓</a>
		</div>

		<p class="tracker-intro">
			ANA・JAL・スカイマーク・AIRDO・ソラシドエアなど、国内主要航空会社の<strong>特別塗装機</strong>が「今どこにいるのか」を地図上で確認できるトラッカーです。飛行中の機体は進行方向を向いたアイコンで表示され、クリックすると便名・区間・時刻を確認できます。
		</p>

		<h2 class="list-heading">日本の特別塗装機 リアルタイム現在地MAP</h2>

		<div class="controls-bar">
			<div class="filter-group" id="genre-filters" aria-label="ジャンル別マルチセレクト">
				<button type="button" class="filter-btn active" data-genre="ALL">すべて</button>
				<button type="button" class="filter-btn" data-genre="pokemon">⚡ ポケモン</button>
				<button type="button" class="filter-btn" data-genre="chiikawa">🎀 ちいかわ</button>
				<button type="button" class="filter-btn" data-genre="disney">🏰 ディズニー</button>
				<button type="button" class="filter-btn" data-genre="kimetsu">⚔️ 鬼滅の刃</button>
				<button type="button" class="filter-btn" data-genre="other">✨ その他</button>
			</div>
			<label class="toggle-airborne">
				<input type="checkbox" id="only-active-checkbox" />
				<span>位置捕捉中のみ表示</span>
			</label>
		</div>

		<div id="livery-map" class="map-container" aria-label="特別塗装機現在地マップ"></div>

		<h2 class="list-heading">特別塗装機 ステータス一覧</h2>
		<p class="list-note">カードをクリックすると、地図上の該当機体へフォーカスします（位置捕捉中の機体のみ）。</p>
		<div id="aircraft-list" class="aircraft-grid"></div>

		<section id="airport-section" class="airport-section">
			<h2 class="list-heading">空港別 特別塗装機の在駐・飛来タイムライン</h2>
			<p class="list-note">各空港に「何時から何時まで」特別塗装機がいるかをタイムライン（06:00〜23:00）で確認できます。赤い縦線が現在時刻です。</p>
			<div class="airport-jump-bar" id="airport-jump-bar"></div>
			<div id="airports-container" class="airports-container"></div>
		</section>
	</div>

	<script
		is:inline
		src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
		integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
		crossorigin=""
	></script>

	<script is:inline>
		(function () {
			const DATA_URL = '/data/special_liveries.json';
			// Cloudflare Workers にデプロイしたプロキシURLを設定すると30秒ごとに完全リアルタイム更新されます
			const LIVE_PROXY_URL = 'https://teluis-adsb-proxy.expo-price-cache.workers.dev';
			const REFRESH_INTERVAL_MS = 30000;
			let allAircraft = [];
			const selectedGenres = new Set();

			function getAircraftGenre(ac) {
				const text = `${ac.name || ''} ${ac.description || ''}`.toLowerCase();
				if (/ポケモン|ピカチュウ|ロコン|イーブイ|ナッシー|ミジュマル/.test(text)) return 'pokemon';
				if (/ちいかわ/.test(text)) return 'chiikawa';
				if (/ディズニー|ファンタジア|ファンタジースプリングス|ミッキー/.test(text)) return 'disney';
				if (/鬼滅/.test(text)) return 'kimetsu';
				return 'other';
			}
			let onlyActive = false;
			const markersByReg = new Map();

			// 地図初期化（日本中心・海は淡い青単一色・移動範囲を日本周辺に制限）
			const japanBounds = L.latLngBounds([20.0, 120.0], [48.0, 152.0]);
			const map = L.map('livery-map', {
				center: [36.2, 137.9],
				zoom: 5,
				minZoom: 4,
				maxZoom: 14,
				maxBounds: japanBounds,
				maxBoundsViscosity: 1.0,
				zoomControl: true
			});

			// 点線ルート用の最前面ペインを作成（マウス操作は透過）
			const routePane = map.createPane('routeLinePane');
			routePane.style.zIndex = '700';
			routePane.style.pointerEvents = 'none';

			const vectorLandLayer = L.layerGroup();
			let japanGeoJsonLayer = null;

			const THEMES = {
				default: { sea: '#93c5fd', land: '#86efac', border: '#4ade80' },
				radar: { sea: '#0f172a', land: '#1e293b', border: '#38bdf8' },
				ocean: { sea: '#1e3a8a', land: '#0f766e', border: '#2dd4bf' },
				sepia: { sea: '#d6d3d1', land: '#a8a29e', border: '#78716c' }
			};

			// 日本の陸地GeoJSONを読み込み（淡い緑単一色）
			fetch('/data/japan.geojson')
				.then((r) => r.json())
				.then((geo) => {
					japanGeoJsonLayer = L.geoJSON(geo, {
						style: {
							fillColor: THEMES.default.land,
							fillOpacity: 1,
							color: THEMES.default.border,
							weight: 1
						}
					});
					japanGeoJsonLayer.addTo(vectorLandLayer);
				})
				.catch((e) => console.warn('GeoJSON load error:', e));

			// デフォルトは「陸：淡い緑単一色 / 海：淡い青単一色」のベクター地図
			vectorLandLayer.addTo(map);

			function createPlaneIcon(ac) {
				const angle = typeof ac.track === 'number' ? ac.track : 0;
				const isOffline = ac.status === 'offline';
				const color = isOffline ? '#64748b' : (ac.color || '#005BAC');
				const isAirborne = ac.status === 'airborne';
				const pulseHtml = isAirborne ? `<span class="plane-pulse" style="border-color:${color}"></span>` : '';
				const opacityStyle = isOffline ? 'opacity: 0.72;' : '';

				return L.divIcon({
					className: 'custom-plane-marker',
					html: `
						<div class="plane-wrapper" style="${opacityStyle}" title="${ac.name} (${ac.reg})">
							${pulseHtml}
							<svg viewBox="0 0 24 24" width="28" height="28" style="transform: rotate(${angle}deg); filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));">
								<path fill="${color}" stroke="#ffffff" stroke-width="1.2" d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
							</svg>
							<span class="plane-tag" style="background:${color}">${isOffline ? `🅿️ ${ac.reg}` : (ac.flight || ac.reg)}</span>
						</div>
					`,
					iconSize: [36, 36],
					iconAnchor: [18, 18],
					popupAnchor: [0, -18]
				});
			}

			function formatStatusBadge(status) {
				if (status === 'airborne') return '<span class="badge badge-airborne">✈️ 飛行中</span>';
				if (status === 'ground') return '<span class="badge badge-ground">🛬 地上待機</span>';
				return '<span class="badge badge-offline">📡 圏外/駐機</span>';
			}

			const AIRPORT_JA = {
				HND: '羽田', NRT: '成田', ITM: '伊丹', KIX: '関西', UKB: '神戸',
				NGO: '中部', CTS: '新千歳', FUK: '福岡', OKA: '那覇', SDJ: '仙台',
				HIJ: '広島', KOJ: '鹿児島', KMJ: '熊本', NGS: '長崎', OIT: '大分',
				KMI: '宮崎', MYJ: '松山', TAK: '高松', KCZ: '高知', OKJ: '岡山',
				KMQ: '小松', HKD: '函館', AKJ: '旭川', AOJ: '青森', ISG: '石垣',
				MMY: '宮古', SHI: '下地島', IBR: '茨城', TOY: '富山', YGJ: '米子',
				IZO: '出雲', UBJ: '山口宇部', TKS: '徳島', AXT: '秋田', HNA: '花巻',
				KIJ: '新潟', FSZ: '静岡', HSG: '佐賀', KKJ: '北九州', ASJ: '奄美',
				OBO: '帯広', KUH: '釧路', MMB: '女満別', HNL: 'ホノルル',
				LAX: 'ロサンゼルス', SFO: 'サンフランシスコ', JFK: 'ニューヨーク',
				ORD: 'シカゴ', LHR: 'ロンドン', FRA: 'フランクフルト', CDG: 'パリ',
				SIN: 'シンガポール', BKK: 'バンコク', TPE: '台北', ICN: 'ソウル'
			};

			function toAirportJa(codeOrName) {
				if (!codeOrName) return '';
				const clean = String(codeOrName).replace(/\s*\([A-Z0-9]{3}\)$/, '').trim();
				return AIRPORT_JA[clean.toUpperCase()] || clean;
			}

			const AIRPORT_COORDS = {
				HND: [35.5494, 139.7798], NRT: [35.7720, 140.3929], ITM: [34.7855, 135.4382],
				KIX: [34.4320, 135.2304], UKB: [34.6328, 135.2239], NGO: [34.8584, 136.8054],
				CTS: [42.7752, 141.6923], FUK: [33.5859, 130.4507], OKA: [26.1958, 127.6459],
				SDJ: [38.1397, 140.9169], HIJ: [34.4361, 132.9194], KOJ: [31.8034, 130.7194],
				KMJ: [32.8373, 130.8551], NGS: [32.9169, 129.9136], OIT: [33.4794, 131.7372],
				KMI: [31.8772, 131.4486], MYJ: [33.8272, 132.6997], TAK: [34.2142, 134.0156],
				KCZ: [33.5461, 133.6694], OKJ: [34.7569, 133.8553], KMQ: [36.3946, 136.4065],
				HKD: [41.7700, 140.8219], AKJ: [43.6708, 142.4475], MMB: [43.8806, 144.1640],
				OBO: [42.7333, 143.2172], KUH: [43.0410, 144.1930], AOJ: [40.7347, 140.6908],
				AXT: [39.6156, 140.2186], HNA: [39.4286, 141.1353], KIJ: [37.9558, 139.1114],
				IBR: [36.1811, 140.4153], FSZ: [34.7961, 138.1894], TOY: [36.6483, 137.1875],
				IZO: [35.4136, 132.8900], YGJ: [35.4922, 133.2364], UBJ: [33.9300, 131.2786],
				TKS: [34.1328, 134.6067], KKJ: [33.8459, 131.0347], HSG: [33.1497, 130.3022],
				ASJ: [28.4306, 129.7125], ISG: [24.3964, 124.2450], MMY: [24.7828, 125.2951],
				SHI: [24.8267, 125.1447]
			};
			let hoverRouteLine = null;

			// マップに主要空港アイコンを表示（飛行機より背面に配置）
			for (const [code, coords] of Object.entries(AIRPORT_COORDS)) {
				const apName = AIRPORT_JA[code] || code;
				const apIcon = L.divIcon({
					className: 'airport-marker',
					html: `<div class="ap-pin" title="${apName}空港"><span class="ap-dot"></span><span class="ap-label">${apName}</span></div>`,
					iconSize: [50, 20],
					iconAnchor: [25, 10]
				});
				L.marker(coords, { icon: apIcon, zIndexOffset: -500, interactive: true })
					.bindTooltip(`${apName}空港`, { direction: 'top', offset: [0, -6] })
					.addTo(map);
			}

			function render() {
				// マーカークリア
				for (const marker of markersByReg.values()) {
					map.removeLayer(marker);
				}
				markersByReg.clear();

				const filtered = allAircraft.filter((ac) => {
					if (selectedGenres.size > 0 && !selectedGenres.has(getAircraftGenre(ac))) return false;
					if (onlyActive && ac.status === 'offline') return false;
					return true;
				});

				// マップにプロット
				for (const ac of filtered) {
					if (typeof ac.lat === 'number' && typeof ac.lon === 'number') {
						const marker = L.marker([ac.lat, ac.lon], {
							icon: createPlaneIcon(ac)
						}).addTo(map);

						const routeText = ac.origin && ac.destination
							? `${toAirportJa(ac.origin)} → ${toAirportJa(ac.destination)}`
							: '-';
						const timeText = ac.depTime ? `${ac.depTime}発${ac.arrTime ? ` → ${ac.arrTime}着` : ''}` : '-';

						// ホバー時のツールチップ（出発地・行き先・出発時刻のみシンプル表示）
						marker.bindTooltip(
							`<div class="livery-tooltip">
								<div class="tt-title">${ac.name} (${ac.flight || ac.reg})</div>
								<div class="tt-route">🛫 ${routeText}</div>
								${ac.depTime ? `<div class="tt-time">🕒 ${timeText}</div>` : ''}
							</div>`,
							{ direction: 'top', offset: [0, -14], opacity: 0.96 }
						);

						// マウスオーバーで到着空港へ向けて点線を描画
						marker.on('mouseover', () => {
							if (hoverRouteLine) {
								map.removeLayer(hoverRouteLine);
								hoverRouteLine = null;
							}
							const destCoord = ac.destination ? AIRPORT_COORDS[String(ac.destination).toUpperCase()] : null;
							if (destCoord) {
								hoverRouteLine = L.polyline([[ac.lat, ac.lon], destCoord], {
									pane: 'routeLinePane',
									color: ac.color || '#1d4ed8',
									weight: 2.5,
									dashArray: '6, 6',
									opacity: 0.9
								}).addTo(map);
							}
						});
						marker.on('mouseout', () => {
							if (hoverRouteLine) {
								map.removeLayer(hoverRouteLine);
								hoverRouteLine = null;
							}
						});

						marker.bindPopup(`
							<div class="livery-popup">
								<div class="popup-header">
									<span class="popup-airline" style="background:${ac.color}">${ac.airline}</span>
									<strong>${ac.reg}</strong>
								</div>
								<div class="popup-title">${ac.name}</div>
								<div class="popup-meta">${ac.model} / ${formatStatusBadge(ac.status)}</div>
								<table class="popup-table">
									<tr><th>便名</th><td>${ac.flight || '未設定'}</td></tr>
									<tr><th>区間</th><td>${routeText}</td></tr>
									<tr><th>時刻</th><td>${timeText}</td></tr>
								</table>
								<p class="popup-note">${ac.note || ''}</p>
							</div>
						`);

						markersByReg.set(ac.reg, marker);
					}
				}

				// リスト描画
				const listEl = document.getElementById('aircraft-list');
				if (!listEl) return;

				if (filtered.length === 0) {
					listEl.innerHTML = '<p class="empty-msg">条件に一致する機体がありません。</p>';
					return;
				}

				listEl.innerHTML = filtered
					.map((ac) => {
						const hasPos = typeof ac.lat === 'number' && typeof ac.lon === 'number';
						const routeInfo = ac.origin && ac.destination ? `<span>🛫 <strong>${toAirportJa(ac.origin)} → ${toAirportJa(ac.destination)}</strong></span>` : '';
						return `
							<div class="aircraft-card ${hasPos ? 'is-clickable' : 'is-offline'}" data-reg="${ac.reg}">
								<div class="card-top">
									<span class="airline-pill" style="background:${ac.color}">${ac.airline}</span>
									<span class="reg-code">${ac.reg}</span>
									${formatStatusBadge(ac.status)}
								</div>
								<h3 class="card-title">${ac.name}</h3>
								<div class="card-sub">${ac.model} ・ ${ac.category}</div>
								<div class="card-telemetry">
									<span>便名: <strong>${ac.flight || '-'}</strong></span>
									${routeInfo}
								</div>
								<p class="card-note">${ac.note || ''}</p>
							</div>
						`;
					})
					.join('');

				listEl.querySelectorAll('.aircraft-card.is-clickable').forEach((card) => {
					card.addEventListener('click', () => {
						const reg = card.getAttribute('data-reg');
						const marker = markersByReg.get(reg);
						if (marker) {
							map.setView(marker.getLatLng(), 8, { animate: true });
							marker.openPopup();
							document.getElementById('livery-map')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
						}
					});
				});

				// 空港別 在駐・飛来予測の描画
				renderAirports();
			}

			const TARGET_AIRPORTS = [
				{ code: 'HND', name: '羽田空港' }, { code: 'NRT', name: '成田空港' },
				{ code: 'ITM', name: '伊丹空港' }, { code: 'KIX', name: '関西空港' },
				{ code: 'CTS', name: '新千歳空港' }, { code: 'FUK', name: '福岡空港' },
				{ code: 'OKA', name: '那覇空港' }, { code: 'NGO', name: '中部国際空港' },
				{ code: 'UKB', name: '神戸空港' }, { code: 'IBR', name: '茨城空港' },
				{ code: 'SDJ', name: '仙台空港' }, { code: 'HIJ', name: '広島空港' },
				{ code: 'KOJ', name: '鹿児島空港' }, { code: 'NGS', name: '長崎空港' },
				{ code: 'KMJ', name: '熊本空港' }, { code: 'KMI', name: '宮崎空港' },
				{ code: 'MYJ', name: '松山空港' }, { code: 'HKD', name: '函館空港' },
				{ code: 'AKJ', name: '旭川空港' }, { code: 'MMB', name: '女満別空港' },
				{ code: 'OBO', name: '帯広空港' }, { code: 'KUH', name: '釧路空港' },
				{ code: 'ISG', name: '石垣空港' }, { code: 'MMY', name: '宮古空港' },
				{ code: 'SHI', name: '下地島空港' }
			];

			function toMin(hhmm) {
				if (!hhmm || !/^\d{1,2}:\d{2}$/.test(hhmm)) return null;
				const [h, m] = hhmm.split(':').map(Number);
				return h * 60 + m;
			}

			function renderAirports() {
				const jumpBar = document.getElementById('airport-jump-bar');
				const container = document.getElementById('airports-container');
				if (!container) return;

				if (jumpBar) {
					jumpBar.innerHTML = TARGET_AIRPORTS.map(
						(ap) => `<a class="jump-pill" href="#ap-${ap.code}">${toAirportJa(ap.code)}</a>`
					).join('');
				}

				const START_MIN = 6 * 60;  // 06:00
				const END_MIN = 23 * 60;   // 23:00
				const SPAN = END_MIN - START_MIN;
				const now = new Date();
				const nowMin = now.getHours() * 60 + now.getMinutes();
				const nowPct = Math.max(0, Math.min(100, ((nowMin - START_MIN) / SPAN) * 100));
				const nowLabel = now.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });

				const ticksHtml = [6, 9, 12, 15, 18, 21]
					.map((h) => {
						const pct = ((h * 60 - START_MIN) / SPAN) * 100;
						return `<span class="tl-tick" style="left:${pct}%">${String(h).padStart(2, '0')}:00</span>`;
					})
					.join('');

				container.innerHTML = TARGET_AIRPORTS.map((ap) => {
					const items = [];
					for (const ac of allAircraft) {
						const present = isAtAirport(ac, ap.code);
						const isArr = ac.destination === ap.code;
						const isDep = ac.origin === ap.code;
						if (!present && !isArr && !isDep) continue;

						let barStart = START_MIN;
						let barEnd = END_MIN;
						let stayText = '';

						if (isArr && isDep) {
							const aMin = toMin(ac.arrTime) ?? START_MIN;
							const dMin = toMin(ac.depTime) ?? END_MIN;
							barStart = Math.max(START_MIN, Math.min(aMin, dMin));
							barEnd = Math.min(END_MIN, Math.max(aMin, dMin));
							stayText = `${ac.arrTime || '?'} 〜 ${ac.depTime || '?'} 滞在`;
						} else if (isArr) {
							const aMin = toMin(ac.arrTime);
							barStart = aMin !== null ? Math.max(START_MIN, Math.min(END_MIN, aMin)) : Math.max(START_MIN, nowMin);
							barEnd = END_MIN;
							stayText = ac.arrTime
								? `🛬 ${ac.arrTime}頃〜滞在（${toAirportJa(ac.origin)}発 ${ac.flight || ''}）`
								: `🛬 飛来予定（${toAirportJa(ac.origin)}発 ${ac.flight || ''}）`;
						} else if (isDep) {
							const dMin = toMin(ac.depTime);
							barStart = START_MIN;
							barEnd = dMin !== null ? Math.max(START_MIN, Math.min(END_MIN, dMin)) : Math.min(END_MIN, nowMin);
							stayText = ac.depTime
								? `🛫 〜${ac.depTime}まで滞在（${ac.depTime}発 → ${toAirportJa(ac.destination)}）`
								: `🛫 出発便（→ ${toAirportJa(ac.destination)} ${ac.flight || ''}）`;
						} else if (present) {
							barStart = START_MIN;
							barEnd = END_MIN;
							stayText = `🅿️ 現在滞在中（次の便未捕捉）`;
						}

						const leftPct = ((barStart - START_MIN) / SPAN) * 100;
						const widthPct = Math.max(4, ((barEnd - barStart) / SPAN) * 100);
						items.push({ ac, leftPct, widthPct, stayText, present, isArr, isDep });
					}

					const rowsHtml = items
						.map(({ ac, leftPct, widthPct, stayText }) => `
							<div class="tl-row">
								<div class="tl-info">
									<div class="tl-ac-head">
										<span class="airline-pill" style="background:${ac.color}">${ac.airline}</span>
										<strong class="tl-name">${ac.name}</strong>
										<span class="reg-code">${ac.reg}</span>
									</div>
									<div class="tl-stay-text">${stayText}</div>
								</div>
								<div class="tl-track">
									<div class="tl-now-line" style="left:${nowPct}%" title="現在時刻 ${nowLabel}"></div>
									<div class="tl-bar" style="left:${leftPct}%; width:${widthPct}%; background:${ac.color};" title="${stayText}"></div>
								</div>
							</div>
						`)
						.join('');

					return `
						<div class="ap-block" id="ap-${ap.code}">
							<div class="ap-block-header">
								<h3>${ap.name}</h3>
								<div class="ap-counts">
									<span class="cnt cnt-present">対象 ${items.length}機</span>
								</div>
							</div>
							${items.length > 0 ? `
								<div class="tl-header">
									<div class="tl-header-spacer">機体・滞在時間帯</div>
									<div class="tl-axis">${ticksHtml}<span class="tl-now-badge" style="left:${nowPct}%">▼${nowLabel}</span></div>
								</div>
								<div class="tl-body">${rowsHtml}</div>
							` : '<p class="empty-msg">現在この空港で捕捉されている特別塗装機はありません。</p>'}
						</div>
					`;
				}).join('');
			}

			async function loadData() {
				try {
					const res = await fetch(`${DATA_URL}?t=${Date.now()}`);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const data = await res.json();
					allAircraft = Array.isArray(data.aircraft) ? data.aircraft : [];
					render();
				} catch (err) {
					console.error('Failed to load special liveries data:', err);
				}
			}

			document.getElementById('genre-filters')?.addEventListener('click', (e) => {
				const btn = e.target.closest('.filter-btn');
				if (!btn) return;
				const genre = btn.getAttribute('data-genre') || 'ALL';
				const allBtn = document.querySelector('#genre-filters .filter-btn[data-genre="ALL"]');

				if (genre === 'ALL') {
					selectedGenres.clear();
					document.querySelectorAll('#genre-filters .filter-btn').forEach((b) => b.classList.remove('active'));
					allBtn?.classList.add('active');
				} else {
					if (selectedGenres.has(genre)) {
						selectedGenres.delete(genre);
						btn.classList.remove('active');
					} else {
						selectedGenres.add(genre);
						btn.classList.add('active');
					}
					if (selectedGenres.size === 0) {
						allBtn?.classList.add('active');
					} else {
						allBtn?.classList.remove('active');
					}
				}
				render();
			});

			document.getElementById('only-active-checkbox')?.addEventListener('change', (e) => {
				onlyActive = Boolean(e.target.checked);
				render();
			});

			async function refreshLiveFromProxy() {
				if (!LIVE_PROXY_URL || allAircraft.length === 0) return;
				try {
					const regs = allAircraft.map((a) => a.reg).join(',');
					const res = await fetch(`${LIVE_PROXY_URL}?regs=${encodeURIComponent(regs)}`);
					if (!res.ok) return;
					const data = await res.json();
					const acList = Array.isArray(data.ac) ? data.ac : [];
					const byReg = new Map();
					for (const ac of acList) {
						if (ac.r) byReg.set(String(ac.r).toUpperCase().trim(), ac);
					}

					let airborneCount = 0;
					let groundCount = 0;
					allAircraft = allAircraft.map((item) => {
						const live = byReg.get(item.reg);
						if (!live || typeof live.lat !== 'number' || typeof live.lon !== 'number') {
							return { ...item, status: 'offline' };
						}
						const alt = live.alt_baro === 'ground' ? 0 : (typeof live.alt_baro === 'number' ? live.alt_baro : null);
						const isGround = live.alt_baro === 'ground' || (alt !== null && alt < 100 && (live.gs ?? 0) < 40);
						const status = isGround ? 'ground' : 'airborne';
						if (status === 'airborne') airborneCount++;
						else groundCount++;

						return {
							...item,
							status,
							flight: live.flight ? String(live.flight).trim() : item.flight,
							lat: live.lat,
							lon: live.lon,
							altFt: alt,
							speedKt: typeof live.gs === 'number' ? Math.round(live.gs) : item.speedKt,
							track: typeof live.track === 'number' ? Math.round(live.track) : item.track
						};
					});
					render();
				} catch (err) {
					console.warn('Live proxy refresh warning:', err);
				}
			}

			loadData().then(() => {
				if (LIVE_PROXY_URL) {
					refreshLiveFromProxy();
					setInterval(refreshLiveFromProxy, REFRESH_INTERVAL_MS);
				} else {
					setInterval(loadData, 60000);
				}
			});
		})();
	</script>

