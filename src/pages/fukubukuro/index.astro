    articleUrl: '/blog/2026-11-18-starbucks-fukubukuro-2027-guide/'
  },
  {
    brand: 'マクドナルド（McDonalds）',
    name: 'マクドナルド福袋2027',
    category: 'ファストフード',
    price: '3,000円（税込）',
